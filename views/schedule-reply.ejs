<!DOCTYPE html>
<html>
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <meta name="robots" content="noindex">
  <meta name="referrer" content="no-referrer">
  <title>Your Schedule</title>
  <link rel="icon" type="image/png" href="/Images/Enjoy%20Logo%20Heron.png">
  <%# No outside fonts or scripts: the page address is the person's private link %>
  <style>
    body {
      margin: 0;
      padding: 24px 16px;
      font-family: system-ui, -apple-system, "Segoe UI", Roboto, Arial, sans-serif;
      background: #f6f6f6;
      color: #1f2937;
    }
    .card {
      max-width: 520px;
      margin: 0 auto;
      background: white;
      border-radius: 12px;
      box-shadow: 0 6px 18px rgba(0,0,0,0.08);
      padding: 20px;
    }
    h1 { margin: 0 0 4px; font-size: 22px; }
    .meta { color: #6b7280; font-size: 14px; margin-bottom: 14px; }
    table { border-collapse: collapse; width: 100%; margin-bottom: 16px; font-size: 15px; }
    td { padding: 6px 0; border-bottom: 1px solid #f3f4f6; }
    td:first-child { font-weight: 600; padding-right: 16px; white-space: nowrap; }
    td.off { color: #9ca3af; }
    .status { border-radius: 8px; padding: 10px 12px; margin-bottom: 14px; font-size: 14px; }
    .status.yes { background: #dcfce7; color: #166534; }
    .status.no { background: #fee2e2; color: #991b1b; }
    .status.changed { background: #fef3c7; color: #92400e; }
    .status.error { background: #fee2e2; color: #991b1b; }
    h2 { font-size: 17px; margin: 0 0 10px; }
    .answers { display: flex; flex-wrap: wrap; gap: 10px; }
    button, .link-btn {
      border: none; border-radius: 8px; padding: 12px 18px; font-size: 15px; font-weight: 600;
      cursor: pointer; font-family: inherit; text-decoration: none; display: inline-block;
    }
    .btn-yes { background: #16a34a; color: white; }
    .btn-no { background: #dc2626; color: white; }
    .btn-plain { background: #e5e7eb; color: #1f2937; }
    textarea {
      width: 100%; box-sizing: border-box; min-height: 80px; margin: 8px 0 10px; padding: 10px;
      border: 1px solid #ccc; border-radius: 8px; font: inherit;
    }
    .no-form[hidden] { display: none; }
    .small { font-size: 13px; color: #6b7280; margin-top: 14px; }
  </style>
</head>
<body>
<div class="card">
  <% if (pageError) { %>
    <h1>Your schedule</h1>
    <div class="status error"><%= pageError %></div>
    <a class="link-btn btn-plain" href="<%= scheduleLink %>">Open my schedule</a>
  <% } else { %>
    <h1><%= name %></h1>
    <div class="meta">Delaney <%= store %> · week of <%= range %></div>

    <table>
      <% days.forEach(day => { %>
        <tr>
          <td><%= day.label %></td>
          <td class="<%= day.shifts.length ? '' : 'off' %>"><%= day.shifts.length ? day.shifts.join(', ') : 'Off' %></td>
        </tr>
      <% }) %>
    </table>

    <% if (error) { %>
      <div class="status error"><%= error %></div>
    <% } %>

    <% if (autoYes) { %>
      <%# Saves "yes" as the page opens (from the email's Yes link) %>
      <form method="POST" id="autoYesForm">
        <input type="hidden" name="answer" value="yes">
        <div class="status yes" id="autoYesStatus">Saving your answer…</div>
        <noscript>
          <button type="submit" class="btn-yes">Yes, I can work these hours</button>
        </noscript>
      </form>
      <script>
        document.getElementById('autoYesForm').submit();
      </script>
    <% } else if (reply) { %>
      <% const when = new Date(reply.answeredAt).toLocaleString('en-US', { timeZone: 'America/New_York', dateStyle: 'medium', timeStyle: 'short' }) %>
      <% if (reply.changed) { %>
        <div class="status changed">
          You answered <strong><%= reply.answer === 'yes' ? 'yes' : 'no' %></strong> on <%= when %>,
          but your schedule has changed since then. Please answer again for the hours above.
        </div>
      <% } else if (reply.answer === 'yes') { %>
        <div class="status yes">
          <%= saved ? 'Thank you! ' : '' %>You said <strong>yes, you can work these hours</strong> (<%= when %>).
        </div>
      <% } else { %>
        <div class="status no">
          <%= saved ? 'Thank you, your manager will see this. ' : '' %>You said <strong>no</strong> (<%= when %>): <%= reply.reason %>
        </div>
      <% } %>
    <% } %>

    <% if (autoYes) { %>
    <% } else if (!canReply) { %>
      <p class="small">This week is over, so it can no longer be answered.</p>
    <% } else { %>
      <h2><%= reply && !reply.changed ? 'Change your answer?' : 'Can you work these hours?' %></h2>
      <div class="answers">
        <form method="POST">
          <input type="hidden" name="answer" value="yes">
          <button type="submit" class="btn-yes">Yes, I can work these hours</button>
        </form>
        <button type="button" class="btn-no" id="showNo">No, I can't</button>
      </div>

      <form method="POST" class="no-form" id="noForm" <%= preselect === 'no' ? '' : 'hidden' %>>
        <input type="hidden" name="answer" value="no">
        <label for="reason" style="display:block;margin-top:14px;font-weight:600;">Why can't you work these hours?</label>
        <textarea id="reason" name="reason" maxlength="500" required
                  placeholder="For example: I have class Tuesday until 6 PM."><%= reason %></textarea>
        <button type="submit" class="btn-no">Send my answer</button>
      </form>

      <p class="small">
        You can also answer, or change your answer, on your schedule page:
        <a href="<%= scheduleLink %>">open my schedule</a> (you'll need to log in).
      </p>
    <% } %>
  <% } %>
</div>

<script>
document.getElementById('showNo')?.addEventListener('click', () => {
  const form = document.getElementById('noForm');
  form.hidden = false;
  document.getElementById('reason').focus();
});
</script>
</body>
</html>
