<h1 class="page-title">Hi <%= name %></h1>


<div class="store-grid">

  <a href="/branfordstoremap" class="store-card">
    <img src="/Images/CoastalBranford.jpg">
    <div class="overlay">Branford Store Map</div>
  </a>

  <a href="/Hamdenstoremap" class="store-card">
    <img src="/Images/Amity Hamden.jpg">
    <div class="overlay">Hamden Store Map</div>
  </a>

  <a href="/stratfordstoremap" class="store-card">
    <img src="/Images/Stratford Townline.jpg">
    <div class="overlay">Stratford Store Map</div>
  </a>

  <a href="/New-Havenstoremap" class="store-card">
    <img src="/Images/Amity New Haven.jpg">
    <div class="overlay">New Haven Store Map</div>
  </a>

  <a href="/New-Milfordstoremap" class="store-card center-card">
    <img src="/Images/Classic New Milford.jpg">
    <div class="overlay">New Milford Store Map</div>
  </a>

</div>




<br><br>

<div class="bottom-actions">
  <a href="/my-requests" class="btn btn-final">
    📄 My Requests all stores
  </a>
  
<form action="/logout" method="POST" style="display:inline;">
  <button type="submit" class="btn btn-logout">
    <span class="icon">➜</span> LOGOUT
  </button>
</form>

<% if (user.role === 'admin') { %>
<a href="/admin/users" class="btn btn-admin">
  Admin Panel
</a>
<% } %>

</div>



<head>
<meta charset="UTF-8" />
  <title>Floor Space Reservations</title>
  <link rel="icon" type="image/png" href="/Images/Enjoy%20Logo%20Heron.png">
<link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600&display=swap" rel="stylesheet">

  <style>
    body {
      background-image: url('/Images/Enjoy Logo w Text.png');
      background-size: 40%;
      background-position: center;
      background-repeat: no-repeat;
    }
    .btn {
  border: none;
  padding: 6px 12px;
  margin-left: 6px;
  border-radius: 6px;
  font-size: 14px;
  cursor: pointer;
  font-weight: 500;
  transition: all 0.2s ease;
}
.btn-logout {
  background: linear-gradient(135deg,  #d94141, #d60b0b);
  color: white;
}

.btn-logout:hover {
  background: linear-gradient(135deg, #bf2e2e, #bd0b0b);
  box-shadow: 0 6px 16px rgba(0, 0, 0, 0.25);
}

.btn-admin {
  background-color: #ffcc00;   /* yellow */
  color: black;
  text-decoration: none;
  display: inline-block;
}

.btn-admin:hover {
  background-color: #e6b800;
  box-shadow: 0 6px 16px rgba(0, 0, 0, 0.25);
}
.btn-final {
  background-color: #8c17bd;   /* yellow */
  color: white;
  text-decoration: none;
  display: inline-block;
}

.btn-final:hover {
  background-color: #69118f;
  box-shadow: 0 6px 16px rgba(0, 0, 0, 0.25);
}


.store-grid {
  display: grid;

  /* ✅ EXACT 2-column layout like you described */
  grid-template-columns: repeat(2, 220px);

  /* spacing */
  gap: 20px;

  /* center whole section */
  justify-content: center;
  margin-top: 20px;
}

/* card styling */
.store-card {
  position: relative;
  width: 220px;
  height: 180px;               /* ✅ makes them square-ish */
  border-radius: 14px;
  overflow: hidden;
  box-shadow: 0 8px 20px rgba(0,0,0,0.15);
  text-decoration: none;
  transition: all 0.2s ease;
}

.store-card img {
  width: 100%;
  height: 100%;
  object-fit: cover;
}

/* overlay text */
.overlay {
  position: absolute;
  bottom: 0;
  width: 100%;
  padding: 10px;
  background: rgba(0,0,0,0.6);
  color: white;
  font-weight: 600;
  text-align: center;
}

/* hover effect */
.store-card:hover {
  transform: translateY(-4px);
  box-shadow: 0 12px 30px rgba(0,0,0,0.25);
}

/* ✅ THIS is what centers Stratford */
.center-card {
  grid-column: span 2;   /* take full row */
  justify-self: center;  /* center in that row */
}


.page-title {
  text-align: center;
  margin-top: 20px;
}


.bottom-actions {
  display: flex;
  justify-content: center;  /* ✅ center horizontally */
  align-items: center;
  gap: 15px;               /* spacing between buttons */
  margin-top: 20px;
}


.bottom-actions form {
  display: flex;      /* ✅ makes form behave like other items */
  align-items: center;
  margin: 0;          /* removes default spacing */
}

  </style>
</head>



