<!DOCTYPE html>
<html>
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title><%= mapTitle %></title>
  <link rel="icon" type="image/png" href="/Images/Enjoy%20Logo%20Heron.png">
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600&display=swap" rel="stylesheet">
  <%- include('partials/floor-styles') %>
</head>

<body>
<div class="container">

  <div class="top-bar">
    <div>
      <h1><%= mapTitle %></h1>
      <div class="who">Signed in as <%= user.name %></div>
    </div>
    <div class="top-actions no-print">
      <a href="/my-requests?store=<%= encodeURIComponent(mapId) %>" class="btn btn-purple">My Requests</a>
      <% if (isAdmin) { %>
        <a href="<%= finalPath %>" class="btn btn-purple" id="finalLink">Final View</a>
        <a href="<%= schedulePath %>" class="btn btn-purple">Schedule</a>
      <% } %>
      <% if (showClassEvent && user.role === 'admin') { %>
        <a href="/class" class="btn btn-purple">Create Class Event</a>
      <% } %>
      <a href="/" class="btn btn-back">⬅ Home</a>
      <form action="/logout" method="POST">
        <button type="submit" class="btn btn-logout">Log out</button>
      </form>
    </div>
  </div>

  <div class="banner" id="loadError" hidden></div>

  <div class="card no-print">
    <div class="toolbar">
      <div class="month-nav">
        <button type="button" class="btn btn-plain" id="prevMonth" aria-label="Previous month">‹</button>
        <input type="month" id="monthPicker" aria-label="Month">
        <button type="button" class="btn btn-plain" id="nextMonth" aria-label="Next month">›</button>
      </div>
      <div class="segmented" role="tablist">
        <button type="button" class="active" data-view="map">Map</button>
        <button type="button" data-view="list">List</button>
      </div>
      <div class="legend">
        <span><i class="dot available"></i> Available <strong id="countAvailable"></strong></span>
        <span><i class="dot requested"></i> Requested <strong id="countRequested"></strong></span>
        <span><i class="dot reserved"></i> Reserved <strong id="countReserved"></strong></span>
      </div>
    </div>
  </div>

  <div class="floor-layout">
    <div>
      <div class="card map-card" id="mapView">
        <div class="map-frame" id="mapFrame">
          <%- include('maps/' + mapSvg) %>
        </div>
      </div>

      <div class="card" id="listView" hidden>
        <div class="list-tools">
          <input type="search" id="spaceSearch" placeholder="Find a space number" inputmode="numeric">
          <div class="segmented" id="statusFilter">
            <button type="button" class="active" data-status="">All</button>
            <button type="button" data-status="available">Available</button>
            <button type="button" data-status="requested">Requested</button>
            <button type="button" data-status="reserved">Reserved</button>
          </div>
        </div>
        <div class="space-grid" id="spaceGrid"></div>
      </div>
    </div>

    <aside class="card panel" id="panel" aria-live="polite">
      <div class="panel-head">
        <h2 id="panelTitle">Floor space</h2>
        <button type="button" class="panel-close" id="panelClose" aria-label="Close">×</button>
      </div>
      <div id="panelBody">
        <p class="panel-empty">Tap a space on the map (or in the list) to see it and request it.</p>
      </div>
    </aside>
  </div>

  <% if (isAdmin) { %>
    <div class="card no-print" id="pendingCard" style="margin-top:16px;">
      <h2 id="pendingTitle">Pending requests</h2>
      <div class="meta" style="margin:-4px 0 12px;">Grouped by space. Approving one request declines the others for that space.</div>
      <div class="pending-grid" id="pendingGrid"></div>
    </div>
  <% } %>
</div>

<%- include('partials/floor-map-script') %>

<script>
const MAP_ID = <%- safeJson(mapId) %>;
const FINAL_PATH = <%- safeJson(finalPath) %>;
const IS_ADMIN = <%- safeJson(Boolean(isAdmin)) %>;
const COLORS = { available: '#22c55e', requested: '#facc15', reserved: '#ef4444' };
const { spaceLabel, spaceNumber } = FloorMap;

const state = {
  month: floorMonth.current(),
  status: new Map(),   // item_id -> requested | reserved
  rows: [],            // admins: every request this month
  mine: [],            // everyone: my requests this month
  selected: null,
  view: 'map',
  filter: '',
  search: ''
};

// ---------- small DOM helper (text only, never HTML) ----------
function h(tag, attrs, ...children) {
  const el = document.createElement(tag);
  for (const [key, value] of Object.entries(attrs || {})) {
    if (value === undefined || value === null || value === false) continue;
    if (key === 'class') el.className = value;
    else if (key.startsWith('on')) el.addEventListener(key.slice(2), value);
    else el.setAttribute(key, value === true ? '' : value);
  }
  for (const child of children.flat()) {
    if (child === null || child === undefined || child === false) continue;
    el.append(child instanceof Node ? child : document.createTextNode(String(child)));
  }
  return el;
}

const statusOf = id => state.status.get(id) || 'available';
const statusText = { available: 'Available', requested: 'Requested', reserved: 'Reserved' };
const pendingFor = id => state.rows.filter(row => row.item_id === id && row.status === 'requested');
const reservedFor = id => state.rows.find(row => row.item_id === id && row.status === 'reserved');
const myFor = id => state.mine.filter(row => row.item_id === id && row.status !== 'rejected');
const when = value => value ? new Date(value).toLocaleString('en-US', { timeZone: 'America/New_York', dateStyle: 'medium', timeStyle: 'short' }) : '';

// ---------- map ----------
const map = FloorMap.init(document.getElementById('mapFrame'), {
  onSelect: id => openSpace(id),
  tooltip: id => {
    const status = statusOf(id);
    let text = `${spaceLabel(id)} · ${statusText[status]}`;
    if (IS_ADMIN) {
      const reserved = reservedFor(id);
      const pending = pendingFor(id).length;
      if (reserved) text += ` · ${reserved.brand}`;
      else if (pending) text += ` · ${pending} request${pending === 1 ? '' : 's'}`;
    }
    if (myFor(id).length) text += ' · yours';
    return text;
  }
});

function paint() {
  const counts = { available: 0, requested: 0, reserved: 0 };
  map.spaces.forEach(el => {
    const status = statusOf(el.id);
    counts[status]++;
    map.colorSpace(el.id, COLORS[status]);
  });
  document.getElementById('countAvailable').textContent = counts.available;
  document.getElementById('countRequested').textContent = counts.requested;
  document.getElementById('countReserved').textContent = counts.reserved;
  renderList();
  if (IS_ADMIN) renderPending();
  if (state.selected) renderPanel();
}

// ---------- data ----------
async function load() {
  const banner = document.getElementById('loadError');
  const query = `month=${encodeURIComponent(state.month)}&map=${encodeURIComponent(MAP_ID)}`;
  try {
    const [statusRows, rows, mine] = await Promise.all([
      floorApi(`/api/month?${query}`),
      IS_ADMIN ? floorApi(`/api/final-data?${query}`) : Promise.resolve([]),
      floorApi('/api/user-requests')
    ]);
    state.status = new Map(statusRows.map(row => [row.item_id, row.status]));
    state.rows = rows || [];
    state.mine = (mine || []).filter(row => row.map_id === MAP_ID && row.month === state.month);
    banner.hidden = true;
  } catch (err) {
    banner.textContent = `Couldn't load ${floorMonth.label(state.month)}: ${err.message}`;
    banner.hidden = false;
  }
  paint();
}

function setMonth(month) {
  if (!/^\d{4}-\d{2}$/.test(month)) return;
  state.month = month;
  document.getElementById('monthPicker').value = month;
  const finalLink = document.getElementById('finalLink');
  if (finalLink) finalLink.href = `${FINAL_PATH}?month=${encodeURIComponent(month)}`;
  load();
}

document.getElementById('monthPicker').addEventListener('change', event => setMonth(event.target.value));
document.getElementById('prevMonth').addEventListener('click', () => setMonth(floorMonth.shift(state.month, -1)));
document.getElementById('nextMonth').addEventListener('click', () => setMonth(floorMonth.shift(state.month, 1)));

// ---------- panel ----------
const panel = document.getElementById('panel');

function openSpace(id) {
  state.selected = id;
  map.select(id);
  renderPanel();
  renderList();
  panel.classList.add('open');
}

function closePanel() {
  state.selected = null;
  map.select(null);
  panel.classList.remove('open');
  document.getElementById('panelTitle').textContent = 'Floor space';
  document.getElementById('panelBody').replaceChildren(
    h('p', { class: 'panel-empty' }, 'Tap a space on the map (or in the list) to see it and request it.'));
  renderList();
}
document.getElementById('panelClose').addEventListener('click', closePanel);
document.addEventListener('keydown', event => { if (event.key === 'Escape' && state.selected) closePanel(); });

function requestCard(row, { withActions, competing }) {
  return h('div', { class: 'request' },
    h('div', { class: 'who' }, row.user || 'Someone'),
    h('div', { class: 'what' }, h('strong', {}, row.brand || ''), row.products ? ` · ${row.products}` : ''),
    row.created_at ? h('div', { class: 'when' }, `Requested ${when(row.created_at)}`) : null,
    withActions ? h('div', { class: 'actions' },
      h('button', { type: 'button', class: 'btn btn-approve btn-small', onclick: event => approve(row, competing, event.currentTarget) }, 'Approve'),
      h('button', { type: 'button', class: 'btn btn-reject btn-small', onclick: event => decline(row, event.currentTarget) }, 'Decline')
    ) : null
  );
}

function renderPanel() {
  const id = state.selected;
  const status = statusOf(id);
  document.getElementById('panelTitle').textContent = spaceLabel(id);
  const body = [];

  body.push(h('div', {}, h('span', { class: `chip ${status}` }, statusText[status]),
    ` ${floorMonth.label(state.month)}`));

  // Mine
  const mine = myFor(id);
  if (mine.length) {
    body.push(h('div', { class: 'panel-section' },
      h('h3', {}, 'Your request'),
      mine.map(row => h('div', { class: 'note' },
        h('span', { class: `chip ${row.status === 'reserved' ? 'approved' : 'requested'}` }, row.status === 'reserved' ? 'Approved' : 'Waiting for approval'),
        ' ', h('strong', {}, row.brand), row.products ? ` · ${row.products}` : ''))
    ));
  }

  // Managers: who has it, and who's asking
  if (IS_ADMIN) {
    const reserved = reservedFor(id);
    if (reserved) {
      body.push(h('div', { class: 'panel-section' }, h('h3', {}, 'Reserved by'), requestCard(reserved, {})));
    }
    const pending = pendingFor(id);
    if (pending.length) {
      body.push(h('div', { class: 'panel-section' },
        h('h3', {}, `Pending requests (${pending.length})`),
        pending.map(row => requestCard(row, { withActions: true, competing: pending.filter(other => other._id !== row._id) }))
      ));
    }
  }

  // Request form
  if (status === 'reserved') {
    if (!mine.some(row => row.status === 'reserved')) {
      body.push(h('div', { class: 'panel-section' }, h('div', { class: 'note' }, 'This space is reserved for this month. Try another month or another space.')));
    }
  } else if (!mine.length) {
    const error = h('div', { class: 'form-error', hidden: true });
    const brand = h('input', { type: 'text', name: 'brand', maxlength: '200', required: true, autocomplete: 'off' });
    const products = h('textarea', { name: 'products', maxlength: '1000', required: true });
    const submit = h('button', { type: 'submit', class: 'btn btn-back' }, 'Send request');
    const form = h('form', { class: 'panel-section', novalidate: true },
      h('h3', {}, 'Request this space'),
      status === 'requested' ? h('div', { class: 'note', style: 'margin-bottom:10px;' }, 'Someone else has already asked for this space. You can still request it; the store will choose.') : null,
      error,
      h('label', { class: 'field' }, 'Brand', brand),
      h('label', { class: 'field' }, 'Products', products),
      submit
    );
    form.addEventListener('submit', async event => {
      event.preventDefault();
      error.hidden = true;
      const values = { brand: brand.value.trim(), products: products.value.trim() };
      if (!values.brand || !values.products) {
        error.textContent = 'Enter both the brand and the products.';
        error.hidden = false;
        (values.brand ? products : brand).focus();
        return;
      }
      submit.disabled = true;
      submit.textContent = 'Sending…';
      try {
        await floorApi('/api/request', {
          method: 'POST',
          body: JSON.stringify({ item_id: id, month: state.month, map: MAP_ID, ...values })
        });
        floorToast(`Request sent for ${spaceLabel(id)}.`);
        await load();
      } catch (err) {
        // Keep what they typed so they can fix it and try again
        error.textContent = err.message;
        error.hidden = false;
        submit.disabled = false;
        submit.textContent = 'Send request';
      }
    });
    body.push(form);
  }

  document.getElementById('panelBody').replaceChildren(...body);
}

// ---------- approve / decline ----------
async function approve(row, competing, button) {
  const others = competing.map(other => `${other.user} (${other.brand})`).join(', ');
  const question = `Approve ${row.user}'s request (${row.brand}) for ${spaceLabel(row.item_id)}?` +
    (others ? `\n\nThis declines: ${others}.` : '');
  if (!confirm(question)) return;
  button.disabled = true;
  try {
    await floorApi('/api/approve', { method: 'POST', body: JSON.stringify({ request_id: row._id, map: MAP_ID }) });
    floorToast(`${spaceLabel(row.item_id)} reserved for ${row.brand}.`);
    await load();
  } catch (err) {
    floorToast(`Couldn't approve: ${err.message}`, true);
    button.disabled = false;
  }
}

async function decline(row, button) {
  if (!confirm(`Decline ${row.user}'s request (${row.brand}) for ${spaceLabel(row.item_id)}?`)) return;
  button.disabled = true;
  try {
    await floorApi('/api/reject', { method: 'POST', body: JSON.stringify({ request_id: row._id, map: MAP_ID }) });
    floorToast('Request declined.');
    await load();
  } catch (err) {
    floorToast(`Couldn't decline: ${err.message}`, true);
    button.disabled = false;
  }
}

// ---------- pending requests (admins) ----------
function renderPending() {
  const grid = document.getElementById('pendingGrid');
  const pending = state.rows.filter(row => row.status === 'requested');
  const bySpace = new Map();
  pending.forEach(row => bySpace.set(row.item_id, [...(bySpace.get(row.item_id) || []), row]));
  document.getElementById('pendingTitle').textContent = `Pending requests (${pending.length})`;

  if (!pending.length) {
    grid.replaceChildren(h('p', { class: 'meta', style: 'margin:0;' }, `No pending requests for ${floorMonth.label(state.month)}.`));
    return;
  }

  grid.replaceChildren(...[...bySpace.entries()]
    .sort((a, b) => spaceNumber(a[0]) - spaceNumber(b[0]))
    .map(([id, rows]) => h('div', { class: 'pending-space' },
      h('div', { class: 'pending-space-head' },
        h('h3', {}, spaceLabel(id)),
        rows.length > 1 ? h('span', { class: 'chip count' }, `${rows.length} competing`) : null,
        h('button', { type: 'button', class: 'btn btn-plain btn-small', onclick: () => { showView('map'); map.showSpace(id); openSpace(id); } }, 'Show on map')
      ),
      rows.sort((a, b) => String(a.created_at).localeCompare(String(b.created_at)))
        .map(row => requestCard(row, { withActions: true, competing: rows.filter(other => other._id !== row._id) }))
    )));
}

// ---------- list view ----------
function showView(view) {
  state.view = view;
  document.querySelectorAll('[data-view]').forEach(button => button.classList.toggle('active', button.dataset.view === view));
  document.getElementById('mapView').hidden = view !== 'map';
  document.getElementById('listView').hidden = view !== 'list';
}
document.querySelectorAll('[data-view]').forEach(button => button.addEventListener('click', () => showView(button.dataset.view)));

document.getElementById('statusFilter').addEventListener('click', event => {
  const button = event.target.closest('button');
  if (!button) return;
  state.filter = button.dataset.status;
  document.querySelectorAll('#statusFilter button').forEach(b => b.classList.toggle('active', b === button));
  renderList();
});
document.getElementById('spaceSearch').addEventListener('input', event => {
  state.search = event.target.value.replace(/\D/g, '');
  renderList();
});

function renderList() {
  const tiles = map.spaces
    .filter(el => !state.filter || statusOf(el.id) === state.filter)
    .filter(el => !state.search || String(spaceNumber(el.id)).startsWith(state.search))
    .map(el => {
      const status = statusOf(el.id);
      let sub = '';
      if (IS_ADMIN) {
        const reserved = reservedFor(el.id);
        const pending = pendingFor(el.id).length;
        sub = reserved ? reserved.brand : pending ? `${pending} request${pending === 1 ? '' : 's'}` : '';
      }
      if (myFor(el.id).length) sub = sub ? `${sub} · yours` : 'Your request';
      return h('button', {
        type: 'button',
        class: `space-tile${state.selected === el.id ? ' active' : ''}`,
        style: `--c:${COLORS[status]}`,
        onclick: () => openSpace(el.id)
      }, h('strong', {}, spaceLabel(el.id)), h('span', { class: `chip ${status}` }, statusText[status]), sub ? h('div', { class: 'sub' }, sub) : null);
    });
  document.getElementById('spaceGrid').replaceChildren(...(tiles.length ? tiles : [h('p', { class: 'meta' }, 'No spaces match.')]));
}

// ---------- start ----------
setMonth(state.month);
</script>
</body>
</html>
