<!DOCTYPE html>
<html>
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title><%= store %> Schedule</title>
  <link rel="icon" type="image/png" href="/Images/Enjoy%20Logo%20Heron.png">
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600&display=swap" rel="stylesheet">

  <style>
    body {
      margin: 0;
      padding: 20px 16px;
      font-family: 'Inter', sans-serif;
      background-color: #f6f6f6;
      color: #1f2937;
    }

    .page {
      max-width: 1400px;
      margin: 0 auto;
    }

    .header {
      display: flex;
      flex-wrap: wrap;
      justify-content: space-between;
      align-items: center;
      gap: 12px;
      margin-bottom: 16px;
    }

    h1 {
      margin: 0;
    }

    .meta {
      color: #555;
      font-size: 14px;
      margin-top: 4px;
    }

    .actions {
      display: flex;
      flex-wrap: wrap;
      gap: 10px;
      align-items: center;
    }

    .week-picker {
      display: flex;
      gap: 8px;
      align-items: center;
      margin: 0;
      font-size: 14px;
    }

    .week-picker select {
      padding: 7px 10px;
      border: 1px solid #ccc;
      border-radius: 8px;
      font-size: 14px;
      font-family: inherit;
      max-width: 100%;
    }

    .actions form {
      margin: 0;
    }

    .btn {
      border: none;
      padding: 8px 14px;
      border-radius: 6px;
      font-size: 14px;
      font-weight: 500;
      cursor: pointer;
      text-decoration: none;
      display: inline-block;
    }

    .btn-home {
      background: #2120ba;
      color: white;
    }

    .btn-print {
      background: #e5e7eb;
      color: #1f2937;
    }

    .btn-time-off {
      background: #2563eb;
      color: white;
    }

    .btn-calendar {
      background: #0f766e;
      color: white;
    }

    .btn-logout {
      background: linear-gradient(135deg, #d94141, #d60b0b);
      color: white;
    }

    .card {
      background: white;
      border-radius: 12px;
      box-shadow: 0 6px 18px rgba(0,0,0,0.08);
      padding: 16px;
      margin-bottom: 18px;
      overflow-x: auto;
    }

    h2 {
      margin: 0 0 10px;
      font-size: 18px;
    }

    table {
      width: 100%;
      border-collapse: collapse;
      /* Shrinks with the window so all seven days fit; below 10px the
         card scrolls sideways instead (phones) */
      font-size: clamp(10px, 1.05vw, 14px);
    }

    th, td {
      border: 1px solid #e5e7eb;
      padding: 0.55em 0.6em;
      text-align: center;
      vertical-align: top;
      /* Keep "8:00 AM to 12:00 PM" on one line; the card scrolls
         sideways on narrow screens instead */
      white-space: nowrap;
    }

    th {
      background: #f3f4f6;
      font-weight: 600;
    }

    td.name {
      text-align: left;
      font-weight: 500;
    }

    tr.me td {
      background: #eef2ff;
    }

    .off {
      color: #9ca3af;
    }

    .empty {
      text-align: center;
      padding: 40px 16px;
      color: #555;
    }

    /* My week: each day's shift and tasks from the daily task board */
    .my-week {
      display: grid;
      grid-template-columns: repeat(auto-fill, minmax(260px, 1fr));
      gap: 12px;
    }

    .day-card {
      border: 1px solid #e5e7eb;
      border-radius: 10px;
      padding: 12px 14px;
      break-inside: avoid;
    }

    .day-card.off {
      background: #f9fafb;
    }

    .day-card h3 {
      margin: 0;
      font-size: 15px;
    }

    .day-shift {
      margin: 2px 0 8px;
      font-size: 14px;
      font-weight: 600;
      color: #1d4ed8;
    }

    .day-card.off .day-shift {
      color: #6b7280;
      font-weight: 500;
    }

    .task-section {
      margin: 8px 0 2px;
      font-size: 11px;
      font-weight: 700;
      letter-spacing: .04em;
      text-transform: uppercase;
      color: #6b7280;
    }

    .task-list {
      list-style: none;
      margin: 0;
      padding: 0;
    }

    .task-list li {
      padding: 4px 0;
      border-top: 1px solid #f3f4f6;
      font-size: 14px;
    }

    .task-list li:first-child {
      border-top: 0;
    }

    .task-time {
      font-weight: 700;
      color: #0f766e;
      margin-right: 4px;
    }

    .task-role {
      display: inline-block;
      margin-left: 4px;
      padding: 0 6px;
      border-radius: 999px;
      background: #fef3c7;
      color: #92400e;
      font-size: 11px;
      font-weight: 700;
    }

    .task-note {
      display: block;
      font-size: 12px;
      color: #6b7280;
    }

    .no-tasks {
      font-size: 13px;
      color: #6b7280;
    }

    /* "Can you work these hours?" */
    .confirm-card h2 { margin-bottom: 6px; }
    .confirm-status {
      border-radius: 8px;
      padding: 8px 12px;
      margin-bottom: 10px;
      font-size: 14px;
    }
    .confirm-status.yes { background: #dcfce7; color: #166534; }
    .confirm-status.no { background: #fee2e2; color: #991b1b; }
    .confirm-status.changed { background: #fef3c7; color: #92400e; }
    .confirm-status.none { background: #f3f4f6; color: #374151; }
    .confirm-actions { display: flex; flex-wrap: wrap; gap: 10px; align-items: center; }
    .btn-yes { background: #16a34a; color: white; }
    .btn-no { background: #dc2626; color: white; }
    .confirm-no { margin-top: 10px; max-width: 560px; }
    .confirm-no[hidden] { display: none; }
    .confirm-no textarea {
      width: 100%;
      box-sizing: border-box;
      min-height: 70px;
      margin: 6px 0 8px;
      padding: 8px 10px;
      border: 1px solid #ccc;
      border-radius: 8px;
      font: inherit;
      font-size: 14px;
    }
    .confirm-error { color: #991b1b; font-size: 14px; margin-top: 8px; }

    @page {
      size: landscape;
      margin: 0.35in;
    }

    @media print {
      .actions, .week-picker, .confirm-card { display: none; }
      body { background: white; padding: 0; }
      .page { max-width: none; }
      h1 { font-size: 16pt; }
      /* Keep a group's title with the start of its table */
      h2 { font-size: 11pt; margin-bottom: 4px; break-after: avoid; }

      /* A long group may continue on the next page, but each person's
         whole week stays on one page: rows never split, and the day
         headings repeat at the top of every page */
      .card {
        box-shadow: none;
        padding: 0;
        margin-bottom: 10px;
        overflow: visible;
      }

      table { font-size: 8.5pt; }
      thead { display: table-header-group; }
      tr { break-inside: avoid; }
      th, td { padding: 3px 4px; }

      /* Keep the "you" highlight when printing */
      tr.me td {
        -webkit-print-color-adjust: exact;
        print-color-adjust: exact;
      }
    }
  </style>
</head>

<body>
<div class="page">

  <div class="header">
    <div>
      <h1><%= onlyMine ? `My ${store} Schedule` : `${store} Schedule` %></h1>
      <div class="meta">
        <strong><%= selectedWeek.label %></strong> · <%= selectedWeek.range %>
      </div>
    </div>

    <form class="week-picker" method="GET">
      <label for="week">Week</label>
      <select id="week" name="week" onchange="this.form.submit()">
        <% weeks.forEach(week => { %>
          <option value="<%= week.weekStart %>" <%= week.weekStart === selectedWeek.weekStart ? 'selected' : '' %>>
            <%= week.label === 'Current week' || week.label === 'Next week'
              ? `${week.label} (${week.range})`
              : week.label %>
          </option>
        <% }) %>
      </select>
      <noscript><button type="submit" class="btn btn-print">Show</button></noscript>
    </form>

    <div class="actions">
      <% if (showHomeLink) { %>
        <a href="/" class="btn btn-home">Home</a>
      <% } %>
      <a href="/my-schedule.ics?week=<%= encodeURIComponent(selectedWeek.weekStart) %>" class="btn btn-calendar"
         title="Downloads a calendar file (.ics) with your shifts for the week shown (<%= selectedWeek.range %>). Open it with Outlook or Apple Calendar, or import it in Google Calendar (Settings → Import &amp; export).">
        📅 Add this week to my calendar
      </a>
      <a href="/time-off" class="btn btn-time-off">Time off &amp; availability</a>
      <button type="button" class="btn btn-print" onclick="window.print()">Print</button>
      <form action="/logout" method="POST">
        <button type="submit" class="btn btn-logout">Logout</button>
      </form>
    </div>
  </div>

  <% if (!posted) { %>
    <div class="card empty">
      The schedule for this week (<%= selectedWeek.range %>) hasn't been posted yet.
    </div>
  <% } else if (onlyMine && !groups.length) { %>
    <div class="card empty">
      You aren't on the schedule for this week (<%= selectedWeek.range %>).
      If you think that's a mistake, ask your manager.
    </div>
  <% } %>

  <%# "Can you work these hours?" for the viewer's own shifts this week %>
  <% if (confirm) { %>
    <% const reply = confirm.reply %>
    <% const when = reply ? new Date(reply.answeredAt).toLocaleString('en-US', { timeZone: 'America/New_York', dateStyle: 'medium', timeStyle: 'short' }) : '' %>
    <div class="card confirm-card" id="confirmCard"
         data-store="<%= store %>" data-week="<%= selectedWeek.weekStart %>">
      <h2>Can you work these hours?</h2>
      <% if (!reply) { %>
        <div class="confirm-status none">
          <%= confirm.canReply ? "You haven't answered yet." : "You didn't answer for this week." %>
        </div>
      <% } else if (reply.changed) { %>
        <div class="confirm-status changed">
          You answered <strong><%= reply.answer %></strong> on <%= when %>, but your schedule has changed since then.
          <%= confirm.canReply ? 'Please answer again for your current hours.' : '' %>
        </div>
      <% } else if (reply.answer === 'yes') { %>
        <div class="confirm-status yes">You said <strong>yes, you can work these hours</strong> (<%= when %>).</div>
      <% } else { %>
        <div class="confirm-status no">You said <strong>no</strong> (<%= when %>): <%= reply.reason %></div>
      <% } %>

      <% if (confirm.canReply) { %>
        <div class="confirm-actions">
          <button type="button" class="btn btn-yes" data-answer="yes">Yes, I can work these hours</button>
          <button type="button" class="btn btn-no" id="confirmShowNo">No, I can't</button>
        </div>
        <div class="confirm-no" id="confirmNo" hidden>
          <label for="confirmReason"><strong>Why can't you work these hours?</strong></label>
          <textarea id="confirmReason" maxlength="500"
                    placeholder="For example: I have class Tuesday until 6 PM."><%= reply && reply.answer === 'no' ? reply.reason : '' %></textarea>
          <button type="button" class="btn btn-no" data-answer="no">Send my answer</button>
        </div>
        <div class="confirm-error" id="confirmError" hidden></div>
      <% } %>
    </div>
  <% } %>

  <%# The viewer's shift and daily responsibilities, day by day (stores
      that use the daily task board) %>
  <% if (myDays) { %>
    <% const hasTasks = myDays.some(day => day.items.length) %>
    <div class="card">
      <h2>My week</h2>
      <% if (!hasTasks) { %>
        <div class="no-tasks">No daily responsibilities have been posted for this week yet.</div>
      <% } else { %>
        <div class="my-week">
          <% myDays.filter(day => day.shifts.length || day.items.length).forEach(day => { %>
            <div class="day-card<%= day.shifts.length ? '' : ' off' %>">
              <h3><%= day.label %></h3>
              <div class="day-shift">
                <%= day.shifts.length ? day.shifts.join(', ') : 'Off' %>
              </div>
              <% if (!day.items.length) { %>
                <div class="no-tasks">No tasks assigned.</div>
              <% } %>
              <% let section = null %>
              <% day.items.forEach((item, index) => { %>
                <% if (item.section !== section) { %>
                  <% if (section !== null) { %></ul><% } %>
                  <% section = item.section %>
                  <% if (section) { %><div class="task-section"><%= section %></div><% } %>
                  <ul class="task-list">
                <% } %>
                <li>
                  <% if (item.time) { %><span class="task-time"><%= item.time %></span><% } %>
                  <%= item.task %>
                  <% if (item.role) { %><span class="task-role"><%= item.role %></span><% } %>
                  <% if (item.note) { %><span class="task-note"><%= item.note %></span><% } %>
                </li>
                <% if (index === day.items.length - 1) { %></ul><% } %>
              <% }) %>
            </div>
          <% }) %>
        </div>
      <% } %>
    </div>
  <% } %>

  <% groups.forEach(group => { %>
    <div class="card">
      <h2><%= group.label %></h2>
      <table>
        <thead>
          <tr>
            <th>Name</th>
            <% dayKeys.forEach(day => { %>
              <th><%= day.charAt(0).toUpperCase() + day.slice(1) %></th>
            <% }) %>
          </tr>
        </thead>
        <tbody>
          <% group.employees.forEach(employee => { %>
            <tr class="<%= employee.me ? 'me' : '' %>">
              <td class="name"><%= employee.name %></td>
              <% dayKeys.forEach(day => { %>
                <td>
                  <% if (employee.days[day].length) { %>
                    <%- employee.days[day].map(shift => String(shift).replace(/[&<>"']/g, c => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' })[c])).join('<br>') %>
                  <% } else { %>
                    <span class="off">Off</span>
                  <% } %>
                </td>
              <% }) %>
            </tr>
          <% }) %>
        </tbody>
      </table>
    </div>
  <% }) %>

</div>

<script>
(() => {
  const card = document.getElementById('confirmCard');
  if (!card) return;

  const errorBox = document.getElementById('confirmError');
  const showError = message => {
    errorBox.textContent = message;
    errorBox.hidden = false;
  };

  document.getElementById('confirmShowNo')?.addEventListener('click', () => {
    document.getElementById('confirmNo').hidden = false;
    document.getElementById('confirmReason').focus();
  });

  card.querySelectorAll('[data-answer]').forEach(button => {
    button.addEventListener('click', async () => {
      const answer = button.dataset.answer;
      const reason = answer === 'no' ? document.getElementById('confirmReason').value.trim() : '';
      if (answer === 'no' && !reason) {
        showError("Tell us why you can't work these hours.");
        return;
      }

      errorBox.hidden = true;
      card.querySelectorAll('button').forEach(item => { item.disabled = true; });
      try {
        const response = await fetch('/api/schedule-reply', {
          method: 'POST',
          credentials: 'same-origin',
          headers: { 'Content-Type': 'application/json', Accept: 'application/json' },
          body: JSON.stringify({ store: card.dataset.store, weekStart: card.dataset.week, answer, reason })
        });
        const result = await response.json().catch(() => ({}));
        if (response.status === 401) throw new Error('You have been signed out. Log in again and answer once more.');
        if (!response.ok || !result.success) throw new Error(result.error || 'Your answer could not be saved.');
        location.reload();
      } catch (err) {
        showError(err.message);
        card.querySelectorAll('button').forEach(item => { item.disabled = false; });
      }
    });
  });
})();
</script>
</body>
</html>
