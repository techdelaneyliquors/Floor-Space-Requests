<!DOCTYPE html>
<html>
<head>
  <title>Admin Panel</title>

  <style>
    body {
      margin: 0;
      font-family: 'Inter', sans-serif;
      background: #f6f6f6;
      display: flex;
      justify-content: center;
      align-items: flex-start;
      padding-top: 40px;
    }

    .admin-container {
      background: rgba(255,255,255,0.95);
      padding: 30px;
      border-radius: 12px;
      width: 100%;
      max-width: 900px;
      box-sizing: border-box;
      box-shadow: 0 10px 25px rgba(0,0,0,0.15);
    }

    h1 {
      margin-bottom: 10px;
      text-align: center;
    }

    .top-bar {
      display: flex;
      justify-content: space-between;
      align-items: center;
      margin-bottom: 20px;
    }

    .btn-back {
      text-decoration: none;
      background-color: #2120ba;
      color: white;
      padding: 8px 14px;
      border-radius: 8px;
      font-size: 14px;
      transition: all 0.2s ease;
    }

    .btn-back:hover {
      background-color: #1b1aa1;
    }

    table {
      width: 100%;
      border-collapse: collapse;
      overflow: hidden;
      border-radius: 10px;
    }

    th {
      background: #f0f0f0;
      font-weight: 600;
      text-align: left;
      padding: 12px;
    }

    td {
      padding: 12px;
      border-top: 1px solid #eee;
    }

    tr:hover {
      background-color: #fafafa;
    }

    /* Buttons */
    .btn {
      border: none;
      padding: 6px 12px;
      border-radius: 6px;
      font-size: 13px;
      cursor: pointer;
      font-weight: 500;
      transition: all 0.2s ease;
    }

    .btn-promote {
      background-color: #0ad19b;
      color: white;
    }

    .btn-promote:hover {
      background-color: #09b889;
      transform: translateY(-1px);
    }

    .btn-demote {
      background-color: #dc3545;
      color: white;
    }

    .btn-demote:hover {
      background-color: #c82333;
      transform: translateY(-1px);
    }

    /* Role badge */
    .role-admin {
      color: #8c17bd;
      font-weight: 600;
    }

    .role-user {
      color: #555;
    }

    .status-pending {
      color: #b7791f;
      font-weight: 600;
    }

    .email {
      color: #666;
      font-size: 13px;
    }

    td {
      vertical-align: top;
    }

    td form {
      margin: 0 0 6px;
    }

    select {
      padding: 5px 8px;
      border: 1px solid #ccc;
      border-radius: 6px;
      font-size: 13px;
      margin-bottom: 6px;
    }

    .checks {
      display: flex;
      flex-wrap: wrap;
      gap: 4px 10px;
      font-size: 13px;
      margin-bottom: 6px;
    }

    .checks label {
      display: flex;
      align-items: center;
      gap: 4px;
    }

    .flash {
      border-radius: 8px;
      padding: 10px 14px;
      margin-bottom: 16px;
      font-size: 14px;
    }

    .flash-ok {
      background: #e7f8ef;
      border: 1px solid #9fdcbc;
    }

    .flash-error {
      background: #fdecec;
      border: 1px solid #f1a9a9;
    }

  </style>
</head>

<body>

  <div class="admin-container">

    <h1>User Management</h1>

    <div class="top-bar">
      <a href="/" class="btn-back">⬅ Back</a>
      <a href="/access-requests" class="btn-back">Access Requests</a>
    </div>

    <% if (message) { %>
      <div class="flash flash-ok"><%= message %></div>
    <% } %>
    <% if (error) { %>
      <div class="flash flash-error"><%= error %></div>
    <% } %>

    <table>
      <tr>
        <th>Name</th>
        <th>Access</th>
        <th>Change access</th>
      </tr>

      <% users.forEach(u => {
           const isSelf = String(u._id) === String(user._id)
           const userStoreList = u.stores || []
           const hasAll = userStoreList.includes('all')
      %>
        <tr>
          <td>
            <%= u.name %><br>
            <span class="email"><%= u.email %></span>
            <% if (!u.emailVerified) { %>
              <br><span class="status-pending">Email not verified</span>
            <% } %>
          </td>

          <td>
            <% if (u.accessStatus === 'approved') { %>
              <span class="<%= u.role === 'admin' ? 'role-admin' : 'role-user' %>">
                <%= roleLabels[u.role] || u.role %>
              </span><br>
              <span class="email"><%= formatStores(userStoreList) %></span>
              <% if (['employee', 'manager'].includes(u.role)) { %>
                <br>
                <% if (u.linkDescriptions.length) { %>
                  <% u.linkDescriptions.forEach(link => { %>
                    <span class="email">Linked: <%= link.store %> #<%= link.employeeNumber %> <%= link.name %></span><br>
                  <% }) %>
                <% } else { %>
                  <span class="status-pending">Not linked to the roster</span>
                <% } %>
              <% } %>
            <% } else if (u.accessStatus === 'pending') { %>
              <span class="status-pending">Pending</span><br>
              <span class="email">
                wants <%= roleLabels[(u.accessRequest || {}).role] || '' %>,
                <%= formatStores((u.accessRequest || {}).stores) %>
              </span>
            <% } else if (u.accessStatus === 'denied') { %>
              <span class="role-user">Denied</span>
            <% } else { %>
              <span class="role-user">No access</span>
            <% } %>
          </td>

          <td>
            <% if (isSelf) { %>
              <span class="email">This is you</span>
            <% } else { %>
              <form action="/admin/users/<%= u._id %>/access" method="POST" class="access-form">
                <select name="role">
                  <% roles.forEach(role => { %>
                    <option value="<%= role %>" <%= u.role === role ? 'selected' : '' %>>
                      <%= roleLabels[role] %>
                    </option>
                  <% }) %>
                </select>

                <div class="checks">
                  <label>
                    <input type="checkbox" class="all-box" name="stores" value="all" <%= hasAll ? 'checked' : '' %>>
                    All
                  </label>
                  <% storeList.forEach(store => { %>
                    <label>
                      <input type="checkbox" class="store-box" name="stores" value="<%= store %>"
                        <%= !hasAll && userStoreList.includes(store) ? 'checked' : '' %>>
                      <%= store %>
                    </label>
                  <% }) %>
                </div>

                <%- include('partials/roster-link-fields', {
                      rosters,
                      stores: storeList,
                      selected: u.linkSuggestions || {},
                      targetUserId: u._id
                    }) %>

                <button type="submit" class="btn btn-promote">Save</button>
              </form>

              <% if (u.accessStatus === 'approved' || u.accessStatus === 'pending') { %>
                <form action="/admin/users/<%= u._id %>/revoke" method="POST"
                      onsubmit="return confirm('Remove all access for this user?')">
                  <button type="submit" class="btn btn-demote">Revoke</button>
                </form>
              <% } %>
            <% } %>
          </td>
        </tr>
      <% }) %>
    </table>

  </div>

<script>
  document.querySelectorAll('.access-form').forEach(form => {
    const allBox = form.querySelector('.all-box')
    const storeBoxes = form.querySelectorAll('.store-box')

    function syncAll() {
      storeBoxes.forEach(box => {
        box.disabled = allBox.checked
        if (allBox.checked) box.checked = false
      })
    }

    allBox.addEventListener('change', syncAll)
    syncAll()

    form.addEventListener('submit', event => {
      const role = form.querySelector('select[name="role"]').value
      const anyStore = allBox.checked ||
        Array.from(storeBoxes).some(box => box.checked)

      if (role !== 'admin' && !anyStore) {
        event.preventDefault()
        alert('Choose at least one store.')
      }
    })
  })
</script>

<%- include('partials/roster-link-script') %>
</body>
</html>