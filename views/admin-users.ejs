<!DOCTYPE html>
<html>
<head>
  <title>Admin Panel</title>

  <style>
    body {
      margin: 0;
      font-family: 'Inter', sans-serif;
      background: #f6f6f6;
      display: flex;
      justify-content: center;
      align-items: flex-start;
      padding-top: 40px;
    }

    .admin-container {
      background: rgba(255,255,255,0.95);
      padding: 30px;
      border-radius: 12px;
      width: 800px;
      box-shadow: 0 10px 25px rgba(0,0,0,0.15);
    }

    h1 {
      margin-bottom: 10px;
      text-align: center;
    }

    .top-bar {
      display: flex;
      justify-content: space-between;
      align-items: center;
      margin-bottom: 20px;
    }

    .btn-back {
      text-decoration: none;
      background-color: #2120ba;
      color: white;
      padding: 8px 14px;
      border-radius: 8px;
      font-size: 14px;
      transition: all 0.2s ease;
    }

    .btn-back:hover {
      background-color: #1b1aa1;
    }

    table {
      width: 100%;
      border-collapse: collapse;
      overflow: hidden;
      border-radius: 10px;
    }

    th {
      background: #f0f0f0;
      font-weight: 600;
      text-align: left;
      padding: 12px;
    }

    td {
      padding: 12px;
      border-top: 1px solid #eee;
    }

    tr:hover {
      background-color: #fafafa;
    }

    /* Buttons */
    .btn {
      border: none;
      padding: 6px 12px;
      border-radius: 6px;
      font-size: 13px;
      cursor: pointer;
      font-weight: 500;
      transition: all 0.2s ease;
    }

    .btn-promote {
      background-color: #0ad19b;
      color: white;
    }

    .btn-promote:hover {
      background-color: #09b889;
      transform: translateY(-1px);
    }

    .btn-demote {
      background-color: #dc3545;
      color: white;
    }

    .btn-demote:hover {
      background-color: #c82333;
      transform: translateY(-1px);
    }

    /* Role badge */
    .role-admin {
      color: #8c17bd;
      font-weight: 600;
    }

    .role-user {
      color: #555;
    }

  </style>
</head>

<body>

  <div class="admin-container">

    <h1>User Management</h1>

    <div class="top-bar">
      <a href="/" class="btn-back">⬅ Back</a>
    </div>

    <table>
      <tr>
        <th>Name</th>
        <th>Email</th>
        <th>Role</th>
        <th>Action</th>
      </tr>

      <% users.forEach(u => { %>
        <tr>
          <td><%= u.name %></td>
          <td><%= u.email %></td>

          <td>
            <% if (u.role === 'admin') { %>
              <span class="role-admin">Admin</span>
            <% } else { %>
              <span class="role-user">User</span>
            <% } %>
          </td>

          <td>
            <% if (u.role !== 'admin') { %>
              <button class="btn btn-promote" onclick="makeAdmin('<%= u.email %>')">
                Make Admin
              </button>
            <% } else { %>
              <button class="btn btn-demote" onclick="removeAdmin('<%= u.email %>')">
                Remove Admin
              </button>
            <% } %>
          </td>
        </tr>
      <% }) %>
    </table>

  </div>

<script>
async function makeAdmin(email) {
    if (!confirm(`Promote ${email} to admin?`)) return;

    await fetch('/admin/promote', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ email })
    });

    location.reload();
}

async function removeAdmin(email) {
    if (!confirm(`Remove admin from ${email}?`)) return;

    await fetch('/admin/demote', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ email })
    });

    location.reload();
}
</script>

</body>
</html>