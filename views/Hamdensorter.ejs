<script>
document.addEventListener("DOMContentLoaded", () => {

  // ✅ ONLY RUN IF SVG EXISTS
  const svg = document.querySelector("svg");
  if (!svg) return;

  console.log("✅ SVG detected — running map logic");

  const params = new URLSearchParams(window.location.search);
  console.log(params);

  const type = params.get("type")?.toLowerCase();
  const subtype = params.get("subtype")?.toLowerCase();

  // ✅ rules
  const excludedWineBoxes = [65, 58, 64, 8, 7, 53, 5, 55, 54, 4, 1];
  const boxWineOnly = [24];
  const dessertSparklingOnly = [34];

  const boxes = document.querySelectorAll("[id^='myBox']");

  boxes.forEach(box => {
    const num = parseInt(box.id.replace("myBox", ""));

    let highlight = false;

    if (subtype === "box") {
      highlight = boxWineOnly.includes(num);
    } 
    else if (subtype === "dessert" || subtype === "sparkling") {
      highlight = dessertSparklingOnly.includes(num);
    } 
    else if (type === "wine") {
      highlight = !excludedWineBoxes.includes(num);
    }

    if (highlight) {
      box.classList.add("highlighted");
    } else {
      box.classList.add("dimmed");
    }
  });

});
</script>