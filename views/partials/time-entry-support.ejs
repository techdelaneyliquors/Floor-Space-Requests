<%#
  Typed time entry, included once per page that has time fields.

  A time field is a text box (class "time-text", list="timeChoices") that
  suggests every 15 minutes from 5:00 AM to 11:45 PM and also accepts typed
  times: "9", "930", "9:30", "9:30p", "17:30" (military time becomes 5:30 PM).
  Typed times snap to the nearest 15 minutes. Without AM/PM, 1-4 means PM
  (nothing is scheduled before 5 AM) and 5-11 means AM, except that an end
  time (class "time-end") that would land at or before its start time
  (class "time-start", inside the same "time-pair" element) moves 12 hours
  later: 9 to 5 is 9:00 AM to 5:00 PM.

  In a form, wrap the text box and a hidden input (class "time-value", with
  the form field's name) in a "time-entry" element; the hidden input carries
  "HH:MM" (24-hour), which is what the server expects. See time-entry.ejs.
%>
<datalist id="timeChoices">
<% for (let minutes = 5 * 60; minutes < 24 * 60; minutes += 15) {
  const hour = Math.floor(minutes / 60)
%>  <option value="<%= (hour % 12 || 12) + ':' + String(minutes % 60).padStart(2, '0') + (hour < 12 ? ' AM' : ' PM') %>"></option>
<% } %></datalist>

<script>
(function () {
  const EARLIEST = 5 * 60
  const LATEST = 23 * 60 + 45
  const INVALID = 'Enter a time from 5:00 AM to 11:45 PM, like 9:30 AM or 17:30.'

  // Typed text -> "HH:MM" (24-hour), or null if it isn't a usable time.
  // after: the matching start time ("HH:MM") when this is an end time.
  function parseTypedTime(text, after) {
    const clean = String(text || '').trim().toLowerCase().replace(/\./g, ':').replace(/\s+/g, '')
    const match = /^(\d{1,4})(?::(\d{2}))?(a|am|p|pm)?$/.exec(clean)
    if (!match) return null

    let [, digits, minuteText, suffix] = match
    let hour
    let minute

    if (minuteText !== undefined) {
      if (digits.length > 2) return null
      hour = Number(digits)
      minute = Number(minuteText)
    } else if (digits.length >= 3) {
      // "930" -> 9:30, "1730" -> 17:30
      hour = Number(digits.slice(0, -2))
      minute = Number(digits.slice(-2))
    } else {
      hour = Number(digits)
      minute = 0
    }

    if (minute > 59) return null

    if (suffix) {
      if (hour < 1 || hour > 12) return null
      if (suffix[0] === 'p' && hour < 12) hour += 12
      if (suffix[0] === 'a' && hour === 12) hour = 0
    } else if (hour > 23) {
      return null
    } else if (hour >= 1 && hour <= 4) {
      // Nothing starts before 5 AM, so 1-4 without AM/PM is afternoon
      hour += 12
    }

    let total = Math.round((hour * 60 + minute) / 15) * 15

    // An end time typed without AM/PM that isn't after the start: the
    // afternoon/evening one was meant
    const afterMatch = /^(\d{2}):(\d{2})$/.exec(after || '')
    if (!suffix && afterMatch && hour < 12) {
      const start = Number(afterMatch[1]) * 60 + Number(afterMatch[2])
      if (total <= start && total + 12 * 60 <= LATEST) total += 12 * 60
    }

    // 11:53 PM and later round to midnight; keep them at 11:45 PM
    if (total > LATEST && total <= 24 * 60 && hour === 23) total = LATEST
    if (total < EARLIEST || total > LATEST) return null

    return String(Math.floor(total / 60)).padStart(2, '0') + ':' + String(total % 60).padStart(2, '0')
  }

  // "HH:MM" -> "9:30 AM"
  function timeLabel(value) {
    const match = /^(\d{2}):(\d{2})$/.exec(value || '')
    if (!match) return ''
    const hour = Number(match[1])
    return `${hour % 12 || 12}:${match[2]} ${hour < 12 ? 'AM' : 'PM'}`
  }

  // For an end time: its start time as "HH:MM", if one is entered
  function startTimeFor(input) {
    if (!input.classList.contains('time-end')) return ''
    const start = input.closest('.time-pair')?.querySelector('.time-start')
    return start ? parseTypedTime(start.value) || '' : ''
  }

  // Tidies the typed text into "9:30 AM" and fills the hidden field.
  // Returns false (and marks the box invalid) if it isn't a usable time.
  function commitTimeEntry(input) {
    const hidden = input.closest('.time-entry')?.querySelector('.time-value')
    const text = input.value.trim()

    if (!text) {
      input.setCustomValidity('')
      if (hidden) hidden.value = ''
      return true
    }

    const value = parseTypedTime(text, startTimeFor(input))
    if (!value) {
      input.setCustomValidity(INVALID)
      if (hidden) hidden.value = ''
      return false
    }

    input.setCustomValidity('')
    input.value = timeLabel(value)
    if (hidden) hidden.value = value
    return true
  }

  window.parseTypedTime = parseTypedTime
  window.startTimeFor = startTimeFor
  window.timeLabel = timeLabel
  window.commitTimeEntry = commitTimeEntry

  const isTimeText = target => target instanceof HTMLInputElement && target.classList.contains('time-text')

  // Browsers only suggest list entries that match what's in the box, so the
  // box is emptied on focus (the current time shows faded) to offer the
  // whole list; leaving it untouched puts the time back.
  document.addEventListener('focusin', event => {
    const input = event.target
    if (!isTimeText(input) || input.disabled) return
    input.dataset.previousTime = input.value
    if (input.value) {
      input.placeholder = input.value
      input.value = ''
    }
  })

  document.addEventListener('focusout', event => {
    const input = event.target
    if (!isTimeText(input)) return
    if (!input.value.trim() && input.dataset.previousTime) {
      input.value = input.dataset.previousTime
    }
    input.placeholder = input.dataset.placeholder || 'e.g. 9:30 AM'
    delete input.dataset.previousTime
    if (!commitTimeEntry(input)) input.reportValidity()
  })

  // Picking from the list
  document.addEventListener('change', event => {
    if (isTimeText(event.target)) commitTimeEntry(event.target)
  })

  // Enter can submit a form before the box loses focus, so tidy it first
  // (capture phase, ahead of the browser's form checks)
  document.addEventListener('keydown', event => {
    if (event.key !== 'Enter' || !isTimeText(event.target)) return
    const input = event.target
    if (!input.value.trim() && input.dataset.previousTime) input.value = input.dataset.previousTime
    if (!commitTimeEntry(input)) {
      event.preventDefault()
      input.reportValidity()
    }
  }, true)
})()
</script>
