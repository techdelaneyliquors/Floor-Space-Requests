<%#
  <option>s for a time dropdown, every 15 minutes from 5:00 AM to 11:45 PM:
  values "HH:MM" (24-hour, what the server expects), labels "9:15 AM".
  Pass `selected` ("HH:MM") to pick one; the first option is blank so
  `required` works.
%><option value="">--</option><% for (let minutes = 5 * 60; minutes < 24 * 60; minutes += 15) {
  const hour = Math.floor(minutes / 60)
  const value = String(hour).padStart(2, '0') + ':' + String(minutes % 60).padStart(2, '0')
%><option value="<%= value %>"<%= typeof selected !== 'undefined' && selected === value ? ' selected' : '' %>><%= (hour % 12 || 12) + value.slice(2) + (hour < 12 ? ' AM' : ' PM') %></option><% } %>
