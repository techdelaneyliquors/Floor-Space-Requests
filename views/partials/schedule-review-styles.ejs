<style>
    body {
      margin: 0;
      padding: 30px 16px;
      font-family: 'Inter', sans-serif;
      background: #f6f6f6;
      color: #1f2937;
    }

    .container {
      max-width: 1700px;
      margin: 0 auto;
    }

    .top-bar {
      display: flex;
      justify-content: space-between;
      align-items: center;
      flex-wrap: wrap;
      gap: 10px;
      margin-bottom: 20px;
    }

    h1 {
      margin: 0;
    }

    .btn {
      border: none;
      padding: 8px 14px;
      border-radius: 8px;
      font-size: 14px;
      font-weight: 500;
      cursor: pointer;
      text-decoration: none;
      display: inline-block;
      font-family: inherit;
    }

    .btn-back { background: #2120ba; color: white; }
    .btn-approve { background: #0ad19b; color: white; }
    .btn-reject { background: #dc3545; color: white; }

    .flash {
      border-radius: 8px;
      padding: 10px 14px;
      margin-bottom: 16px;
      font-size: 14px;
    }

    .flash-ok { background: #e7f8ef; border: 1px solid #9fdcbc; }
    .flash-error { background: #fdecec; border: 1px solid #f1a9a9; }

    .card {
      background: white;
      border-radius: 12px;
      box-shadow: 0 6px 18px rgba(0,0,0,0.08);
      padding: 18px;
      margin-bottom: 20px;
    }

    .card-head {
      display: flex;
      justify-content: space-between;
      align-items: flex-start;
      flex-wrap: wrap;
      gap: 12px;
      margin-bottom: 12px;
    }

    .card-head h2 {
      margin: 0 0 4px;
      font-size: 20px;
    }

    .meta {
      color: #555;
      font-size: 14px;
    }

    .replaces {
      display: inline-block;
      margin-top: 6px;
      font-size: 13px;
      color: #92400e;
      background: #fef3c7;
      border-radius: 6px;
      padding: 3px 8px;
    }

    .decision {
      display: flex;
      gap: 8px;
      align-items: flex-start;
      flex-wrap: wrap;
    }

    .decision form {
      margin: 0;
      display: flex;
      gap: 6px;
      align-items: center;
    }

    .decision input[type="text"] {
      padding: 7px 10px;
      border: 1px solid #ccc;
      border-radius: 8px;
      font-size: 14px;
      font-family: inherit;
      width: 220px;
    }

    h3 {
      margin: 16px 0 6px;
      font-size: 15px;
    }

    .table-wrap {
      overflow-x: auto;
    }

    table {
      width: 100%;
      border-collapse: collapse;
      font-size: clamp(10px, 1vw, 13px);
    }

    th, td {
      border: 1px solid #e5e7eb;
      padding: 0.5em 0.6em;
      text-align: center;
      vertical-align: top;
      white-space: nowrap;
    }

    th { background: #f3f4f6; font-weight: 600; }
    td.name { text-align: left; font-weight: 500; }
    .off { color: #9ca3af; }

    .adjustments td {
      white-space: normal;
      text-align: left;
    }

    /* Review table: same layout as the Schedule page's printable schedule */
    .review-table {
      border: 1px solid #cbd5e1;
      border-radius: 10px;
      overflow: hidden;
    }

    .review-table th,
    .review-table td {
      padding: 0.5em 0.45em;
    }

    .review-table th {
      background: #e8eef8;
      color: #1e3a5f;
      font-size: 0.85em;
      text-transform: uppercase;
      letter-spacing: 0.02em;
    }

    /* Each shift and "Was:" line stays on one line; the table text scales
       with the window so the whole week plus hours and OT columns fit.
       Names and OT status may wrap. */
    .review-table {
      font-size: clamp(9px, 0.84vw, 13px);
    }

    .review-table td {
      white-space: normal;
    }

    .review-table td.day,
    .review-table .live-note {
      white-space: nowrap;
    }

    .review-table th {
      white-space: normal;
    }

    .review-table th.name-col {
      background: #fff;
      text-align: left;
    }

    .review-table td.name {
      font-weight: 700;
      white-space: normal;
      min-width: 110px;
    }

    .review-table td.metric {
      font-weight: 700;
    }

    .changed-shift {
      color: #dc2626;
      font-weight: 800;
    }

    td.differs {
      background: #fffbeb;
    }

    .live-note {
      display: block;
      margin-top: 3px;
      font-size: 0.85em;
      color: #92400e;
      font-style: italic;
    }

    .new-badge {
      display: block;
      font-size: 0.75em;
      font-weight: 600;
      color: #92400e;
    }

    .ot-ok {
      background: #dcfce7;
      color: #166534;
      font-weight: 700;
    }

    .ot-over {
      background: #fee2e2;
      color: #b91c1c;
      font-weight: 700;
    }

    .total-row td {
      background: #d9e1f2;
      font-weight: 700;
      border-top: 2px solid #4a6fa5;
    }

    .total-row td:first-child {
      text-align: left;
    }

    .total-row td.ot-ok { background: #dcfce7; }
    .total-row td.ot-over { background: #fee2e2; }

    .legend {
      display: flex;
      flex-wrap: wrap;
      gap: 6px 18px;
      font-size: 13px;
      color: #475569;
      margin: 4px 0 8px;
    }

    .legend .live-note {
      display: inline;
    }

    .removed-note {
      font-size: 14px;
      color: #92400e;
      margin: 10px 0 0;
    }

    .empty {
      text-align: center;
      color: #555;
      padding: 40px 16px;
    }

    .review-warnings {
      background: #fffbeb;
      border: 1px solid #fcd34d;
      color: #78350f;
      border-radius: 8px;
      padding: 10px 14px;
      margin: 4px 0 12px;
      font-size: 14px;
    }

    .review-warnings ul {
      margin: 6px 0;
      padding-left: 20px;
    }

    .review-warnings-reason {
      margin-top: 6px;
      padding-top: 6px;
      border-top: 1px solid #fde68a;
    }

    .previous-rejection {
      margin-top: 12px;
      background: #fef2f2;
      border: 1px solid #fecaca;
      color: #7f1d1d;
      border-radius: 8px;
      padding: 10px 14px;
      font-size: 14px;
    }
</style>
