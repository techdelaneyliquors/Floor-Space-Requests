async function saveCurrentAsTemplate() {
  const enteredName = window.prompt(
    'Template name:'
  );

  const templateName =
    enteredName?.trim();

  if (!templateName) {
    return;
  }

  const makeDefault = window.confirm(
    'Make this the default template ' +
    `for ${state.store}?`
  );
state.currentTemplateName =
  templateName;
  const templateData =
    captureCurrentTemplate();

  const response = await fetch(
    '/api/schedule-templates',
    {
      method: 'POST',

      headers: {
        'Content-Type': 'application/json'
      },

      credentials: 'same-origin',

      body: JSON.stringify({
        store: state.store,
        templateName,
        isDefault: makeDefault,
        templateData
      })
    }
  );

  const result = await response.json();

  if (!response.ok) {
    throw new Error(
      result.error ||
      'The template could not be saved.'
    );
  }

  buildingNewTemplate = false;

  /*
   * Convert the currently displayed schedule
   * into the permanent version that was saved.
   */
  replaceObjectContents(
    managerCoverage,
    result.template?.templateData
      ?.managerCoverage ||
      templateData.managerCoverage ||
      {}
  );

  replaceObjectContents(
    associateCoverage,
    result.template?.templateData
      ?.associateCoverage ||
      templateData.associateCoverage ||
      {}
  );

  replaceObjectContents(
    state.assignments,
    result.template?.templateData
      ?.assignments ||
      templateData.assignments ||
      {}
  );

  /*
   * Everything saved in a template is permanent.
   */
  replaceObjectContents(
    temporaryShifts,
    {}
  );

  replaceObjectContents(
    temporaryShiftNotes,
    {}
  );

  await loadTemplateList(
    result.template?._id || ''
  );

  renderAllTables();

  alert(
    `"${templateName}" was saved for ` +
    `${state.store}.`
  );
}
