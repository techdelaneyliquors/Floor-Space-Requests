  async function addEmployee(type) {
  const enteredName = window.prompt(
    `New ${type} name:`
  )

  const name = enteredName?.trim()

  if (!name) {
    return
  }

  const alreadyManager =
    state.managers.some(
      existing =>
        existing.toLowerCase() ===
        name.toLowerCase()
    )

  const alreadyAssociate =
    state.associates.some(
      existing =>
        existing.toLowerCase() ===
        name.toLowerCase()
    )

  if (alreadyManager || alreadyAssociate) {
    alert(
      `${name} is already on an employee list.`
    )

    return
  }

  if (type === 'manager') {
    state.managers.push(name)
  } else {
    state.associates.push(name)
  }

  state.availability[name] = true
  state.buildEmployeeIdentifiers[name] = ''

  renderAllTables()

  try {
    await saveEmployeeSettings()
  } catch (err) {
    console.error(err)

    alert(
      'The employee was added to the page, ' +
      'but the change could not be saved.'
    )
  }
  }

  async function removeEmployee(
  type,
  employeeName
  ) {
  const confirmed = window.confirm(
    `Remove ${employeeName} from the ` +
    `${type} list? Existing shift assignments ` +
    `for this employee will be cleared.`
  )

  if (!confirmed) {
    return
  }

  clearEmployeeAssignments(employeeName)

  if (type === 'manager') {
    state.managers =
      state.managers.filter(
        name => name !== employeeName
      )
  } else {
    state.associates =
      state.associates.filter(
        name => name !== employeeName
      )
  }

  delete state.availability[employeeName]
  delete state.buildEmployeeIdentifiers[employeeName]
  renderAllTables()

  try {
    await saveEmployeeSettings()
  } catch (err) {
    console.error(err)

    alert(
      'The employee was removed from the page, ' +
      'but the change could not be saved.'
    )
  }
  }


  async function saveEmployeeSettings() {
  const response = await fetch(
    '/api/schedule-settings',
    {
      method: 'POST',

      headers: {
        'Content-Type': 'application/json'
      },

      credentials: 'same-origin',

      body: JSON.stringify({
        store: state.store,
        managers: state.managers,
        associates: state.associates,
        buildEmployeeIdentifiers: state.buildEmployeeIdentifiers,
        availability: state.availability
      })
    }
  )

  const result = await response.json()

  if (!response.ok) {
    throw new Error(
      result.error ||
      'Schedule settings could not be saved'
    )
  }

  return result
  }


