<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Hamden Weekly Schedule</title>
  <style>
    :root {
      --navy:#17365d; --blue:#2f5597; --light:#eaf1fb; --line:#cbd5e1;
      --text:#172033; --muted:#64748b; --green:#15803d; --amber:#b45309;
      --red:#b91c1c; --white:#fff; --shadow:0 12px 32px rgba(15,23,42,.08);
    }
    * { box-sizing:border-box; }
    body { margin:0; font-family:Inter,Segoe UI,Arial,sans-serif; background:#f5f7fb; color:var(--text); }
    .page-shell { max-width:1500px; margin:0 auto; padding:24px; }
    .topbar { display:flex; justify-content:space-between; gap:16px; align-items:center; margin-bottom:18px; }
    .topbar h1 { margin:0; font-size:28px; color:var(--navy); }
    .topbar p { margin:5px 0 0; color:var(--muted); }
    .actions { display:flex; gap:10px; flex-wrap:wrap; }
    button { border:0; border-radius:8px; padding:10px 14px; font-weight:700; cursor:pointer; }
    .primary { background:var(--navy); color:#fff; }
    .secondary { background:#fff; color:var(--navy); border:1px solid var(--line); }
    .module-tabs { display:flex; gap:8px; overflow:auto; padding-bottom:10px; position:sticky; top:0; z-index:20; background:#f5f7fb; }
    .module-tabs button { white-space:nowrap; background:#dbe7f7; color:var(--navy); }
    .module-tabs button.active { background:var(--navy); color:#fff; }
    .module { display:none; }
    .module.active { display:block; }
    .module-card { background:#fff; border:1px solid #e2e8f0; border-radius:14px; box-shadow:var(--shadow); margin:14px 0 24px; overflow:hidden; }
    .module-heading { padding:18px 22px; background:linear-gradient(135deg,var(--navy),var(--blue)); color:#fff; }
    .module-heading h2 { margin:0; font-size:21px; }
    .module-heading p { margin:5px 0 0; opacity:.85; }
    .section { padding:22px; border-top:1px solid #e7edf5; }
    .section:first-of-type { border-top:0; }
    .section-title { display:flex; justify-content:space-between; align-items:end; gap:14px; margin-bottom:12px; }
    .section-title h3 { margin:0; color:var(--navy); font-size:17px; }
    .section-title small { color:var(--muted); }
    .table-wrap { overflow:auto; border:1px solid var(--line); border-radius:10px; }
    table { width:100%; border-collapse:collapse; min-width:980px; background:#fff; }
    th, td { border-bottom:1px solid var(--line); border-right:1px solid #e8edf4; padding:9px; text-align:center; vertical-align:middle; }
    th { background:#e9f0fa; color:var(--navy); font-size:12px; text-transform:uppercase; letter-spacing:.03em; }
    td:first-child, th:first-child { text-align:left; font-weight:700; position:sticky; left:0; background:inherit; z-index:2; }
    tr:last-child td { border-bottom:0; }
    select, input { width:100%; min-width:105px; border:1px solid #cbd5e1; border-radius:6px; padding:7px 8px; background:#fff; color:var(--text); }
    input[type="checkbox"] { min-width:auto; width:18px; height:18px; }
    .shift-label { display:block; font-size:12px; font-weight:700; color:#334155; margin-bottom:5px; }
    .stack { display:grid; gap:7px; }
    .availability-grid { display:grid; grid-template-columns:repeat(2,minmax(0,1fr)); gap:14px; }
    .people-box { border:1px solid var(--line); border-radius:10px; padding:14px; background:#fafcff; }
    .people-box h4 { margin:0 0 10px; color:var(--navy); }
    .person-row { display:flex; justify-content:space-between; align-items:center; gap:12px; padding:7px 0; border-bottom:1px dashed #dbe3ee; }
    .person-row:last-child { border:0; }
    .badge { display:inline-block; padding:4px 8px; border-radius:999px; font-size:11px; font-weight:800; }
    .manager { background:#dbeafe; color:#1d4ed8; }
    .associate { background:#dcfce7; color:#15803d; }
    .metric { font-weight:800; }
    .negative { color:var(--red); }
    .positive { color:var(--green); }
    .attendance-grid { display:grid; grid-template-columns:repeat(3,1fr); gap:8px; }
    .attendance-grid input { min-width:55px; }
    .print-sheet { padding:16px; background:#fff; }
    .print-sheet h2 { text-align:center; margin:0 0 4px; }
    .print-sheet .period { text-align:center; color:var(--muted); margin-bottom:16px; }
    .no-print-note { background:#fff7ed; border:1px solid #fed7aa; color:#9a3412; padding:10px 12px; border-radius:8px; margin-bottom:12px; }
    .actual-cell { white-space:pre-line; line-height:1.45; }
    @media(max-width:850px){ .availability-grid{grid-template-columns:1fr;} .topbar{align-items:flex-start;flex-direction:column;} }
    @media print {

       * {-webkit-print-color-adjust: exact !important;
            print-color-adjust: exact !important;
        }

        /* Previous Week print table */
#previousWeekComparisonTable {
  width: 100% !important;
  min-width: 0 !important;
  table-layout: fixed !important;
}

#previousWeekComparisonTable th,
#previousWeekComparisonTable td {
  padding: 3px 2px !important;
  font-size: 10px !important;
  word-wrap: break-word;
}

#previousWeekComparisonTable .comparison-cell {
  font-size: 10px !important;
  line-height: 1.1 !important;
}

#previousWeekComparisonTable .planned-shift,
#previousWeekComparisonTable .actual-shift {
  font-size: 10px !important;
  white-space: nowrap;
}

.table-wrap {
  overflow: visible !important;
}

  body {
    background:#fff;
  }

  .page-shell {
    max-width:none;
    padding:0;
  }

  .topbar,
  .module-tabs,
  .no-print,
  .no-print-note {
    display:none !important;
  }

  .module {
    display:none !important;
  }

  /* Default print = schedule */
  #module-3.print-page {
    display:block !important;
  }

  /* Previous week review print */
  #module-5.print-previous {
    display:block !important;
  }

  .module-heading {
    display:none;
  }

  .module-card {
    box-shadow:none;
    border:0;
    margin:0;
  }

  .section {
    padding:0;
    border:0;
  }

  table {
    min-width:0;
    font-size:10px;
  }

  th,
  td {
    padding:6px 4px;
  }

  @page {
  size: landscape;
  margin: 0.2in;
}
}

    .person-controls {
  display: flex;
  align-items: center;
  gap: 12px;
  }

.person-controls label {
  display: flex;
  align-items: center;
  gap: 6px;
  white-space: nowrap;
  }

.remove-person {
  background: #fee2e2;
  color: #b91c1c;
  border: 1px solid #fecaca;
  padding: 6px 9px;
  border-radius: 6px;
  font-size: 12px;
  }

.remove-person:hover {
  background: #fecaca;
  }

  .total-row{
    font-weight:700;
    background:#d9e1f2;
    }

    .total-row td{
    border-top:2px solid #4a6fa5;
    }

    .shift-editor {
  display:grid;
  grid-template-columns:1fr 1fr;
  gap:5px;
  margin-bottom:6px;
}

.shift-editor input[type="time"] {
  min-width:0;
  padding:5px;
  font-size:11px;
}

.shift-edit-actions {
  display:flex;
  gap:5px;
  justify-content:center;
  margin-bottom:7px;
}

.shift-edit-button {
  padding:5px 8px;
  border:1px solid #bfdbfe;
  background:#eff6ff;
  color:#1d4ed8;
  font-size:11px;
}

.shift-clear-button {
  padding:5px 8px;
  border:1px solid #fecaca;
  background:#fef2f2;
  color:#b91c1c;
  font-size:11px;
}

.add-shift-button {
  padding:6px 9px;
  border:1px solid #bfdbfe;
  background:#eff6ff;
  color:#1d4ed8;
  font-size:11px;
}

.temporary-shift {
  color:#dc2626 !important;
  font-weight:800;
}

.temporary-hours {
  color:#dc2626;
  font-weight:800;
}

.temporary-note {
  display:block;
  color:#dc2626;
  font-size:10px;
  font-weight:700;
  margin-top:3px;
}

.unassigned-shift {
  background: #fef9c3 !important;
  border: 2px solid #eab308 !important;
  color: #713f12;
  font-weight: 700;
}

.print-comments {
  margin-top:20px;
  padding:12px;
  border:2px solid #fca5a5;
  background:#fef2f2;
}

.print-comments h3 {
  margin:0 0 8px;
  color:#991b1b;
}

.print-comments ul {
  margin:0;
  padding-left:18px;
}

.print-comments li {
  color:#991b1b;
  margin-bottom:4px;
}

.previous-week-comments {
  margin-top:20px;
  padding:15px;
  border:2px solid #94a3b8;
  background:#f8fafc;
}

.previous-week-comments h3 {
  margin:0 0 10px;
  color:#17365d;
}

.previous-week-comments pre {
  white-space:pre-wrap;
  font-family:inherit;
  margin:0;
}

.actual-compare{
  font-style:italic;
  color:#64748b;
  margin-top:3px;
  font-size:11px;
}

.actual-on-time{
  font-style:italic;
  color:#64748b;
}

.actual-different{
  font-style:italic;
  color:#b45309;
  font-weight:600;
}

.actual-missed{
  font-style:italic;
  color:#b91c1c;
  font-weight:700;
}

#actualShiftTable th:first-child,
#actualShiftTable td:first-child,
#scheduledShiftTable th:first-child,
#scheduledShiftTable td:first-child,
#actualHoursTable th:first-child,
#actualHoursTable td:first-child {
  width:120px;
  min-width:120px;
  text-align:center;
}

#actualShiftTable th:nth-child(2),
#actualShiftTable td:nth-child(2),
#scheduledShiftTable th:nth-child(2),
#scheduledShiftTable td:nth-child(2),
#actualHoursTable th:nth-child(2),
#actualHoursTable td:nth-child(2) {
  width:130px;
  min-width:130px;
  text-align:left;
  font-weight:700;
}

.employee-number-control {
  display:flex;
  align-items:center;
  gap:6px;
  font-size:12px;
  color:#475569;
  font-weight:700;
}

.employee-number-input {
  width:90px;
  min-width:90px;
  padding:6px 8px;
}

#previousWeekComparisonTable .comparison-cell {
  font-size: 11px;
  line-height: 1.15;
  white-space: nowrap;
}

#previousWeekComparisonTable .planned-shift {
  display: block;
  font-size: 14px;
}

#previousWeekComparisonTable .actual-shift {
  display: block;
  font-size: 14px;
  font-style: italic;
  color: #64748b;
  margin-top: 2px;
}

#previousWeekComparisonTable th:first-child,
#previousWeekComparisonTable td:first-child {
  width: 90px;
  min-width: 90px;
}
.attendance-issue {
  background: #fee2e2 !important;
}

.attendance-severe {
  background: #fecaca !important;
}

.template-toolbar {
  display:grid;
  grid-template-columns:
    auto minmax(220px, 1fr)
    auto auto auto auto;
  gap:10px;
  align-items:center;
  margin-bottom:18px;
  padding:14px;
  border:1px solid var(--line);
  border-radius:10px;
  background:#f8fafc;
}

.template-toolbar label {
  color:var(--navy);
  font-size:13px;
  font-weight:800;
  white-space:nowrap;
}

.template-toolbar select {
  min-width:220px;
}

@media(max-width:950px) {
  .template-toolbar {
    grid-template-columns:1fr 1fr;
  }

  .template-toolbar label,
  .template-toolbar select {
    grid-column:1 / -1;
  }
}
  </style>
</head>
<body>
<% const incoming = (typeof scheduleData !== 'undefined' && scheduleData) ? scheduleData : {}; %>
<div class="page-shell">
  <header class="topbar">
    <div>
      <h1>Hamden Weekly Scheduling Center</h1>
      <p>Build next week, compare hours, print the schedule, and review prior-week attendance.</p>
    </div>
    <div class="actions no-print">
      <button class="secondary" type="button" id="recalculateBtn">Recalculate hours</button>
      <button
  class="secondary"
  type="button"
  onclick="printWeeklySchedule()"
>
  Print weekly schedule
</button>
      <button class="primary" type="button" id="saveBtn">Save schedule</button>
    </div>
  </header>

  <nav class="module-tabs no-print" aria-label="Schedule modules">
    <button class="active" data-module="module-1">1. Build Schedule</button>
    <button data-module="module-2">2. Hours Matrix</button>
    <button data-module="module-3">3. Printable Schedule</button>
    <button data-module="module-4">4. Attendance</button>
    <button data-module="module-5">5. Previous Week</button>
  </nav>

  <!-- MODULE 1, SECTION 1 -->
  <section class="module active" id="module-1">
    <div class="module-card">
      <div class="module-heading"><h2>Module 1: Build Next Week's Schedule</h2><p>Three sections for manager coverage, associate shifts, and availability.</p></div>
      <div class="section">
        <div class="template-toolbar no-print">

  <label for="templateSelector">
    Schedule Template
  </label>

  <select id="templateSelector">
    <option value="">
      Select a template
    </option>
  </select>


  <button
    type="button"
    class="secondary"
    id="loadTemplateBtn"
  >
    Load Template
  </button>

  <button
    type="button"
    class="secondary"
    id="saveTemplateBtn"
  >
    Save As Template
  </button>

  <button
    type="button"
    class="secondary"
    id="newTemplateBtn"
  >
    New Template
  </button>

  <button
    type="button"
    class="remove-person"
    id="deleteTemplateBtn"
  >
    Delete Template
  </button>

</div>
        <div class="section-title"><div><h3>Section 1 of 8: Manager Hours and Assignment</h3><small>Coverage windows are based on the manager-hours area in hamden.pdf.</small></div></div>
        <div class="table-wrap"><table id="managerTable"><thead><tr><th>Manager coverage</th><th>Monday</th><th>Tuesday</th><th>Wednesday</th><th>Thursday</th><th>Friday</th><th>Saturday</th><th>Sunday</th></tr></thead><tbody></tbody></table></div>
      </div>

      <!-- MODULE 1, SECTION 2 -->
      <div class="section">
        <div class="section-title"><div><h3>Section 2 of 8: Associate Shift Assignment</h3><small>Assign each recurring coverage shift to an available associate.</small></div></div>
        <div class="table-wrap"><table id="associateTable"><thead><tr><th>Associate shift</th><th>Monday</th><th>Tuesday</th><th>Wednesday</th><th>Thursday</th><th>Friday</th><th>Saturday</th><th>Sunday</th></tr></thead><tbody></tbody></table></div>
      </div>

      <!-- MODULE 1, SECTION 3 -->
      <div class="section">
        <div class="section-title"><div><h3>Section 3 of 8: Available Employees</h3><small>Turn managers and associates on or off for next week's assignment lists.</small></div></div>
        <div class="availability-grid">
          <div class="people-box"><h4>Managers</h4><div id="managerAvailability"></div><button class="secondary" type="button" onclick="addEmployee('manager')">Add manager</button></div>
          <div class="people-box"><h4>Associates</h4><div id="associateAvailability"></div><button class="secondary" type="button" onclick="addEmployee('associate')">Add associate</button></div>
        </div>
      </div>
    </div>
  </section>

  <!-- MODULE 2, SECTION 4 -->
  <section class="module" id="module-2">
    <div class="module-card">
      <div class="module-heading"><h2>Module 2: Scheduled Hours by Employee</h2><p>Daily assigned hours are calculated from the selected shifts.</p></div>
      <div class="section">
        <div class="section-title"><div><h3>Section 4 of 8: Employee Hours Matrix</h3><small>Employees across the top, weekdays down the left, totals on the right and bottom.</small></div></div>
        <div class="table-wrap"><table id="hoursMatrix"></table></div>
      </div>
    </div>
  </section>

  <!-- MODULE 3, SECTION 5 -->
  <section class="module" id="module-3">
    <div class="module-card">
      <div class="module-heading"><h2>Module 3: Printable Weekly Schedule</h2><p>A clean employee-by-day schedule modeled on the bottom table in the PDF.</p></div>
      <div class="section print-sheet">
        <div class="no-print-note">Use the Print button above. Printing is set to landscape and only this schedule is included.</div>
        <h2>Hamden Weekly Schedule</h2>

<div class="period" id="printPeriod">
  Next week
</div>

<div
  id="printTemplateName"
  style="
    text-align:center;
    color:#64748b;
    font-size:14px;
    margin-bottom:16px;
  "
></div>
        <div class="table-wrap"><table id="printSchedule"></table></div>
      </div>
    </div>
  </section>

  <!-- MODULE 4, SECTION 6 -->
  <section class="module" id="module-4">
    <div class="module-card">
      <div class="module-heading"><h2>Module 4: Attendance Review</h2><p>Upload or enter absence, tardy, and early-leave counts.</p></div>
      <div class="section">
        <div class="section-title"><div><h3>Section 6 of 8: Previous Week, Year, and All-Time Attendance</h3><small>Rows are editable so separately uploaded attendance data can populate these values.</small></div><input class="no-print" type="file" id="attendanceUpload" accept=".json,.csv"></div>
        <div class="table-wrap"><table id="attendanceTable"><thead><tr><th rowspan="2">Employee</th><th colspan="3">Previous week</th><th colspan="3">Year</th><th colspan="3">All time</th></tr><tr><th>Absences</th><th>Tardies</th><th>Left early</th><th>Absences</th><th>Tardies</th><th>Left early</th><th>Absences</th><th>Tardies</th><th>Left early</th></tr></thead><tbody></tbody></table></div>
      </div>
    </div>
  </section>

  <!-- MODULE 5, SECTION 7 -->
  <section class="module" id="module-5">
    <div class="module-card">
      <div class="module-heading"><h2>Module 5: Previous Week Actuals</h2><p>Actual shift ranges and daily worked-hour totals.</p></div>

 
<div class="section">

  <div class="section-title">
    <div>
      <h3>
        Section 7 of 8: Previous Week Schedule Comparison
      </h3>

      <small>
        Planned shifts are shown first. Actual shifts are
        shown in italic text underneath.
      </small>
    </div>
  </div>

  <div class="table-wrap">
    <table id="previousWeekComparisonTable"></table>
  </div>

</div>

<!-- MODULE 5, SECTION 9 -->
<div class="section">

  <div class="section-title">

    <div>

      <h3>
        Section 8 of 8: Previous Week Comments
      </h3>

      <small>
        Notes regarding attendance,
        staffing,
        call-outs,
        overtime,
        inventory counts,
        special events,
        customer issues,
        and other observations.
      </small>

    </div>

    <button
      class="secondary no-print"
      type="button"
      onclick="printPreviousWeek()"
    >
      Print Previous Week Review
    </button>

  </div>

  <textarea
    id="previousWeekNotes"
    rows="8"
    placeholder="Enter manager notes for the previous week..."
    style="
      width:100%;
      padding:12px;
      border:1px solid #cbd5e1;
      border-radius:8px;
      resize:vertical;
    "
  ></textarea>

</div>
    </div>
  </section>


</div>

<script>
  const DAYS = ['Monday','Tuesday','Wednesday','Thursday','Friday','Saturday','Sunday'];
  const DAY_KEYS = DAYS.map(d => d.toLowerCase());
  const temporaryShifts = {};
  const temporaryShiftNotes = {};
  let buildingNewTemplate = false;

  const state = {
  store: 'Hamden',
 templates: [],
 currentTemplateName: '',
  managers:
    <%- JSON.stringify(incoming.managers || []) %>,

  associates:
    <%- JSON.stringify(incoming.associates || []) %>,

    buildEmployeeIdentifiers:
  <%- JSON.stringify(
    incoming.buildEmployeeIdentifiers || {}
  ) %>,

  availability:
    <%- JSON.stringify(incoming.availability || {}) %>,

  assignments:
    <%- JSON.stringify(incoming.assignments || {}) %>,

  attendance:
  <%- JSON.stringify(incoming.attendance || {}) %>,

employeeIdentifiers:
  <%- JSON.stringify(
    incoming.employeeIdentifiers || {}
  ) %>,

previousScheduledShifts:
  <%- JSON.stringify(
    incoming.previousScheduledShifts || {}
  ) %>,



  previousActualShifts:
    <%- JSON.stringify(
      incoming.previousActualShifts || {}
    ) %>,

  previousActualHours:
    <%- JSON.stringify(
      incoming.previousActualHours || {}
    ) %>,

  previousScheduledHours:
    <%- JSON.stringify(
      incoming.previousScheduledHours || {}
    ) %>,
    templates: []
  };

  // Coverage transcribed from hamden.pdf. Blank means no preset coverage window.
  const managerCoverage = {
    manager1: { label:'Manager coverage 1', monday:'', tuesday:'3:00 PM to 8:00 PM', wednesday:'9:00 AM to 1:00 PM', thursday:'8:30 AM to 3:00 PM', friday:'2:00 PM to 9:00 PM', saturday:'9:00 AM to 9:00 PM', sunday:'' },
    manager2: { label:'Manager coverage 2', monday:'', tuesday:'8:30 AM to 5:00 PM', wednesday:'8:30 AM to 5:00 PM', thursday:'1:00 PM to 9:00 PM', friday:'8:30 AM to 6:00 PM', saturday:'', sunday:'10:00 AM to 6:00 PM' },
    manager3: { label:'Manager coverage 3', monday:'9:00 AM to 8:00 PM', tuesday:'11:00 AM to 8:00 PM', wednesday:'12:00 PM to 8:00 PM', thursday:'', friday:'12:00 PM to 9:00 PM', saturday:'1:00 PM to 9:00 PM', sunday:'' }
  };

  const associateCoverage = {
    shift1: { label:'Associate Shift 1', monday:'9:00 AM to 2:00 PM', tuesday:'9:00 AM to 2:00 PM', wednesday:'', thursday:'4:00 PM to 9:00 PM', friday:'9:00 AM to 3:00 PM', saturday:'9:00 AM to 2:00 PM', sunday:'' },
    shift2: { label:'Associate Shift 2', monday:'2:00 PM to 8:00 PM', tuesday:'', wednesday:'3:00 PM to 8:00 PM', thursday:'', friday:'3:00 PM to 9:00 PM', saturday:'3:00 PM to 9:00 PM', sunday:'10:00 AM to 6:00 PM' },
    shift3: { label:'Associate Shift 3', monday:'', tuesday:'9:00 AM to 5:00 PM', wednesday:'', thursday:'9:00 AM to 5:00 PM', friday:'9:00 AM to 5:00 PM', saturday:'9:00 AM to 6:00 PM', sunday:'' }
  };

  function employeeKey(type, name){
  return `${type}:${name}`;
}

  function initializeAvailability() {

  const allEmployees = [
    ...state.managers,
    ...state.associates
  ];

  for (const employee of allEmployees) {

    if (
      typeof state.availability[employee] !== 'boolean'
    ) {

      state.availability[employee] = true;

    }

  }

  }

  initializeAvailability();

  function available(type) {

  let list;

  if (type === 'manager') {

    // Only managers may cover manager shifts
    list = state.managers;

  } else {

    // Associates OR managers may cover associate shifts
    list = [
      ...state.associates,
      ...state.managers
    ];

  }

  return list.filter(
    name => state.availability[name] === true
  );
}

  function employeeOptions(type, selected = '') {

    const options = available(type)
    .map(name => {

      const isSelected =
        name === selected ? ' selected' : '';

      return `
        <option
          value="${escapeHtml(name)}"
          ${isSelected}
        >
          ${escapeHtml(name)}
        </option>
      `;

    })
    .join('');

  return `
    <option value="">Unassigned</option>
    ${options}
  `;

  }

  function scheduleCellKey(type, shiftId, day) {
  return `${type}:${shiftId}:${day}`;
}

function legacyAssignmentKey(shiftId, day) {
  return `${shiftId}:${day}`;
}

function getAssignment(type, shiftId, day) {
  const newKey = scheduleCellKey(type, shiftId, day);

  if (Object.prototype.hasOwnProperty.call(
    state.assignments,
    newKey
  )) {
    return state.assignments[newKey] || '';
  }

  return state.assignments[
    legacyAssignmentKey(shiftId, day)
  ] || '';
}

function getEffectiveShift(
  type,
  shiftId,
  day,
  presetShift
) {
  const key = scheduleCellKey(
    type,
    shiftId,
    day
  );

  if (
    Object.prototype.hasOwnProperty.call(
      temporaryShifts,
      key
    )
  ) {
    return temporaryShifts[key];
  }

  return presetShift || '';
}

function isTemporaryShift(
  type,
  shiftId,
  day
) {
  const key = scheduleCellKey(
    type,
    shiftId,
    day
  );

  return Object.prototype.hasOwnProperty.call(
    temporaryShifts,
    key
  );
}

function timeTextToInputValue(timeText) {
  const parsed = parseTime(timeText);

  if (parsed == null) {
    return '';
  }

  const hours = Math.floor(parsed) % 24;
  const minutes = Math.round(
    (parsed - Math.floor(parsed)) * 60
  );

  return (
    String(hours).padStart(2, '0') +
    ':' +
    String(minutes).padStart(2, '0')
  );
}

function shiftToInputValues(shiftText) {
  if (
    !shiftText ||
    !shiftText.includes(' to ')
  ) {
    return {
      start: '',
      end: ''
    };
  }

  const parts = shiftText.split(' to ');

  return {
    start: timeTextToInputValue(parts[0]),
    end: timeTextToInputValue(parts[1])
  };
}

function inputTimeToDisplay(inputValue) {
  if (!inputValue) {
    return '';
  }

  const parts = inputValue.split(':');

  let hours = Number(parts[0]);
  const minutes = Number(parts[1]);

  const suffix = hours >= 12
    ? 'PM'
    : 'AM';

  hours = hours % 12;

  if (hours === 0) {
    hours = 12;
  }

  return (
    hours +
    ':' +
    String(minutes).padStart(2, '0') +
    ' ' +
    suffix
  );
}

function saveTemporaryShift(
  type,
  shiftId,
  day
) {
  const key = scheduleCellKey(
    type,
    shiftId,
    day
  );

  const startInput = document.querySelector(
    `[data-shift-start="${key}"]`
  );

  const endInput = document.querySelector(
    `[data-shift-end="${key}"]`
  );

  if (!startInput || !endInput) {
    return;
  }

  if (!startInput.value || !endInput.value) {
    alert(
      'Enter both a start time and an end time.'
    );
    return;
  }

  const startText = inputTimeToDisplay(
    startInput.value
  );

  const endText = inputTimeToDisplay(
    endInput.value
  );

  const newShift =
    `${startText} to ${endText}`;

  let reason = '';

  if (!buildingNewTemplate) {
    const existingNote =
      temporaryShiftNotes[key] || '';

    const enteredReason = window.prompt(
      'Reason for this schedule change:',
      existingNote
    );

    if (enteredReason === null) {
      renderAllTables();
      return;
    }

    reason = enteredReason.trim();
  }

  /*
   * Only save the shift after the user has
   * completed or accepted the reason prompt.
   */
  temporaryShifts[key] = newShift;
  temporaryShiftNotes[key] = reason;

  renderAllTables();
}

function clearTemporaryShift(
  type,
  shiftId,
  day,
  hasPreset
) {
  const key = scheduleCellKey(
    type,
    shiftId,
    day
  );

  delete temporaryShifts[key];
  delete temporaryShiftNotes[key];

  if (!hasPreset) {
    state.assignments[key] = '';
  }

  renderAllTables();
}

  function renderCoverage(
  tableId,
  coverage,
  type
) {
  const tbody = document.querySelector(
    `#${tableId} tbody`
  );

  tbody.innerHTML = Object.entries(coverage)
    .map(([shiftId, row]) => {
      const cells = DAY_KEYS.map(day => {
        const presetShift = row[day] || '';

        const shift = getEffectiveShift(
          type,
          shiftId,
          day,
          presetShift
        );

        const temporary = isTemporaryShift(
          type,
          shiftId,
          day
        );

        const assignmentKey = scheduleCellKey(
          type,
          shiftId,
          day
        );

        if (!shift) {
          return `
            <td>
              <span
                style="display:block;color:#94a3b8;margin-bottom:7px"
              >
                No preset shift
              </span>

              <button
                type="button"
                class="add-shift-button"
                data-add-shift-type="${escapeHtml(type)}"
                data-add-shift-id="${escapeHtml(shiftId)}"
                data-add-shift-day="${escapeHtml(day)}"
              >
                Add shift
              </button>
            </td>
          `;
        }

        const inputValues =
          shiftToInputValues(shift);

        const selectedEmployee = getAssignment(
          type,
          shiftId,
          day
        );

        return `
          <td>
            <span class="shift-label ${
              temporary
                ? 'temporary-shift'
                : ''
            }">
              ${escapeHtml(shift)}
            </span>

            ${
              temporary
                ? `
                  <span class="temporary-note">
                    Temporary change
                  </span>
                `
                : ''
            }

            <div class="shift-editor">
              <input
                type="time"
                value="${inputValues.start}"
                data-shift-start="${assignmentKey}"
                aria-label="Shift start time"
              >

              <input
                type="time"
                value="${inputValues.end}"
                data-shift-end="${assignmentKey}"
                aria-label="Shift end time"
              >
            </div>

            <div class="shift-edit-actions">
              <button
                type="button"
                class="shift-edit-button"
                data-save-shift-type="${escapeHtml(type)}"
                data-save-shift-id="${escapeHtml(shiftId)}"
                data-save-shift-day="${escapeHtml(day)}"
              >
                Apply time
              </button>

              ${
                temporary
                  ? `
                    <button
                      type="button"
                      class="shift-clear-button"
                      data-clear-shift-type="${escapeHtml(type)}"
                      data-clear-shift-id="${escapeHtml(shiftId)}"
                      data-clear-shift-day="${escapeHtml(day)}"
                      data-has-preset="${
                        presetShift
                          ? 'true'
                          : 'false'
                      }"
                    >
                      ${
                        presetShift
                          ? 'Reset'
                          : 'Remove'
                      }
                    </button>
                  `
                  : ''
              }
            </div>

            <select
                class="${
                    !selectedEmployee
                    ? 'unassigned-shift'
                    : ''
            }"
            data-assignment="${assignmentKey}"
            data-type="${escapeHtml(type)}"
            onchange="setAssignment(this)"
            >
              ${employeeOptions(
                type,
                selectedEmployee
              )}
            </select>
          </td>
        `;
      }).join('');

      return `
        <tr>
          <td>${escapeHtml(row.label)}</td>
          ${cells}
        </tr>
      `;
    })
    .join('');
}

