  function renderAttendance() {
  const buildScheduleNames = [
    ...new Set([
      ...state.managers,
      ...state.associates
    ])
  ];

  const periods = [
    'week',
    'year',
    'allTime'
  ];

  const fields = [
    'absences',
    'tardies',
    'leftEarly'
  ];

  /*
   * Only use employees listed on the Build Schedule.
   * Find attendance using the employee number saved
   * for that Build Schedule employee.
   */
  const employees = buildScheduleNames.map(buildName => {
    const employeeNumber = String(
      state.buildEmployeeIdentifiers?.[
        buildName
      ] || ''
    ).trim();

    const attendanceRecord = employeeNumber
      ? state.attendance?.[employeeNumber]
      : null;

    /*
     * The row still displays the Build Schedule name.
     * Attendance only connects when the employee number
     * exists and the uploaded name also matches.
     */
    const uploadedName = String(
      attendanceRecord?.employeeName || ''
    ).trim();

    const numberMatches =
      Boolean(employeeNumber) &&
      Boolean(attendanceRecord);

    const nameMatches =
      normalizeEmployeeName(uploadedName) ===
      normalizeEmployeeName(buildName);

    const matched =
      numberMatches &&
      nameMatches;

    return {
      buildName,
      employeeNumber,
      attendance: matched
        ? attendanceRecord
        : null
    };
  });

  document.querySelector(
    '#attendanceTable tbody'
  ).innerHTML = employees.map(employee => {
    const {
      buildName,
      employeeNumber,
      attendance
    } = employee;

