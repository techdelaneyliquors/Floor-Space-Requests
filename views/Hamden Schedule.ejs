      fields.map(field => {
        const value = Number(
          attendance?.[period]?.[field] || 0
        );

        return `
          <td>
            <input
              type="number"
              min="0"
              value="${value}"
              data-attendance-number="${
                escapeHtml(employeeNumber)
              }"
              data-attendance-name="${
                escapeHtml(buildName)
              }"
              data-attendance-period="${
                escapeHtml(period)
              }"
              data-attendance-field="${
                escapeHtml(field)
              }"
              ${
                attendance
                  ? ''
                  : 'disabled'
              }
            >
          </td>
        `;
      })
    ).join('');

    return `
      <tr>
        <td>
          ${escapeHtml(buildName)}
        </td>

        ${cells}
      </tr>
    `;
  }).join('');
}

function normalizeEmployeeName(value) {
  let normalized = String(value || '')
    .trim()
    .toLowerCase();

  if (normalized === 'thomas') {
    normalized = 'thom';
  }

  return normalized;
}


function getMatchingUploadedName(buildName) {
  const buildIdentifier = String(
    state.buildEmployeeIdentifiers?.[
      buildName
    ] || ''
  ).trim();

  if (!buildIdentifier) {
    return '';
  }

  return Object.keys(
    state.employeeIdentifiers || {}
  ).find(uploadedName => {
    const uploadedIdentifier = String(
      state.employeeIdentifiers?.[
        uploadedName
      ] || ''
    ).trim();

    return (
      normalizeEmployeeName(uploadedName) ===
        normalizeEmployeeName(buildName) &&
      uploadedIdentifier === buildIdentifier
    );
  }) || '';
}
