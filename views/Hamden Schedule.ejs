function generateScheduleComments() {

  const comments = [];

  const coverageGroups = [
    {
      type: 'manager',
      coverage: managerCoverage
    },
    {
      type: 'associate',
      coverage: associateCoverage
    }
  ];

  coverageGroups.forEach(group => {

    Object.entries(group.coverage)
      .forEach(([shiftId,row]) => {

        DAY_KEYS.forEach(day => {

          const key =
            scheduleCellKey(
              group.type,
              shiftId,
              day
            );

          if (!(key in temporaryShifts)) {
            return;
          }

          const originalShift =
            row[day] || '';

          const newShift =
            temporaryShifts[key];

          const note =
            temporaryShiftNotes[key] ||
            'No explanation provided';

          const shiftLabel =
            row.label;

          if (!originalShift) {

            comments.push({
              type: 'Added Shift',
              day: DAYS[
                DAY_KEYS.indexOf(day)
              ],
              shift: shiftLabel,
              details: newShift,
              reason: note
            });

          } else {

            comments.push({
              type: 'Adjusted Shift',
              day: DAYS[
                DAY_KEYS.indexOf(day)
              ],
              shift: shiftLabel,
              details:
                `${originalShift} → ${newShift}`,
              reason: note
            });

          }

        });

      });

  });

  return comments;

}
