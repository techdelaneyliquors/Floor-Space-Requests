async function loadSelectedTemplate() {
  const selector = document.getElementById(
    'templateSelector'
  );

  const templateId = selector?.value || '';

  if (!templateId) {
    alert('Select a template first.');
    return;
  }

  const response = await fetch(
    `/api/schedule-templates/${
      encodeURIComponent(templateId)
    }?store=${
      encodeURIComponent(state.store)
    }`,
    {
      method: 'GET',
      credentials: 'same-origin'
    }
  );

  const result = await response.json();

  if (!response.ok) {
    throw new Error(
      result.error ||
      'The template could not be loaded.'
    );
  }

  const template = result.template;
  state.currentTemplateName =
  template.templateName || '';

  if (!template) {
    throw new Error(
      'The server did not return a template.'
    );
  }

  const templateData =
    template.templateData || {};

  const loadedManagerCoverage =
    cloneTemplateData(
      templateData.managerCoverage || {}
    );

  const loadedAssociateCoverage =
    cloneTemplateData(
      templateData.associateCoverage || {}
    );

  /*
   * Backward compatibility:
   * Merge shifts stored in either the current
   * lowercase property or the old uppercase property.
   */
  const legacyTemporaryShifts =
    templateData.temporaryShifts ||
    templateData.TemporaryShifts ||
    {};

  Object.entries(
    legacyTemporaryShifts
  ).forEach(([key, shiftText]) => {
    const [
      type,
      shiftId,
      day
    ] = key.split(':');

    /*
     * Ignore malformed temporary-shift keys.
     */
    if (!DAY_KEYS.includes(day)) {
      return;
    }

    if (
      type === 'manager' &&
      loadedManagerCoverage[shiftId]
    ) {
      loadedManagerCoverage[
        shiftId
      ][day] = shiftText;
    }

    if (
      type === 'associate' &&
      loadedAssociateCoverage[shiftId]
    ) {
      loadedAssociateCoverage[
        shiftId
      ][day] = shiftText;
    }
  });

  /*
   * Apply the assignments and permanent coverage
   * from the selected template.
   */
  replaceObjectContents(
    state.assignments,
    templateData.assignments || {}
  );

  replaceObjectContents(
    managerCoverage,
    loadedManagerCoverage
  );

  replaceObjectContents(
    associateCoverage,
    loadedAssociateCoverage
  );

  /*
   * A loaded template contains permanent shifts,
   * so nothing should remain marked temporary.
   */
  replaceObjectContents(
    temporaryShifts,
    {}
  );

  replaceObjectContents(
    temporaryShiftNotes,
    {}
  );

  buildingNewTemplate = false;

  renderAllTables();

  alert(
    `"${template.templateName || 'Template'}" was loaded.`
  );
}

function beginNewTemplate() {
  const confirmed = window.confirm(
    'Start a new blank template? ' +
    'All current shift times, assignments, ' +
    'and unsaved schedule changes will be cleared.'
  );

  if (!confirmed) {
    return;
  }

  /*
   * Preserve the coverage row labels but clear
   * every shift time from Monday through Sunday.
   */
  state.currentTemplateName =
  'New Unsaved Template';
  const blankManagerCoverage =
    createBlankCoverage(
      managerCoverage
    );

  const blankAssociateCoverage =
    createBlankCoverage(
      associateCoverage
    );

  replaceObjectContents(
    managerCoverage,
    blankManagerCoverage
  );

  replaceObjectContents(
    associateCoverage,
    blankAssociateCoverage
  );

  /*
   * Clear all employee assignments.
   */
  replaceObjectContents(
    state.assignments,
    {}
  );

  /*
   * Clear all temporary shifts and adjustment notes.
   */
  replaceObjectContents(
    temporaryShifts,
    {}
  );

  replaceObjectContents(
    temporaryShiftNotes,
    {}
  );

  const selector =
    document.getElementById(
      'templateSelector'
    );

  if (selector) {
    selector.value = '';
  }
  buildingNewTemplate = true;
  renderAllTables();
}

async function deleteSelectedTemplate() {
  const selector =
    document.getElementById(
      'templateSelector'
    );

  const templateId =
    selector?.value || '';

  if (!templateId) {
    alert('Select a template first.');
    return;
  }

  const selectedOption =
    selector.options[
      selector.selectedIndex
    ];

  const templateName =
    selectedOption?.textContent?.trim() ||
    'this template';

  const confirmed = window.confirm(
    `Delete "${templateName}"?`
  );

  if (!confirmed) {
    return;
  }

  const response = await fetch(
    `/api/schedule-templates/${
      encodeURIComponent(templateId)
    }?store=${
      encodeURIComponent(state.store)
    }`,
    {
      method: 'DELETE',
      credentials: 'same-origin'
    }
  );

  const result = await response.json();

  if (!response.ok) {
    throw new Error(
      result.error ||
      'The template could not be deleted.'
    );
  }

  await loadTemplateList();

  alert('Template deleted.');
}

document
  .getElementById('loadTemplateBtn')
  .addEventListener(
    'click',
    async () => {
      try {
        await loadSelectedTemplate();
      } catch (err) {
        console.error(
          'Template load error:',
          err
        );

        alert(err.message);
      }
    }
  );

document
  .getElementById('saveTemplateBtn')
  .addEventListener(
    'click',
    async () => {
      try {
        await saveCurrentAsTemplate();
      } catch (err) {
        console.error(
          'Template save error:',
          err
        );

        alert(err.message);
      }
    }
  );

document
  .getElementById('newTemplateBtn')
  .addEventListener(
    'click',
    beginNewTemplate
  );

document
  .getElementById('deleteTemplateBtn')
  .addEventListener(
    'click',
    async () => {
      try {
        await deleteSelectedTemplate();
      } catch (err) {
        console.error(
          'Template delete error:',
          err
        );

        alert(err.message);
      }
    }
  );
function restoreDefaultTemplate() {

  replaceObjectContents(
    managerCoverage,
    defaultManagerCoverage
  );

  replaceObjectContents(
    associateCoverage,
    defaultAssociateCoverage
  );

  replaceObjectContents(
    state.assignments,
    {}
  );

  replaceObjectContents(
    temporaryShifts,
    {}
  );

  replaceObjectContents(
    temporaryShiftNotes,
    {}
  );

  buildingNewTemplate = false;

  renderAllTables();
}
  window.removeEmployee = removeEmployee;

  window.addEmployee = addEmployee;

  window.toggleAvailability = toggleAvailability;

  window.setAssignment = setAssignment;
  async function initializeSchedulePage() {
  renderAllTables();

  try {
    await loadTemplateList();

    const defaultTemplate =
      state.templates.find(
        template =>
          template.isDefault === true
      );

    if (defaultTemplate) {
      const selector =
        document.getElementById(
          'templateSelector'
        );

      selector.value =
        defaultTemplate._id;

      await loadSelectedTemplate();
    }
  } catch (err) {
    console.error(
      'Template initialization error:',
      err
    );
  }
}

initializeSchedulePage();
</script>
</body>
</html>
