
<!DOCTYPE html>
<html>
<head>
  <title>Login</title>

  <style>
    body {
      margin: 0;
      font-family: 'Inter', sans-serif;
      display: flex;
      justify-content: center;
      align-items: center;
      height: 100vh;

      background-image: url('/Images/Enjoy Logo w Text.png');
      background-size: 40%;
      background-position: center;
      background-repeat: no-repeat;
      background-color: #f6f6f6;
    }

    .login-container {
      background: rgba(255,255,255,0.95);
      padding: 35px;
      border-radius: 12px;
      width: 330px;
      box-shadow: 0 10px 25px rgba(0,0,0,0.15);
      text-align: center;
    }

    h1 {
      margin-bottom: 10px;
    }

    .subtitle {
      font-size: 14px;
      color: #555;
      margin-bottom: 20px;
    }

    .form-group {
      text-align: left;
      margin-bottom: 15px;
    }

    label {
      font-size: 14px;
      font-weight: 500;
      display: block;
      margin-bottom: 5px;
    }

    input {
      width: 100%;
      padding: 10px 12px;
      border: 1px solid #ccc;
      border-radius: 8px;
      font-size: 14px;
      transition: all 0.2s ease;
    }

    input:focus {
      outline: none;
      border-color: #007bff;
      box-shadow: 0 0 4px rgba(0,123,255,0.4);
    }

    .btn-login {
      margin-top: 10px;
      width: 100%;
      padding: 10px;
      background: #2120ba;
      color: white;
      border: none;
      border-radius: 8px;
      font-size: 15px;
      cursor: pointer;
      transition: all 0.2s ease;
    }

    .btn-login:hover {
      background: #1b1AA1;
      box-shadow: 0 6px 16px rgba(0,0,0,0.25);
      transform: translateY(-1px);
    }

    .register-link {
      margin-top: 15px;
      font-size: 14px;
    }

    .register-link a {
      text-decoration: none;
      color: #2120ba;
      font-weight: 500;
    }

    .register-link a:hover {
      text-decoration: underline;
    }

    .error {
      color: red;
      margin-bottom: 10px;
    }

  </style>
</head>

<body>

  <div class="login-container">

    <h1>Login</h1>
    <div class="subtitle">
      Welcome to <strong>Delaney Liquors Floor Manager</strong>
    </div>

    <% if (error) { %>
      <div class="error"><%= error %></div>
    <% } %>

    <form action="/login" method="POST">

      <div class="form-group">
        <label for="email">Email</label>
        <input type="email" id="email" name="email" required>
      </div>

      <div class="form-group">
        <label for="password">Password</label>
        <input type="password" id="password" name="password" required>
      </div>

      <button type="submit" class="btn-login">Login</button>

    </form>

    <div class="register-link">
      <a href="/register">Create an account</a>
    </div>
    
<div class="register-link">
<a href="/forgot-password">Forgot password?</a>
</div>

  </div>

</body>
</html>
