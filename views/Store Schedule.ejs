// "Monday, Sep 14 – Sunday, Sep 20, 2026" for the uploaded previous week.
// Dates are stored at noon UTC, so format them in UTC to keep the day.
function renderPreviousWeekDates() {
  const label = document.getElementById('previousWeekDates');
  if (!label) return;

  const start = state.previousWeekStart
    ? new Date(state.previousWeekStart)
    : null;

  if (!start || Number.isNaN(start.getTime())) {
    label.textContent = 'No previous week has been uploaded yet.';
    return;
  }

  let end = state.previousWeekEnd
    ? new Date(state.previousWeekEnd)
    : null;

  if (!end || Number.isNaN(end.getTime())) {
    end = new Date(start);
    end.setUTCDate(end.getUTCDate() + 6);
  }

  const format = (date, withYear) =>
    date.toLocaleDateString('en-US', {
      timeZone: 'UTC',
      weekday: 'long',
      month: 'short',
      day: 'numeric',
      ...(withYear ? { year: 'numeric' } : {})
    });

  label.textContent =
    `Week of ${format(start, start.getUTCFullYear() !== end.getUTCFullYear())} – ` +
    format(end, true);
}

  function renderPrevious() {
  renderPreviousWeekDates();

  const table =
    document.getElementById(
      'previousWeekComparisonTable'
    );

  if (!table) {
    return;
  }

  /*
   * Only include employees currently listed
   * on the Build Schedule page.
   */
  const buildScheduleNames = [
    ...new Set([
      ...state.managers,
      ...state.associates,
      ...state.cashiers
    ])
  ];

  /*
   * Match each Build Schedule employee to the
   * previous-week upload by both employee name
   * and employee number.
   */
  const matchedEmployees =
    buildScheduleNames
      .map(buildName => {
        const uploadedName =
          getMatchingUploadedName(
            buildName
          );

        if (!uploadedName) {
          return null;
        }

        const hasReviewData =
          Boolean(
            state.previousScheduledShifts?.[
              uploadedName
            ]
          ) ||
          Boolean(
            state.previousActualShifts?.[
              uploadedName
            ]
          ) ||
          Boolean(
            state.previousActualHours?.[
              uploadedName
            ]
          ) ||
          state.previousScheduledHours?.[
            uploadedName
          ] !== undefined;

        if (!hasReviewData) {
          return null;
        }

        return {
          buildName,
          uploadedName
        };
      })
      .filter(Boolean);

  const dayTotals =
    Object.fromEntries(
      DAY_KEYS.map(day => [
        day,
        {
          scheduled: 0,
          actual: 0
        }
      ])
    );

  let totalScheduled = 0;
  let totalWorked = 0;

  /*
   * These values are used in the final TOTAL row.
   */
  let totalActualOvertime = 0;
  let totalPlannedOvertime = 0;
  let totalPaidOvertime = 0;
  let totalApprovedOvertime = 0;
  let totalOverApproval = 0;

  const rows =
    matchedEmployees
      .map(employee => {
        const {
          buildName,
          uploadedName
        } = employee;

        /*
         * Approved overtime is stored by employee
         * number, not employee name.
         */
        const employeeIdentifier =
          String(
            state.buildEmployeeIdentifiers?.[
              buildName
            ] || ''
          ).trim();

        const scheduledShifts =
          state.previousScheduledShifts?.[
            uploadedName
          ] || {};

        const actualShifts =
          state.previousActualShifts?.[
            uploadedName
          ] || {};

        const actualHours =
          state.previousActualHours?.[
            uploadedName
          ] || {};

        const scheduledTotal =
          Number(
            state.previousScheduledHours?.[
              uploadedName
            ] || 0
          );

        const clockedTotal =
          DAY_KEYS.reduce(
            (sum, day) =>
              sum +
              Number(
                actualHours[day] || 0
              ),
            0
          );

        // Paid sick days count as hours worked (not overtime)
        const paidSickTotal =
          DAY_KEYS.reduce(
            (sum, day, dayIndex) =>
              sum + paidSickHours(employeeIdentifier, getExceptionDate(dayIndex)),
            0
          );

        const workedTotal =
          clockedTotal + paidSickTotal;

        const difference =
          workedTotal -
          scheduledTotal;

        /*
         * Compare the employee's actual weekly
         * hours against the approved overtime
         * allowance.
         *
         * Example:
         *
         * Worked = 45
         * Approved OT = 3
         * Actual OT = 5
         * Over approval = 2
         */
        const overtimeApproval =
          calculateOvertimeApproval(
            employeeIdentifier,
            clockedTotal
          );

        totalScheduled +=
          scheduledTotal;

        totalWorked +=
          workedTotal;

        totalActualOvertime +=
          overtimeApproval.overtimeHours;

        // Planned OT: scheduled hours over 40. Paid OT: clocked hours over
        // 40 (hourly only; paid sick days aren't overtime). Salaried: none.
        const salaried = isSalaried(employeeIdentifier);
        const plannedOvertime = salaried ? 0 : Math.max(0, scheduledTotal - 40);
        totalPlannedOvertime += plannedOvertime;
        totalPaidOvertime += paidOvertimeFor(employeeIdentifier, clockedTotal);

        totalApprovedOvertime +=
          overtimeApproval
            .approvedOvertimeHours;

        totalOverApproval +=
          overtimeApproval
            .unapprovedOvertimeHours;

        DAY_KEYS.forEach((day, dayIndex) => {
          const actualDayHours =
            Number(
              actualHours[day] || 0
            ) +
            paidSickHours(employeeIdentifier, getExceptionDate(dayIndex));

          const scheduledDayHours =
            scheduledPaidHoursFromRanges(
              scheduledShifts[day]
            );

          dayTotals[day].scheduled +=
            scheduledDayHours;

          dayTotals[day].actual +=
            actualDayHours;
        });

        const differenceClass =
          difference < 0
            ? 'negative'
            : difference > 0
              ? 'positive'
              : '';

        const dayCells =
          DAY_KEYS.map((day, dayIndex) => {
            const sickDay = sickDayFor(employeeIdentifier, getExceptionDate(dayIndex));
            const sickMarker = sickDay
              ? `<span class="sick-marker">${
                  sickDay.type === 'paid-sick'
                    ? `Paid sick ${Number(sickDay.hours).toFixed(2)}`
                    : 'Unpaid sick'
                }</span>`
              : '';

            const plannedValues =
              normalizeShiftValues(
                scheduledShifts[day]
              );

            const actualValues =
              normalizeShiftValues(
                actualShifts[day]
              );

            const scheduledDayHours =
              scheduledPaidHoursFromRanges(
                plannedValues
              );

            const actualDayHours =
              Number(
                actualHours[day] || 0
              );

            const hasDailyOvertime =
              scheduledDayHours > 0 &&
              actualDayHours >=
                scheduledDayHours + 0.5;

            const issue =
              plannedValues.length &&
              actualValues.length
                ? hasAttendanceIssue(
                    plannedValues[0],
                    actualValues[0]
                  )
                : null;

            let cellClass =
              'comparison-cell';

            const noTimeWorked =
              plannedValues.length > 0 &&
              actualValues.length === 0;

            // Worked a day they weren't scheduled ("OFF" with time below)
            const unscheduledWork =
              plannedValues.length === 0 &&
              actualValues.length > 0;

            if (noTimeWorked) {
              cellClass +=
                ' no-time-worked-cell';
            } else if (unscheduledWork) {
              cellClass +=
                ' unscheduled-work-cell';
            } else if (issue) {
              if (
                issue.late &&
                issue.early
              ) {
                cellClass +=
                  ' attendance-severe';
              } else if (
                issue.late ||
                issue.early
              ) {
                cellClass +=
                  ' attendance-issue';
              }
            }

            if (hasDailyOvertime) {
              cellClass +=
                ' overtime-issue';
            }

            const plannedHtml = plannedValues.length
  ? plannedValues
      .map(value =>
        escapeHtml(
          value.replace(
            ' to ',
            ' - '
          )
        )
      )
      .join('<br>')
  : 'OFF';

            const actualHtml = actualValues.length
  ? actualValues
      .map(value =>
        escapeHtml(
          value.replace(
            ' to ',
            ' - '
          )
        )
      )
      .join('<br>')
  : 'No time worked';

            /*
             * If the employee was off and did not
             * work, leave the day empty.
             */
            if (
              plannedHtml === 'OFF' &&
              actualHtml ===
                'No time worked'
            ) {
              return `
                <td class="${cellClass}">
                </td>
              `;
            }

            return `
              <td class="${cellClass}">
                <span class="planned-shift">
                  ${plannedHtml}
                </span>

                <span class="actual-shift ${
                  actualValues.length
                    ? ''
                    : 'no-time-worked'
                }">
                  ${actualHtml}
                </span>
                ${sickMarker}
              </td>
            `;
          }).join('');

        return `
          <tr>
            <td>
  ${escapeHtml(
    shortenEmployeeName(
      buildName
    )
  )}
</td>


            ${dayCells}

            <td class="comparison-hours">
              ${scheduledTotal.toFixed(2)}
            </td>

            <td class="comparison-hours">
              ${workedTotal.toFixed(2)}
            </td>

            <td class="
              comparison-hours
              ${differenceClass}
            ">
              ${difference.toFixed(2)}
            </td>

            <td class="comparison-hours">
              ${salaried ? '—' : plannedOvertime.toFixed(2)}
            </td>

            ${paidOvertimeCell(employeeIdentifier, clockedTotal, plannedOvertime, 'the planned OT')}
          </tr>
        `;
      })
      .join('');

  const grandDifference =
    totalWorked -
    totalScheduled;

  const grandDifferenceClass =
    grandDifference < 0
      ? 'negative'
      : grandDifference > 0
        ? 'positive'
        : '';

  const totalDayCells =
    DAY_KEYS.map(day => `
      <td class="metric">
        <div>
          S:
          ${
            dayTotals[
              day
            ].scheduled.toFixed(2)
          }
        </div>

        <div
          style="
            font-style:italic;
            color:#64748b;
            margin-top:2px;
          "
        >
          A:
          ${
            dayTotals[
              day
            ].actual.toFixed(2)
          }
        </div>
      </td>
    `).join('');

  const paidOverPlanned =
    totalPaidOvertime - totalPlannedOvertime > 0.005;

  const totalRow = `
    <tr class="total-row">
      <td>
        TOTAL
      </td>

      ${totalDayCells}

      <td class="metric">
        ${totalScheduled.toFixed(2)}
      </td>

      ${budgetTotalCell(totalWorked, previousBudgetWeek(), 'Worked')}

      <td class="
        metric
        ${grandDifferenceClass}
      ">
        ${grandDifference.toFixed(2)}
      </td>

      <td class="metric">
        ${totalPlannedOvertime.toFixed(2)}
      </td>

      <td class="metric ${paidOverPlanned ? 'overtime-over-limit' : ''}">
        ${totalPaidOvertime.toFixed(2)}
      </td>
    </tr>
  `;

  table.innerHTML = `
    <thead>
      <tr>
        <th>
          Employee
        </th>

        ${DAYS.map(day => `
          <th>
            ${escapeHtml(day)}
          </th>
        `).join('')}

        <th>
          Sched.
        </th>

        <th>
          Worked
        </th>

        <th>
          Δ
        </th>

        <th title="Scheduled hours over 40">
          Planned OT
        </th>

        <th title="Worked hours over 40 (hourly employees)">
          Paid OT
        </th>
      </tr>
    </thead>

    <tbody>
      ${
        rows ||
        `
          <tr>
            <td colspan="13">
              No employees had matching names,
              employee numbers, and previous-week data.
            </td>
          </tr>
        `
      }

      ${rows ? totalRow : ''}
    </tbody>
  `;

  const attendanceExceptions =
    getPreviousWeekExceptions();

  currentAttendanceExceptions =
    Object.fromEntries(
      [
        ...attendanceExceptions.late,
        ...attendanceExceptions.early,
        ...attendanceExceptions.both,
        ...attendanceExceptions.absence,
        ...attendanceExceptions.overtime
      ].map(item => [
        item.id,
        item
      ])
    );

  renderAttendanceExceptionReview(
    attendanceExceptions
  );
}

function shiftHoursFromRanges(value) {

  const shifts =
    normalizeShiftValues(value);

  let total = 0;

  shifts.forEach(shift => {
    total += shiftHours(shift);
  });

  return total;

}

function defaultPointsForException(type) {
  const defaults = {
    late: 1,
    tardy: 1,

    early: 1,
    left_early: 1,

    both: 2,
    late_and_left_early: 2,

    absence: 0,
    no_call_no_show: 5
  };

  return defaults[type] ?? 0;
}

function getPointOptions(type) {
  if (
    type === 'late' ||
    type === 'tardy'
  ) {
    return [0, 1];
  }

  if (
    type === 'early' ||
    type === 'left_early'
  ) {
    return [0, 1];
  }

  if (
    type === 'both' ||
    type === 'late_and_left_early'
  ) {
    return [0, 1, 2];
  }

  if (type === 'absence') {
    return [0, 1, 2, 3, 4, 5];
  }

  if (type === 'no_call_no_show') {
    return [0, 5];
  }

  return [0];
}


function apiInfractionType(type) {
  const values = {
    late: 'tardy',
    early: 'left_early',
    both: 'late_and_left_early',
    absence: 'absence',
    no_call_no_show:
      'no_call_no_show'
  };

  return values[type] || type;
}

function buildOvertimeSourceExceptionId(
  item
) {
  return [
    state.store,
    'overtime',
    item.employeeNumber,
    item.infractionDate
  ].join(':');
}

function buildSourceExceptionId(
  item,
  selectedInfractionType = ''
) {
  const infractionType =
    selectedInfractionType ||
    apiInfractionType(item.type);

  return [
    state.store,
    infractionType,
    item.employeeNumber,
    item.infractionDate
  ].join(':');
}

async function loadExistingOvertimeReviews() {
  const parameters =
    new URLSearchParams({
      store: state.store,
      includeAll: 'true'
    });

  const response = await fetch(
    `/api/overtime-reviews?${parameters.toString()}`,
    {
      method: 'GET',

      credentials: 'same-origin',

      headers: {
        Accept: 'application/json'
      }
    }
  );

  const responseText =
    await response.text();

  let result = {};

  try {
    result = responseText
      ? JSON.parse(responseText)
      : {};
  } catch (parseError) {
    throw new Error(
      `Overtime reviews returned HTTP ` +
      `${response.status}. The server returned ` +
      `a non-JSON response.`
    );
  }

  if (!response.ok) {
    throw new Error(
      result.error ||
      'Overtime reviews could not be loaded.'
    );
  }

  const reviews =
    Array.isArray(result.reviews)
      ? result.reviews
      : [];

  existingOvertimeReviews =
    Object.fromEntries(
      reviews
        .filter(review =>
          review &&
          review.sourceExceptionId &&
          review.voided !== true
        )
        .map(review => [
          review.sourceExceptionId,
          review
        ])
    );

  overtimeReviewsLoaded = true;

  renderPrevious();
}

