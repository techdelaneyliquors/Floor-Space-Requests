<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= storeName %> Weekly Schedule</title>
  <style>
    :root {
      --navy:#17365d; --blue:#2f5597; --light:#eaf1fb; --line:#cbd5e1;
      --text:#172033; --muted:#64748b; --green:#15803d; --amber:#b45309;
      --red:#b91c1c; --white:#fff; --shadow:0 12px 32px rgba(15,23,42,.08);
    }
    * { box-sizing:border-box; }
    body { margin:0; font-family:Inter,Segoe UI,Arial,sans-serif; background:#f5f7fb; color:var(--text); }
    .page-shell { max-width:1500px; margin:0 auto; padding:24px; }
    .topbar { display:flex; justify-content:space-between; gap:16px; align-items:center; margin-bottom:18px; }
    .topbar h1 { margin:0; font-size:28px; color:var(--navy); }
    .topbar p { margin:5px 0 0; color:var(--muted); }
    .actions { display:flex; gap:10px; flex-wrap:wrap; }
    button { border:0; border-radius:8px; padding:10px 14px; font-weight:700; cursor:pointer; }
    .primary { background:var(--navy); color:#fff; }
    .secondary { background:#fff; color:var(--navy); border:1px solid var(--line); }
    .module-tabs { display:flex; gap:8px; overflow:auto; padding-bottom:10px; position:sticky; top:0; z-index:20; background:#f5f7fb; }
    .module-tabs button { white-space:nowrap; background:#dbe7f7; color:var(--navy); }
    .module-tabs button.active { background:var(--navy); color:#fff; }
    .module { display:none; }
    .module.active { display:block; }
    .module-card { background:#fff; border:1px solid #e2e8f0; border-radius:14px; box-shadow:var(--shadow); margin:14px 0 24px; overflow:hidden; }
    .module-heading { padding:18px 22px; background:linear-gradient(135deg,var(--navy),var(--blue)); color:#fff; }
    .module-heading h2 { margin:0; font-size:21px; }
    .module-heading p { margin:5px 0 0; opacity:.85; }
    .section { padding:22px; border-top:1px solid #e7edf5; }
    .section:first-of-type { border-top:0; }
    .section-title { display:flex; justify-content:space-between; align-items:end; gap:14px; margin-bottom:12px; }
    .section-title h3 { margin:0; color:var(--navy); font-size:17px; }
    .section-title small { color:var(--muted); }
    .table-wrap { overflow:auto; border:1px solid var(--line); border-radius:10px; }
    table { width:100%; border-collapse:collapse; min-width:980px; background:#fff; }
    th, td { border-bottom:1px solid var(--line); border-right:1px solid #e8edf4; padding:6px; text-align:center; vertical-align:middle; }
    th { background:#e9f0fa; color:var(--navy); font-size:12px; text-transform:uppercase; letter-spacing:.03em; }
    td:first-child, th:first-child { text-align:left; font-weight:700; position:sticky; left:0; background:inherit; z-index:2; }
    tr:last-child td { border-bottom:0; }
    select, input { width:100%; min-width:105px; border:1px solid #cbd5e1; border-radius:6px; padding:7px 8px; background:#fff; color:var(--text); }
    input[type="checkbox"] { min-width:auto; width:18px; height:18px; }
    .shift-label { display:block; font-size:12px; font-weight:700; color:#334155; margin-bottom:5px; }
    .stack { display:grid; gap:7px; }
    .availability-grid { display:grid; grid-template-columns:repeat(2,minmax(0,1fr)); gap:14px; }
    .people-box { border:1px solid var(--line); border-radius:10px; padding:14px; background:#fafcff; }
    .people-box h4 { margin:0 0 10px; color:var(--navy); }
    .person-row { display:flex; justify-content:space-between; align-items:center; gap:12px; padding:7px 0; border-bottom:1px dashed #dbe3ee; }
    .person-row:last-child { border:0; }
    .badge { display:inline-block; padding:4px 8px; border-radius:999px; font-size:11px; font-weight:800; }
    .manager { background:#dbeafe; color:#1d4ed8; }
    .associate { background:#dcfce7; color:#15803d; }
    .metric { font-weight:800; }
    .negative { color:var(--red); }
    .positive { color:var(--green); }
    .attendance-grid { display:grid; grid-template-columns:repeat(3,1fr); gap:8px; }
    .attendance-grid input { min-width:55px; }
    .print-sheet { padding:16px; background:#fff; }
    .print-sheet h2 { text-align:center; margin:0 0 4px; }
    .print-sheet .period { text-align:center; color:var(--muted); margin-bottom:16px; }
    .no-print-note { background:#fff7ed; border:1px solid #fed7aa; color:#9a3412; padding:10px 12px; border-radius:8px; margin-bottom:12px; }
    .actual-cell { white-space:pre-line; line-height:1.45; }
    @media(max-width:850px){ .availability-grid{grid-template-columns:1fr;} .topbar{align-items:flex-start;flex-direction:column;} }
    @media print {

  * {
    -webkit-print-color-adjust: exact !important;
    print-color-adjust: exact !important;
  }

  .table-wrap {
    overflow: visible !important;
  }

  body {
    background:#fff;
  }

  .page-shell {
    max-width:none;
    padding:0;
  }

  .topbar,
  .module-tabs,
  .no-print,
  .no-print-note {
    display:none !important;
  }

  .module {
    display:none !important;
  }

  /* Default print = schedule */
  #module-3.print-page {
    display:block !important;
  }

  /* Previous week review print */
  #module-5.print-previous {
    display:block !important;
  }

  .module-heading {
    display:none;
  }

  .module-card {
    box-shadow:none;
    border:0;
    margin:0;
  }

  .section {
    padding:0;
    border:0;
  }

  /*
   * Use the same table styling as the screen view.
   * Do not override Previous Week font sizes.
   */
  table {
    min-width:0;
  }

  @page {
    size: landscape;
    margin: 0.2in;
  }
}

    .person-controls {
  display: flex;
  align-items: center;
  gap: 12px;
  }

.person-controls label {
  display: flex;
  align-items: center;
  gap: 6px;
  white-space: nowrap;
  }

.remove-person {
  background: #fee2e2;
  color: #b91c1c;
  border: 1px solid #fecaca;
  padding: 6px 9px;
  border-radius: 6px;
  font-size: 12px;
  }

.remove-person:hover {
  background: #fecaca;
  }

  .total-row{
    font-weight:700;
    background:#d9e1f2;
    }

    .total-row td{
    border-top:2px solid #4a6fa5;
    }

    .shift-editor {
  display:grid;
  grid-template-columns:1fr 1fr;
  gap:5px;
  margin-bottom:6px;
}

.shift-editor input[type="time"] {
  min-width:0;
  padding:5px;
  font-size:11px;
}

.shift-edit-actions {
  display:flex;
  flex-wrap:wrap;
  gap:5px;
  justify-content:center;
  margin-bottom:7px;
}

.shift-edit-button {
  padding:5px 8px;
  border:1px solid #bfdbfe;
  background:#eff6ff;
  color:#1d4ed8;
  font-size:11px;
}

.shift-clear-button {
  padding:5px 8px;
  border:1px solid #fecaca;
  background:#fef2f2;
  color:#b91c1c;
  font-size:11px;
}

.add-shift-button {
  padding:6px 9px;
  border:1px solid #bfdbfe;
  background:#eff6ff;
  color:#1d4ed8;
  font-size:11px;
}

.temporary-shift {
  color:#dc2626 !important;
  font-weight:800;
}

.temporary-hours {
  color:#dc2626;
  font-weight:800;
}

.add-row-button {
  margin-top: 10px;
}

.previous-week-dates {
  margin: 2px 0 6px;
  font-size: 15px;
  font-weight: 700;
  color: #1e3a8a;
}

.row-label {
  display: block;
  font-weight: 700;
}

.remove-row-button {
  margin-top: 6px;
  padding: 4px 8px;
  border: 1px solid #fecaca;
  background: #fef2f2;
  color: #b91c1c;
  font-size: 11px;
}

.removed-row td {
  background: #fef2f2;
  color: #7f1d1d;
  text-align: left;
  font-size: 13px;
}

.removed-row .shift-clear-button {
  margin-left: 8px;
}

.post-panel {
  border: 1px solid #e2e8f0;
  border-radius: 12px;
  padding: 16px;
  margin-bottom: 18px;
  background: #f8fafc;
}

.post-panel h3 {
  margin: 0 0 4px;
}

.post-panel p {
  margin: 0 0 12px;
  color: #475569;
  font-size: 14px;
}

/* Links styled like the header's buttons */
.link-button {
  display: inline-block;
  border-radius: 8px;
  padding: 10px 14px;
  font-weight: 700;
  font-size: 13.333px;
  font-family: inherit;
  line-height: normal;
  text-decoration: none;
}

/* "Me" menu in the header: the manager's own schedule and time off */
.me-menu {
  position: relative;
}

.me-menu summary {
  list-style: none;
  cursor: pointer;
  user-select: none;
}

.me-menu summary::-webkit-details-marker {
  display: none;
}

.me-menu-items {
  position: absolute;
  right: 0;
  top: calc(100% + 6px);
  z-index: 40;
  min-width: 250px;
  background: #fff;
  border: 1px solid var(--line);
  border-radius: 10px;
  box-shadow: 0 10px 24px rgba(15, 23, 42, 0.15);
  padding: 6px;
}

.me-menu-items a {
  display: block;
  padding: 9px 12px;
  border-radius: 8px;
  color: var(--navy);
  font-size: 14px;
  font-weight: 600;
  text-decoration: none;
}

.me-menu-items a:hover {
  background: #eef2ff;
}

.time-off-panel {
  border: 1px solid #c7d2fe;
  background: #eef2ff;
  color: #1e1b4b;
  border-radius: 10px;
  padding: 10px 14px;
  margin-bottom: 14px;
  font-size: 13px;
}

.time-off-panel h4 {
  margin: 0 0 6px;
  font-size: 14px;
}

.time-off-panel ul {
  margin: 4px 0 8px;
  padding-left: 20px;
}

.time-off-panel .muted {
  color: #6366f1;
  font-weight: 400;
  font-size: 12px;
}

.build-week-select {
  width: auto;
  min-width: 0;
  display: inline-block;
  margin: 0 6px;
  padding: 4px 8px;
  font-size: 13px;
  font-weight: 700;
}

/* A shift whose assigned person has time off or is outside availability */
td.conflict-cell {
  background: #fef2f2 !important;
  box-shadow: inset 0 0 0 2px #fca5a5;
}

.conflict-note {
  display: block;
  margin-top: 4px;
  color: #b91c1c;
  font-size: 11px;
  font-weight: 700;
}

.rejection-note {
  margin-top: 14px;
  background: #fef2f2;
  border: 1px solid #fecaca;
  color: #7f1d1d;
  border-radius: 8px;
  padding: 10px 14px;
  font-size: 14px;
}

.load-rejected-button {
  margin-left: 6px;
  padding: 4px 9px;
  border: 1px solid #fecaca;
  background: #fff;
  color: #b91c1c;
  font-size: 12px;
}

.schedule-warnings {
  border-radius: 8px;
  padding: 10px 14px;
  margin-bottom: 12px;
  font-size: 13px;
}

.schedule-warnings.has-warnings {
  background: #fffbeb;
  border: 1px solid #fcd34d;
  color: #78350f;
}

.schedule-warnings.no-warnings {
  background: #ecfdf5;
  border: 1px solid #a7f3d0;
  color: #065f46;
}

.schedule-warnings ul {
  margin: 6px 0 0;
  padding-left: 20px;
}

.schedule-warnings li {
  margin: 2px 0;
}

.post-controls {
  display: flex;
  flex-wrap: wrap;
  gap: 10px;
  align-items: center;
}

.post-controls select {
  width: auto;
  min-width: 260px;
  max-width: 100%;
  padding: 9px 10px;
  border: 1px solid #cbd5e1;
  border-radius: 8px;
  font-size: 14px;
}

.post-controls label {
  display: inline;
  margin: 0;
}

#postedWeeksTable {
  margin-top: 14px;
  width: 100%;
  border-collapse: collapse;
  font-size: 13px;
}

#postedWeeksTable th,
#postedWeeksTable td {
  border: 1px solid #e2e8f0;
  padding: 7px 9px;
  text-align: left;
  vertical-align: top;
}

.post-status-live { color: #047857; font-weight: 700; }
.post-status-pending { color: #b45309; font-weight: 700; }
.post-status-rejected { color: #b91c1c; font-weight: 700; }

.temporary-note {
  display:block;
  color:#dc2626;
  font-size:10px;
  font-weight:700;
  margin-top:3px;
}

.unassigned-shift {
  background: #fef9c3 !important;
  border: 2px solid #eab308 !important;
  color: #713f12;
  font-weight: 700;
}

.print-comments {
  margin-top:20px;
  padding:12px;
  border:2px solid #fca5a5;
  background:#fef2f2;
}

.print-comments h3 {
  margin:0 0 8px;
  color:#991b1b;
}

.print-comments ul {
  margin:0;
  padding-left:18px;
}

.print-comments li {
  color:#991b1b;
  margin-bottom:4px;
}

.previous-week-comments {
  margin-top:20px;
  padding:15px;
  border:2px solid #94a3b8;
  background:#f8fafc;
}

.previous-week-comments h3 {
  margin:0 0 10px;
  color:#17365d;
}

.previous-week-comments pre {
  white-space:pre-wrap;
  font-family:inherit;
  margin:0;
}

.actual-compare{
  font-style:italic;
  color:#64748b;
  margin-top:3px;
  font-size:11px;
}

.actual-on-time{
  font-style:italic;
  color:#64748b;
}

.actual-different{
  font-style:italic;
  color:#b45309;
  font-weight:600;
}

.actual-missed{
  font-style:italic;
  color:#b91c1c;
  font-weight:700;
}

#actualShiftTable th:first-child,
#actualShiftTable td:first-child,
#scheduledShiftTable th:first-child,
#scheduledShiftTable td:first-child,
#actualHoursTable th:first-child,
#actualHoursTable td:first-child {
  width:120px;
  min-width:120px;
  text-align:center;
}

#actualShiftTable th:nth-child(2),
#actualShiftTable td:nth-child(2),
#scheduledShiftTable th:nth-child(2),
#scheduledShiftTable td:nth-child(2),
#actualHoursTable th:nth-child(2),
#actualHoursTable td:nth-child(2) {
  width:130px;
  min-width:130px;
  text-align:left;
  font-weight:700;
}

.employee-number-control {
  display:flex;
  align-items:center;
  gap:6px;
  font-size:12px;
  color:#475569;
  font-weight:700;
}

.employee-number-input {
  width:90px;
  min-width:90px;
  padding:6px 8px;
}

#previousWeekComparisonTable .planned-shift {
  display: block;
  font-size: 9px;
}

#previousWeekComparisonTable .actual-shift {
  display: block;
  font-size: 9px;
  font-style: italic;
  color: #64748b;
  margin-top: 1px;
}

#previousWeekComparisonTable th:first-child,
#previousWeekComparisonTable td:first-child {
  width: 60px !important;
  min-width: 60px !important;
  max-width: 60px !important;
  font-size: 9px !important;
  line-height: 1.1;
  padding: 2px !important;
}



.attendance-issue {
  background: #f7a7a7 !important;
}

.attendance-severe {
  background: #ef5a5a !important;
}

.no-time-worked-cell {
  background: #fca5a5 !important;
}

.no-time-worked-cell .actual-shift {
  color: #991b1b !important;
  font-weight: 700;
}

/* Worked on a day they weren't scheduled: "OFF" with the time worked below */
.unscheduled-work-cell {
  background: #fde68a !important;
  -webkit-print-color-adjust: exact;
  print-color-adjust: exact;
}

.unscheduled-work-cell .actual-shift {
  color: #92400e !important;
  font-weight: 700;
}

.attendance-exception-review {
  margin-top:20px;
  display:grid;
  gap:18px;
}

.overtime-approved {
  background:#dcfce7;
  color:#166534;
  font-weight:700;
}

.overtime-over-limit {
  background:#fee2e2;
  color:#991b1b;
  font-weight:700;
}

/*
 * Printable schedule: every shift stays on one line. The text scales with
 * the window so the whole week plus hours and OT columns fit; names, OT
 * status and the adjustments table may wrap.
 */
#printSchedule {
  min-width: 0;
  font-size: clamp(9px, 0.8vw, 13px);
}

#printSchedule th,
#printSchedule td {
  padding: 0.5em 0.45em;
}

#printSchedule .total-row td.overtime-approved { background: #dcfce7; }
#printSchedule .total-row td.overtime-over-limit { background: #fee2e2; }

/* Weekly hours budget: "scheduled / budget" on the total rows */
td.budget-total { white-space: nowrap; }

/* PTO: Build-tab section and the printable schedule's PTO column */
.pto-table { width: 100%; border-collapse: collapse; font-size: 13px; }
.pto-table th, .pto-table td { border: 1px solid #e5e7eb; padding: 6px 8px; text-align: center; vertical-align: middle; }
.pto-table th { background: #f1f5f9; white-space: nowrap; }
.pto-table td.pto-name { text-align: left; font-weight: 600; white-space: nowrap; }
.pto-table td.pto-off { background: #fef3c7; color: #92400e; font-weight: 600; white-space: nowrap; }
.pto-table td.pto-note { text-align: left; color: #475569; font-size: 12px; }
.pto-table input[type="number"] { width: 64px; padding: 4px 6px; margin-top: 4px; }
.pto-table .pto-paid { display: block; margin-top: 4px; font-size: 12px; font-weight: 600; color: #1f2937; cursor: pointer; }
.pto-table .pto-week-total { font-size: 14px; }
.pto-table .pto-status { font-size: 12px; color: #15803d; min-height: 1em; }
.pto-table .pto-status.error { color: #b91c1c; }
td.pto-cell { color: #7c2d12; font-weight: 600; }
td.ot-salaried { color: #475569; font-style: italic; text-align: center; }

/* Previous week: "ready for admin review" email */
.review-ping { display: flex; flex-wrap: wrap; justify-content: space-between; align-items: center; gap: 12px; }
.review-ping h3 { margin: 0 0 4px; }
.review-ping-actions { display: flex; flex-wrap: wrap; align-items: center; gap: 10px; }
.review-ping-status { font-size: 13px; color: #475569; }
.review-ping-status.ok { color: #15803d; font-weight: 600; }
.review-ping-status.error { color: #b91c1c; font-weight: 600; }

/* Previous week: sick days */
.sick-day-controls { display: flex; flex-wrap: wrap; gap: 8px; align-items: center; margin: 6px 0; }
.sick-day-controls select, .sick-day-controls input { padding: 5px 6px; }
.sick-day-controls input { width: 80px; }
.sick-day-status { font-size: 12px; color: #15803d; }
.sick-day-status.error { color: #b91c1c; }
.sick-no-point { font-size: 13px; color: #166534; background: #dcfce7; border-radius: 6px; padding: 6px 10px; margin-top: 6px; }
.sick-marker { display: block; font-size: 11px; font-weight: 700; color: #1d4ed8; }
td.budget-within { background: #dcfce7; }
td.budget-over { background: #fee2e2; color: #991b1b; font-weight: 700; }
td.budget-within, td.budget-over {
  -webkit-print-color-adjust: exact;
  print-color-adjust: exact;
}
.budget-summary { display: grid; gap: 6px; margin-bottom: 10px; }
.budget-summary .over { color: #b91c1c; font-weight: 600; }
.budget-summary .within { color: #15803d; font-weight: 600; }
.budget-controls { display: flex; flex-wrap: wrap; gap: 8px; align-items: center; margin: 8px 0; }
.budget-controls input[type="number"] { width: 110px; padding: 6px 8px; }
.budget-controls select { padding: 6px 8px; max-width: 100%; }
.budget-overrides { margin-top: 10px; border-collapse: collapse; }
.budget-overrides th, .budget-overrides td { padding: 4px 10px; border-bottom: 1px solid #e5e7eb; text-align: left; }
.budget-status { min-height: 1.2em; font-size: 13px; }
.budget-status.error { color: #b91c1c; }

#printSchedule > tbody > tr > td {
  white-space: nowrap;
}

#printSchedule > tbody > tr > td:first-child,
#printSchedule > tbody > tr > td:last-child,
#printSchedule .print-comments,
#printSchedule .print-comments td,
#printSchedule .print-comments th {
  white-space: normal;
}

@media print {
  #printSchedule {
    font-size: 7.5pt;
  }

  #printSchedule th,
  #printSchedule td {
    padding: 3px 3px;
  }
}

.exception-section {
  border:1px solid #cbd5e1;
  border-radius:10px;
  overflow:hidden;
  background:#fff;
}

.exception-section-heading {
  padding:11px 14px;
  background:#e9f0fa;
  color:#17365d;
  font-size:15px;
  font-weight:800;
  border-bottom:1px solid #cbd5e1;
}

.exception-section-heading.absence-heading {
  background:#fee2e2;
  color:#991b1b;
}

.exception-section-heading.both-heading {
  background:#fecaca;
  color:#991b1b;
}

.exception-section-heading.overtime-heading {
  background:#dcfce7;
  color:#166534;
}

.exception-row {
  display:grid;
  grid-template-columns:1fr;
  gap:14px;
  padding:16px 14px;
  border-bottom:1px solid #e2e8f0;
  align-items:start;
}

.exception-description {
  width:100%;
  min-width:0;
}

.exception-row:last-child {
  border-bottom:0;
}

.exception-description {
  color:#334155;
  line-height:1.45;
}

.exception-description strong {
  color:#17365d;
}

.exception-times {
  display:block;
  margin-top:4px;
  color:#64748b;
  font-size:12px;
}

.exception-comment {
  width:100%;
  min-height:66px;
  resize:vertical;
  padding:9px 10px;
  border:1px solid #cbd5e1;
  border-radius:7px;
  font-family:inherit;
  color:#172033;
  background:#fff;
}

.exception-comment:focus {
  border-color:#2f5597;
  outline:none;
  box-shadow:0 0 0 3px rgba(47,85,151,.12);
}

.no-exceptions {
  padding:12px 14px;
  color:#64748b;
  font-style:italic;
}

.overtime-issue {
  background:#dcfce7 !important;
}

.overtime-issue .actual-shift {
  color:#166534 !important;
  font-weight:700;
}

.comparison-cell.attendance-issue.overtime-issue {
  background:#f7a7a7 !important;
  box-shadow:inset 0 -4px 0 #16a34a;
}

.comparison-cell.attendance-severe.overtime-issue {
  background:#ef5a5a !important;
  box-shadow:inset 0 -4px 0 #16a34a;
}

.comparison-cell.no-time-worked-cell.overtime-issue {
  background:#fca5a5 !important;
  box-shadow:inset 0 -4px 0 #16a34a;
}

@media(max-width:900px) {
  .exception-row {
    grid-template-columns:1fr;
  }
}

@media print {
  .attendance-exception-review {
    margin-top:14px;
    gap:10px;
  }

  .exception-section {
    break-inside:avoid;
  }

  .exception-row {
    grid-template-columns:1fr 1.4fr;
    padding:7px;
    font-size:10px;
  }

  .exception-comment {
    min-height:44px;
    font-size:10px;
    border:1px solid #94a3b8;
  }
}

.template-toolbar {
  display:grid;
  grid-template-columns:
    auto minmax(220px, 1fr)
    auto auto auto auto;
  gap:10px;
  align-items:center;
  margin-bottom:18px;
  padding:14px;
  border:1px solid var(--line);
  border-radius:10px;
  background:#f8fafc;
}

.template-toolbar label {
  color:var(--navy);
  font-size:13px;
  font-weight:800;
  white-space:nowrap;
}

.template-toolbar select {
  min-width:220px;
}

@media(max-width:950px) {
  .template-toolbar {
    grid-template-columns:1fr 1fr;
  }

  .template-toolbar label,
  .template-toolbar select {
    grid-column:1 / -1;
  }

  .availability-grid {
  display:grid;
  grid-template-columns:repeat(3,minmax(0,1fr));
  gap:14px;
}

@media(max-width:1100px) {
  .availability-grid {
    grid-template-columns:1fr;
  }
}
}

.point-assignment-controls {
  width:100%;
  min-width:0;

  display:grid;

  grid-template-columns:
    minmax(160px,220px)
    minmax(280px,1fr)
    minmax(320px,420px);

  gap:12px;
  align-items:end;
}

.point-assignment-controls label {
  display:grid;
  grid-template-rows:auto 1fr;
  gap:6px;
  min-width:0;
  margin:0;

  color:#475569;
  font-size:12px;
  font-weight:700;
}

.point-assignment-controls select {
  width:100%;
  min-width:0;
  height:40px;
}

.point-comment-label {
  width:100%;
  min-width:0;
}

.point-comment-label .exception-comment {
  width:100%;
  min-width:0;
  min-height:70px;
  margin:0;
}

.recommend-points-button,
.assign-points-button {
  min-width:140px;
}

.point-action-buttons {
  display:flex;
  gap:10px;
  width:100%;
}

.point-action-buttons button {
  flex:1;
}

.recommend-points-button {
  width:100%;
  min-width:0;
  min-height:40px;
  white-space:nowrap;
  background:#fef3c7;
  color:#92400e;
  border:1px solid #f59e0b;
}

.recommend-points-button:hover:not(:disabled) {
  background:#fde68a;
}

.recommend-points-button.recommendation-saved {
  background:#f59e0b;
  color:#fff;
}

.recommend-points-button:disabled {
  cursor:not-allowed;
  opacity:1;
}

.recommendation-status {
  grid-column:1 / -1;
  min-height:18px;
  color:#92400e;
  font-size:12px;
  font-weight:700;
}

@media(max-width:900px) {
  .point-action-buttons {
    grid-template-columns:1fr;
  }

  .recommendation-status {
    grid-column:1;
  }
}

.assign-points-button {
  width:100%;
  min-width:0;
  min-height:40px;
  white-space:nowrap;
}

.assign-points-button:disabled {
  cursor:not-allowed;
  opacity:1;
}

.assign-points-button.points-assigned {
  background:#15803d;
  color:#fff;
}

.assign-points-button.points-not-assigned {
  background:#64748b;
  color:#fff;
}

.point-assignment-status {
  grid-column:1 / -1;
  min-height:18px;
  font-size:12px;
  font-weight:700;
}

.point-save-success {
  color:#15803d;
}

.point-not-assigned-status {
  color:#475569;
}

.point-save-error {
  color:#b91c1c;
}

.point-assignment-controls.absence-point-controls {
  grid-template-columns:
    minmax(180px, 230px)
    minmax(130px, 170px)
    minmax(320px, 1fr)
    minmax(340px, 420px);
}

.absence-point-controls .point-action-buttons {
  min-width:300px;
}

@media(max-width:1100px) {
  .absence-point-controls .point-action-buttons {
    grid-column:1 / -1;
    min-width:0;
  }
}

.overtime-review-controls {
  display:grid;
  grid-template-columns:
    minmax(280px, 1fr)
    minmax(160px, 210px);
  gap:12px;
  align-items:end;
  width:100%;
  min-width:0;
}

.overtime-comment-label {
  display:grid;
  gap:6px;
  min-width:0;
  color:#475569;
  font-size:12px;
  font-weight:700;
}

.save-overtime-review-button {
  width:100%;
  min-width:0;
  min-height:40px;
  white-space:nowrap;
  background:#166534;
  color:#fff;
}

.save-overtime-review-button:hover:not(:disabled) {
  background:#14532d;
}

.save-overtime-review-button.review-saved {
  background:#15803d;
  color:#fff;
}

.save-overtime-review-button:disabled {
  cursor:not-allowed;
}

.overtime-review-status {
  grid-column:1 / -1;
  min-height:18px;
  color:#166534;
  font-size:12px;
  font-weight:700;
}

@media(max-width:900px) {
  .overtime-review-controls {
    grid-template-columns:1fr;
  }

  .overtime-review-status {
    grid-column:1;
  }
}

@media(max-width:1100px) {
  .point-assignment-controls.absence-point-controls {
    grid-template-columns:
      minmax(180px, 1fr)
      minmax(130px, 1fr);
  }

  .absence-point-controls .point-comment-label {
    grid-column:1 / -1;
  }

  .absence-point-controls .assign-points-button {
    grid-column:1 / -1;
  }

  .absence-point-controls .point-assignment-status {
    grid-column:1 / -1;
  }
}

@media(max-width:700px) {
  .point-assignment-controls.absence-point-controls {
    grid-template-columns:1fr;
  }

  .absence-point-controls .point-comment-label,
  .absence-point-controls .assign-points-button,
  .absence-point-controls .point-assignment-status {
    grid-column:1;
  }
}

@media(max-width:900px) {
  .point-assignment-controls {
    grid-template-columns:1fr;
  }

  .point-assignment-status {
    grid-column:1;
  }
}

.point-history-employee {
  margin-bottom:12px;
  border:1px solid #cbd5e1;
  border-radius:10px;
  overflow:hidden;
  background:#fff;
}

.point-history-employee:last-child {
  margin-bottom:0;
}

.point-history-toggle {
  width:100%;
  display:flex;
  justify-content:space-between;
  align-items:center;
  gap:16px;
  padding:13px 15px;
  border:0;
  border-radius:0;
  background:#e9f0fa;
  color:#17365d;
  text-align:left;
  cursor:pointer;
}

.point-history-toggle:hover {
  background:#dbe7f7;
}

.point-history-toggle[aria-expanded="true"] {
  background:#dbe7f7;
  border-bottom:1px solid #cbd5e1;
}

.point-history-person {
  display:flex;
  align-items:center;
  gap:10px;
  min-width:0;
  font-size:15px;
  font-weight:800;
}

.point-history-arrow {
  display:inline-block;
  width:16px;
  flex:0 0 16px;
  color:#2f5597;
  font-size:12px;
}

.point-history-number {
  display:inline-block;
  margin-left:7px;
  color:#64748b;
  font-size:12px;
  font-weight:700;
}

.point-history-total {
  flex:0 0 auto;
  padding:5px 10px;
  border-radius:999px;
  background:#17365d;
  color:#fff;
  font-size:12px;
  font-weight:800;
}

.point-history-details[hidden] {
  display:none;
}

.point-history-details {
  display:block;
}

.point-history-table-wrap {
  border:0;
  border-radius:0;
}

.point-history-table {
  width:100%;
  min-width:850px;
}

.point-history-table th:first-child,
.point-history-table td:first-child {
  position:static;
  left:auto;
  width:120px;
  min-width:120px;
  background:inherit;
}

.point-history-table th:nth-child(2),
.point-history-table td:nth-child(2) {
  width:170px;
}

.point-history-table th:nth-child(3),
.point-history-table td:nth-child(3) {
  width:90px;
}

.point-history-table th:nth-child(4),
.point-history-table td:nth-child(4) {
  width:170px;
}

.point-history-points {
  color:#b91c1c;
  font-weight:800;
}

.point-history-comment {
  text-align:left;
  white-space:normal;
  line-height:1.4;
}

@media(max-width:700px) {
  .point-history-toggle {
    align-items:flex-start;
  }

  .point-history-number {
    display:block;
    margin-top:3px;
    margin-left:0;
  }
}

.delete-scheduled-shift-button {
  padding:5px 8px;
  border:1px solid #fecaca;
  background:#fee2e2;
  color:#b91c1c;
  font-size:11px;
}

.delete-scheduled-shift-button:hover {
  background:#fecaca;
}

.removed-shift-cell {
  background:#fef2f2 !important;
  border:2px dashed #fca5a5 !important;
}

.removed-shift-label {
  display:block;
  margin-bottom:4px;
  color:#b91c1c;
  font-size:12px;
  font-weight:800;
}

.removed-shift-original {
  display:block;
  margin-bottom:4px;
  color:#7f1d1d;
  font-size:11px;
  text-decoration:line-through;
}

.removed-shift-reason {
  display:block;
  margin-bottom:8px;
  color:#991b1b;
  font-size:10px;
  font-weight:700;
  white-space:normal;
}

/* Force equal-width day columns */
#previousWeekComparisonTable {
  table-layout: fixed !important;
}

/* Employee column */
#previousWeekComparisonTable th:first-child,
#previousWeekComparisonTable td:first-child {
  width: 50px !important;
  min-width: 50px !important;
  max-width: 70px !important;
  font-size: 9px !important;
  line-height: 1.1;
  padding: 2px !important;
}


/* Monday through Sunday */
#previousWeekComparisonTable th:nth-child(n+2):nth-child(-n+8),
#previousWeekComparisonTable td:nth-child(n+2):nth-child(-n+8) {
  width: 72px !important;
  min-width: 72px !important;
  max-width: 72px !important;
}

/* Scheduled / Worked columns */
#previousWeekComparisonTable th:nth-last-child(5),
#previousWeekComparisonTable td:nth-last-child(5),
#previousWeekComparisonTable th:nth-last-child(4),
#previousWeekComparisonTable td:nth-last-child(4) {
  width: 40px !important;
  min-width: 40px !important;
  font-size: 9px !important;
}

/* Delta column */
#previousWeekComparisonTable th:nth-last-child(3),
#previousWeekComparisonTable td:nth-last-child(3) {
  width: 38px !important;
  min-width: 38px !important;
  font-size: 9px !important;
}

/* Planned OT column */
#previousWeekComparisonTable th:nth-last-child(2),
#previousWeekComparisonTable td:nth-last-child(2) {
  width: 35px !important;
  min-width: 35px !important;
  font-size: 9px !important;
}

/* Paid OT */
#previousWeekComparisonTable th:last-child,
#previousWeekComparisonTable td:last-child {
  width: 35px !important;
  min-width: 35px !important;
  font-size: 9px !important;
}

#previousWeekComparisonTable th:first-child {
  background: #e9f0fa !important;
  color: #17365d !important;
}

#previousWeekComparisonTable .total-row td {
  font-size: 9px !important;
}

#previousWeekComparisonTable .total-row .metric {
  font-size: 9px !important;
}

#previousWeekComparisonTable .total-row div {
  font-size: 9px !important;
  line-height: 1.15;
}


  </style>
</head>
<body>
<% const incoming = (typeof scheduleData !== 'undefined' && scheduleData) ? scheduleData : {}; %>
<div class="page-shell">
  <header class="topbar">
    <div>
      <h1><%= storeName %> Weekly Scheduling Center</h1>
      <p>Build next week, compare hours, print the schedule, and review prior-week attendance.</p>
    </div>
    <div class="actions no-print">
      <button type="button" class="secondary" id="backToStoreMapBtn">
        ← Back to Store Map
      </button>
      
      <button
  class="secondary"
  type="button"
  onclick="printWeeklySchedule()"
>
  Print weekly schedule
</button>

      <a class="secondary link-button" href="/time-off-requests">
        Time off requests<%= pendingTimeOffCount ? ` (${pendingTimeOffCount})` : '' %>
      </a>

      <a class="secondary link-button" href="/posted-schedules?store=<%= encodeURIComponent(storeName) %>">
        Posted schedules
      </a>

      <% if (user && user.role === 'manager') { %>
        <details class="me-menu">
          <summary class="secondary link-button">Me ▾</summary>
          <div class="me-menu-items">
            <a href="<%= myScheduleUrl %>">📅 My schedule</a>
            <a href="/time-off">🗓 My time off &amp; availability</a>
          </div>
        </details>
      <% } %>
    </div>
  </header>

  <nav class="module-tabs no-print" aria-label="Schedule modules">
    <button class="active" data-module="module-1">1. Build Schedule</button>
    <button data-module="module-2">2. Hours Matrix</button>
    <button data-module="module-3">3. Printable Schedule</button>
    <button data-module="module-4">4. Attendance</button>
    <button data-module="module-5">5. Previous Week</button>
  </nav>

  <!-- MODULE 1, SECTION 1 -->
  <section class="module active" id="module-1">
    <div class="module-card">
      <div class="module-heading"><h2>Module 1: Build Next Week's Schedule</h2><p>Three sections for manager coverage, associate shifts, and availability.</p></div>
      <div class="section">
        <div class="template-toolbar no-print">

  <label for="templateSelector">
    Schedule Template
  </label>

  <select id="templateSelector">
    <option value="">
      Select a template
    </option>
  </select>


  <button
    type="button"
    class="secondary"
    id="loadTemplateBtn"
  >
    Load Template
  </button>

  <button
    type="button"
    class="secondary"
    id="saveTemplateBtn"
  >
    Save As Template
  </button>

  <button
    type="button"
    class="secondary"
    id="newTemplateBtn"
  >
    New Template
  </button>

  <button
    type="button"
    class="remove-person"
    id="deleteTemplateBtn"
  >
    Delete Template
  </button>

</div>
        <div id="timeOffPanel" class="time-off-panel"></div>
        <div id="buildWarnings" class="schedule-warnings"></div>
        <div class="section-title"><div><h3>Section 1 of 8: Manager Hours and Assignment</h3><small>Preset coverage windows for <%= storeName %>. Add or remove rows as needed.</small></div></div>
        <div class="table-wrap"><table id="managerTable"><thead><tr><th>Manager coverage</th><th>Monday</th><th>Tuesday</th><th>Wednesday</th><th>Thursday</th><th>Friday</th><th>Saturday</th><th>Sunday</th></tr></thead><tbody></tbody></table></div>
        <button type="button" class="secondary add-row-button no-print" onclick="addCoverageRow('manager')">+ Add manager row</button>
      </div>

      <!-- MODULE 1, SECTION 2 -->
      <div class="section">
        <div class="section-title"><div><h3>Section 2 of 8: Associate Shift Assignment</h3><small>Assign each recurring coverage shift to an available associate.</small></div></div>
        <div class="table-wrap"><table id="associateTable"><thead><tr><th>Associate shift</th><th>Monday</th><th>Tuesday</th><th>Wednesday</th><th>Thursday</th><th>Friday</th><th>Saturday</th><th>Sunday</th></tr></thead><tbody></tbody></table></div>
        <button type="button" class="secondary add-row-button no-print" onclick="addCoverageRow('associate')">+ Add associate row</button>
      </div>

<% if (scheduleSetup.hasCashiers) { %>
      <div class="section">
  <div class="section-title">
    <div>
      <h3>Cashier Shift Assignment</h3>

      <small>
        Assign cashier coverage to an available cashier,
        associate, or manager.
      </small>
    </div>
  </div>

  <div class="table-wrap">
    <table id="cashierTable">
      <thead>
        <tr>
          <th>Cashier shift</th>
          <th>Monday</th>
          <th>Tuesday</th>
          <th>Wednesday</th>
          <th>Thursday</th>
          <th>Friday</th>
          <th>Saturday</th>
          <th>Sunday</th>
        </tr>
      </thead>

      <tbody></tbody>
    </table>
  </div>
  <button type="button" class="secondary add-row-button no-print" onclick="addCoverageRow('cashier')">+ Add cashier row</button>
</div>
<% } %>

      <!-- MODULE 1, SECTION 3 -->
      <div class="section">
        <div class="section-title"><div><h3>Section 3 of 8: Available Employees</h3><small>Turn managers and associates on or off for next week's assignment lists. AOT Stands for Approved Overtime</small></div></div>
        <div class="availability-grid">
  <div class="people-box">
    <h4>Managers</h4>
    <div id="managerAvailability"></div>

    <button
      class="secondary"
      type="button"
      onclick="addEmployee('manager')"
    >
      Add manager
    </button>
  </div>

  <div class="people-box">
    <h4>Associates</h4>
    <div id="associateAvailability"></div>

    <button
      class="secondary"
      type="button"
      onclick="addEmployee('associate')"
    >
      Add associate
    </button>
  </div>

<% if (scheduleSetup.hasCashiers) { %>
  <div class="people-box">
    <h4>Cashiers</h4>
    <div id="cashierAvailability"></div>

    <button
      class="secondary"
      type="button"
      onclick="addEmployee('cashier')"
    >
      Add cashier
    </button>
  </div>
<% } %>
</div>
      </div>

      <!-- MODULE 1: PAID TIME OFF -->
      <div class="section" id="ptoSection">
        <div class="section-title">
          <div>
            <h3>Paid Time Off (PTO)</h3>
            <small>
              Approved time off for the week being scheduled. Tick <strong>Paid</strong> for each paid
              day off (8 hours by default; change it if needed). Paid hours show in the printable
              schedule's PTO column and count toward total hours and the hours budget, not overtime.
            </small>
          </div>
        </div>
        <div id="ptoPanel"><span class="muted">Loading time off…</span></div>
      </div>

      <!-- MODULE 1: WEEKLY HOURS BUDGET -->
      <div class="section" id="hoursBudgetSection">
        <div class="section-title">
          <div>
            <h3>Weekly Hours Budget</h3>
            <small>
              Shown on the total row of the printable schedule (scheduled / budget)
              and the previous week (worked / budget).
              <%= user && user.role === 'admin' ? 'Each week uses the store default unless it has its own budget.' : 'Set by admins.' %>
            </small>
          </div>
        </div>
        <div id="hoursBudgetSummary" class="budget-summary"></div>
        <div id="hoursBudgetControls"></div>
      </div>
    </div>
  </section>

  <!-- MODULE 2, SECTION 4 -->
  <section class="module" id="module-2">
    <div class="module-card">
      <div class="module-heading"><h2>Module 2: Scheduled Hours by Employee</h2><p>Daily assigned hours are calculated from the selected shifts.</p></div>
      <div class="section">
        <div class="section-title"><div><h3>Section 4 of 8: Employee Hours Matrix</h3><small>Employees across the top, weekdays down the left, totals on the right and bottom.</small></div></div>
        <div class="table-wrap"><table id="hoursMatrix"></table></div>
      </div>
    </div>
  </section>

  <!-- MODULE 3, SECTION 5 -->
  <section class="module" id="module-3">
    <div class="module-card">
      <div class="module-heading"><h2>Module 3: Printable Weekly Schedule</h2><p>A clean employee-by-day schedule modeled on the bottom table in the PDF.</p></div>
      <div class="section no-print">
        <div class="post-panel">
          <h3>Post this schedule for employees</h3>
          <p>
            Submits the schedule below for the week you choose. An admin has to
            approve it before employees can see it. Employees see shift times only,
            not the adjustment reasons.
          </p>

          <div id="scheduleWarnings" class="schedule-warnings"></div>

          <div class="post-controls">
            <label for="postWeekSelect">Week</label>
            <select id="postWeekSelect"></select>
            <button type="button" class="primary" id="postScheduleBtn">
              Submit for approval
            </button>
          </div>

          <table id="postedWeeksTable"></table>
        </div>
      </div>
      <div class="section print-sheet">
        <div class="no-print-note">Use the Print button above. Printing is set to landscape and only this schedule is included.</div>
        <h2><%= storeName %> Weekly Schedule</h2>

<div class="period" id="printPeriod">
  Next week
</div>

<div
  id="printTemplateName"
  style="
    text-align:center;
    color:#64748b;
    font-size:14px;
    margin-bottom:16px;
  "
></div>
        <div class="table-wrap"><table id="printSchedule"></table></div>
        <div id="rejectionNote" class="rejection-note no-print" hidden></div>
      </div>
    </div>
  </section>

  <!-- MODULE 4, SECTION 6 -->
  <section class="module" id="module-4">
    <div class="module-card">
      <div class="module-heading"><h2>Module 4: Attendance Review</h2><p>Upload or enter absence, tardy, and early-leave counts.</p></div>
