            'absence',
            employeeNumber,
            infractionDate
          ),

          type: 'absence',

          summary:
            `${buildName} had no time worked ` +
            `for a scheduled ${dayIndex >= 0
              ? DAYS[dayIndex]
              : day} shift.`
        });

        /*
         * Do not calculate lateness, early departure,
         * or overtime when no actual shift exists.
         */
        return;
      }

      if (
        plannedValues.length > 0 &&
        actualValues.length > 0
      ) {
        const scheduledParts =
          plannedValues[0].split(' to ');

        const actualParts =
          actualValues[0].split(' to ');

        if (
          scheduledParts.length === 2 &&
          actualParts.length === 2
        ) {
          const scheduledStart =
            parseTime(
              scheduledParts[0]
            );

          const scheduledEnd =
            parseTime(
              scheduledParts[1]
            );

          const actualStart =
            parseTime(
              actualParts[0]
            );

          const actualEnd =
            parseTime(
              actualParts[1]
            );

          if (
            scheduledStart != null &&
            scheduledEnd != null &&
            actualStart != null &&
            actualEnd != null
          ) {
            const lateMinutes =
              minutesBetween(
                scheduledStart,
                actualStart
              );

            const earlyMinutes =
              minutesBetween(
                actualEnd,
                scheduledEnd
              );

            const arrivedLate =
              lateMinutes > 15;

            const leftEarly =
              earlyMinutes > 15;

            if (
              arrivedLate &&
              leftEarly
            ) {
              exceptions.both.push({
                ...baseRecord,

                id: createExceptionId(
                  'both',
                  employeeNumber,
                  infractionDate
                ),

                type: 'both',
                lateMinutes,
                earlyMinutes,

                summary:
                  `${buildName} arrived ` +
                  `${lateMinutes} minutes late and ` +
                  `left ${earlyMinutes} minutes early ` +
                  `on ${DAYS[dayIndex]}.`
              });
            } else if (arrivedLate) {
              exceptions.late.push({
                ...baseRecord,

                id: createExceptionId(
                  'late',
                  employeeNumber,
                  infractionDate
                ),

                type: 'late',
                lateMinutes,

                summary:
                  `${buildName} arrived ` +
                  `${lateMinutes} minutes late ` +
                  `on ${DAYS[dayIndex]}.`
              });
            } else if (leftEarly) {
              exceptions.early.push({
                ...baseRecord,

                id: createExceptionId(
                  'early',
                  employeeNumber,
                  infractionDate
                ),

                type: 'early',
                earlyMinutes,

                summary:
                  `${buildName} left ` +
                  `${earlyMinutes} minutes early ` +
                  `on ${DAYS[dayIndex]}.`
              });
            }
          }
        }
      }

      /*
       * Overtime threshold:
       * actual hours are at least 0.50 hours
       * greater than scheduled paid hours.
       */
      const overtimeHours =
        actualDayHours -
        scheduledDayHours;

      if (
        scheduledDayHours > 0 &&
        actualDayHours >=
          scheduledDayHours + 0.5
      ) {
        exceptions.overtime.push({
          ...baseRecord,

          id: createExceptionId(
            'overtime',
            employeeNumber,
            infractionDate
          ),

          type: 'overtime',
          overtimeHours,

          summary:
            `${buildName} worked ` +
            `${overtimeHours.toFixed(2)} hours ` +
            `over the scheduled hours on ` +
            `${DAYS[dayIndex]}.`
        });
      }
    });
  });

  return exceptions;
}

function buildExceptionTimesHtml(item) {
  const scheduledText =
    item.plannedValues.length
      ? item.plannedValues.join(', ')
      : 'None';

  const actualText =
    item.actualValues.length
      ? item.actualValues.join(', ')
      : 'No time worked';

  let hoursText = '';

  if (item.type === 'overtime') {
    hoursText =
      `<br>Scheduled hours: ` +
      `${item.scheduledDayHours.toFixed(2)}` +
      ` | Actual hours: ` +
      `${item.actualDayHours.toFixed(2)}`;
  }

  return `
    <span class="exception-times">
      Scheduled: ${escapeHtml(scheduledText)}
      <br>
      Actual: ${escapeHtml(actualText)}
      ${hoursText}
    </span>
  `;
}

function buildOvertimeReviewControls(item) {
  const sourceExceptionId =
    buildOvertimeSourceExceptionId(item);

  const savedReview =
    existingOvertimeReviews[
      sourceExceptionId
    ] || null;

  const savedExplanation =
    savedReview?.explanation ||
    attendanceExceptionComments[
      item.id
    ] ||
    '';

  let buttonText =
    'Save Overtime Explanation';

  let buttonClass = '';

  if (savedReview) {
    buttonText =
      'Update Overtime Explanation';

    buttonClass =
      'review-saved';
  }

  let statusText = '';

  if (savedReview) {
    const reviewDateValue =
      savedReview.updatedAt ||
      savedReview.createdAt;

    const reviewDate =
      reviewDateValue
        ? new Date(
            reviewDateValue
          ).toLocaleString()
        : 'an earlier date';

    statusText =
      `Explanation saved on ${reviewDate}.`;

    if (savedReview.reviewedByName) {
      statusText +=
        ` Reviewed by ` +
        `${savedReview.reviewedByName}.`;
    }
  }

  return `
    <div
      class="overtime-review-controls"
      data-overtime-panel="${escapeHtml(item.id)}"
    >
      <label class="overtime-comment-label">
        Manager overtime explanation

        <textarea
          class="exception-comment overtime-explanation"
          data-exception-id="${escapeHtml(item.id)}"
          placeholder="Explain why the employee worked at least 30 minutes over schedule..."
        >${escapeHtml(savedExplanation)}</textarea>
      </label>

      <button
        type="button"
        class="
          save-overtime-review-button
          ${buttonClass}
        "
        data-save-overtime-id="${escapeHtml(item.id)}"
      >
        ${buttonText}
      </button>

      <div
        class="overtime-review-status"
        data-overtime-status="${escapeHtml(item.id)}"
      >
        ${escapeHtml(statusText)}
      </div>
    </div>
  `;
}

function renderExceptionSection(
  title,
  headingClass,
  items
) {
  if (!items.length) {
    return '';
  }

  return `
    <div class="exception-section">
      <div
        class="exception-section-heading ${
          escapeHtml(headingClass)
        }"
      >
        ${escapeHtml(title)}
        (${items.length})
      </div>

      ${items.map(item => `
        <div class="exception-row">

          <div class="exception-description">
            <strong>
              ${escapeHtml(item.summary)}
            </strong>

            ${buildExceptionTimesHtml(item)}
          </div>

          ${
            item.type === 'overtime'
              ? buildOvertimeReviewControls(item)
              : item.type === 'absence'
                ? buildAbsenceControls(item)
                : buildPointAssignmentControls(item)
          }

        </div>
      `).join('')}

    </div>
  `;
}

function renderAttendanceExceptionReview(
  exceptions
) {
  const container =
    document.getElementById(
      'attendanceExceptionReview'
    );

  if (!container) {
    return;
  }

  const totalExceptions =
    exceptions.late.length +
    exceptions.early.length +
    exceptions.both.length +
    exceptions.absence.length +
    exceptions.overtime.length;

  if (totalExceptions === 0) {
    container.innerHTML = `
      <div class="exception-section">
        <div class="exception-section-heading">
          Attendance and Labor Exceptions
        </div>

        <div class="no-exceptions">
          No attendance or overtime exceptions
          were detected for the previous week.
        </div>
      </div>
