  if (!response.ok) {
    throw new Error(
      result.error ||
      'Existing attendance points could not be loaded.'
    );
  }

  const pointRecords =
    Array.isArray(result.pointRecords)
      ? result.pointRecords
      : [];

  existingAttendancePoints =
    Object.fromEntries(
      pointRecords
        .filter(record =>
          record &&
          record.sourceExceptionId &&
          record.voided !== true
        )
        .map(record => [
          record.sourceExceptionId,
          record
        ])
    );

  attendancePointsLoaded = true;

  renderPrevious();
}

async function loadExistingPointRecommendations() {
  const parameters =
    new URLSearchParams({
      store: state.store,
      includeAll: 'true'
    });

  const response = await fetch(
    `/api/attendance-point-recommendations?` +
    `${parameters.toString()}`,
    {
      method: 'GET',

      credentials: 'same-origin',

      headers: {
        Accept: 'application/json'
      }
    }
  );

  const responseText =
    await response.text();

  let result = {};

  try {
    result = responseText
      ? JSON.parse(responseText)
      : {};
  } catch (parseError) {
    throw new Error(
      `Point recommendations returned HTTP ` +
      `${response.status}. The server returned ` +
      `a non-JSON response.`
    );
  }

  if (!response.ok) {
    throw new Error(
      result.error ||
      'Point recommendations could not be loaded.'
    );
  }

  const recommendations =
    Array.isArray(result.recommendations)
      ? result.recommendations
      : [];

  existingPointRecommendations =
    Object.fromEntries(
      recommendations
        .filter(recommendation =>
          recommendation &&
          recommendation.sourceExceptionId
        )
        .map(recommendation => [
          recommendation.sourceExceptionId,
          recommendation
        ])
    );

  pointRecommendationsLoaded = true;
}


function buildPointAssignmentControls(item) {
  const defaultInfractionType =
    apiInfractionType(item.type);

  const possibleSourceExceptionIds = [
    buildSourceExceptionId(
      item,
      defaultInfractionType
    )
  ];

  /*
   * Absences may be classified as either a normal
   * absence or a no-call/no-show.
   */
  if (item.type === 'absence') {
    possibleSourceExceptionIds.push(
      buildSourceExceptionId(
        item,
        'absence'
      )
    );

    possibleSourceExceptionIds.push(
      buildSourceExceptionId(
        item,
        'no_call_no_show'
      )
    );
  }

  const sourceExceptionIds = [
    ...new Set(
      possibleSourceExceptionIds.filter(Boolean)
    )
  ];

  const savedPointRecord =
    sourceExceptionIds
      .map(sourceExceptionId =>
        existingAttendancePoints[
          sourceExceptionId
        ]
      )
      .find(Boolean) ||
    null;

  const savedRecommendation =
    sourceExceptionIds
      .map(sourceExceptionId =>
        existingPointRecommendations[
          sourceExceptionId
        ]
      )
      .find(Boolean) ||
    null;

  const pointsAssigned =
    Boolean(savedPointRecord);

  const recommendationSaved =
    Boolean(savedRecommendation);

  const savedInfractionType =
    savedPointRecord?.infractionType ||
    savedRecommendation?.infractionType ||
    defaultInfractionType;

  const selectedPointValue =
    pointsAssigned
      ? Number(
          savedPointRecord.points || 0
        )
      : recommendationSaved
        ? Number(
            savedRecommendation.recommendedPoints || 0
          )
        : defaultPointsForException(
            savedInfractionType
          );

  const optionValues = [
    ...new Set([
      ...getPointOptions(
        savedInfractionType
      ),
      selectedPointValue
    ])
  ].sort((first, second) =>
    first - second
  );

  const options =
    optionValues
      .map(value => `
        <option
          value="${value}"
          ${
            value === selectedPointValue
              ? 'selected'
              : ''
          }
        >
          ${value} point${value === 1 ? '' : 's'}
        </option>
      `)
      .join('');

  const savedComment =
    savedPointRecord?.managerComment ||
    savedRecommendation?.managerComment ||
    attendanceExceptionComments[
      item.id
    ] ||
    '';

  const pointsWereAssigned =
    pointsAssigned &&
    Number(savedPointRecord.points) > 0;

  let recommendationButtonText =
    'Save Recommendation';

  let recommendationButtonClass = '';

  if (
    recommendationSaved &&
    !pointsAssigned
  ) {
    recommendationButtonText =
      'Update Recommendation';

    recommendationButtonClass =
      'recommendation-saved';
  }

  if (pointsAssigned) {
    recommendationButtonText =
      'Recommendation Complete';

    recommendationButtonClass =
      'recommendation-saved';
  }

  let assignmentButtonText =
    !recommendationSaved
      ? 'Save Recommendation First'
      : IS_ADMIN
        ? 'Assign Recommended Points'
        : 'Waiting for Admin to Assign';

  let assignmentButtonClass = '';

  if (pointsAssigned) {
    if (pointsWereAssigned) {
      assignmentButtonText =
        'Points Assigned';

      assignmentButtonClass =
        'points-assigned';
    } else {
      assignmentButtonText =
        'Points Not Assigned';

      assignmentButtonClass =
        'points-not-assigned';
    }
  }

  const controlDisabledAttribute =
    pointsAssigned
      ? 'disabled'
      : '';

  const recommendationButtonDisabled =
    pointsAssigned
      ? 'disabled'
      : '';

  const assignmentButtonDisabled =
    pointsAssigned ||
    !recommendationSaved ||
    !IS_ADMIN
      ? 'disabled'
      : '';

  let recommendationStatus = '';

  if (recommendationSaved) {
    const recommendationDateValue =
      savedRecommendation.updatedAt ||
      savedRecommendation.createdAt;

    const recommendationDate =
      recommendationDateValue
        ? new Date(
            recommendationDateValue
          ).toLocaleString()
        : 'an earlier date';

    const recommendedPoints =
      Number(
        savedRecommendation.recommendedPoints || 0
      );

    recommendationStatus =
      `${recommendedPoints} point${
        recommendedPoints === 1
          ? ''
          : 's'
      } recommended on ` +
      `${recommendationDate}.`;

    const recommendedBy =
      String(
        savedRecommendation.recommendedByName ||
        ''
      ).trim();

    if (recommendedBy) {
      recommendationStatus +=
        ` Recommended by ${recommendedBy}.`;
    }
  }

  let assignedStatus = '';

  if (pointsAssigned) {
    const assignedDate =
      savedPointRecord.createdAt
        ? new Date(
            savedPointRecord.createdAt
          ).toLocaleString()
        : 'an earlier date';

    if (pointsWereAssigned) {
      const assignedPoints =
        Number(
          savedPointRecord.points
        );

      assignedStatus =
        `${assignedPoints} point${
          assignedPoints === 1
            ? ''
            : 's'
        } assigned on ${assignedDate}.`;
    } else {
      assignedStatus =
        `No points were assigned. ` +
        `The final decision was recorded ` +
        `on ${assignedDate}.`;
    }

    const assignedBy =
      String(
        savedPointRecord.assignedByName ||
        ''
      ).trim();

    if (assignedBy) {
      assignedStatus +=
        ` Assigned by ${assignedBy}.`;
