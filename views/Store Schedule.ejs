// The schedule employees will see (each employee's shifts by day, grouped
// by role), plus what the admin reviewing it needs, matching the printable
// schedule: which shifts changed this week, daily/weekly hours, overtime,
// and the adjustment list with reasons. Employees are kept in the same
// order as the printable schedule.
function buildPostSnapshot() {
  const data = gatherScheduled();
  const groups = { manager: [], associate: [], cashier: [] };

  Object.keys(data)
    .filter(name => DAY_KEYS.some(day => data[name][day].shifts.length) || ptoHoursFor(name) > 0)
    .forEach(name => {
      const type = getEmployeeRole(name).toLowerCase() || 'associate';

      const totalHours = DAY_KEYS.reduce(
        (sum, day) => sum + data[name][day].hours,
        0
      );

      const employeeNumber = String(
        state.buildEmployeeIdentifiers?.[name] || ''
      ).trim();

      const overtime = calculateOvertimeApproval(
        employeeNumber,
        totalHours
      );

      groups[type].push({
        name,
        // Lets the employee page find a linked employee's own row
        employeeNumber,
        days: Object.fromEntries(
          DAY_KEYS.map(day => [
            day,
            data[name][day].shifts.map(shift => shift.text)
          ])
        ),
        changed: Object.fromEntries(
          DAY_KEYS.map(day => [
            day,
            data[name][day].shifts.map(shift => Boolean(shift.modified))
          ])
        ),
        hours: Object.fromEntries(
          DAY_KEYS.map(day => [day, data[name][day].hours])
        ),
        totalHours: Number(totalHours.toFixed(2)),
        // Paid time off for the week: in total hours, not overtime
        ptoHours: ptoHoursFor(name),
        salaried: isSalaried(employeeNumber),
        paidOvertimeHours: Number(paidOvertimeFor(employeeNumber, totalHours).toFixed(2)),
        approvedOvertimeHours: overtime.approvedOvertimeHours,
        withinApproval: overtime.withinApproval,
        unapprovedOvertimeHours: overtime.unapprovedOvertimeHours
      });
    });

  return {
    templateName: state.currentTemplateName || '',
    groups: Object.entries(groups)
      .filter(([, employees]) => employees.length)
      .map(([type, employees]) => ({ type, employees })),
    adjustments: generateScheduleComments().map(item => ({
      day: item.day,
      shift: item.shift,
      details: item.details,
      reason: item.reason
    }))
  };
}

/*
 * Checks for common scheduling problems before a week is submitted.
 * They warn rather than block: submitting anyway needs a reason, which the
 * admin sees with the warnings on the approval page.
 */
const MIN_REST_HOURS = 8;

// { start, end } in hours from midnight; end > start (overnight adds 24)
function shiftRange(shiftText) {
  if (!shiftText || !shiftText.includes(' to ')) return null;
  const [start, end] = shiftText.split(' to ').map(parseTime);
  if (start == null || end == null) return null;
  return { start, end: end <= start ? end + 24 : end };
}

function formatGap(hours) {
  const whole = Math.floor(hours);
  const minutes = Math.round((hours - whole) * 60);
  return minutes ? `${whole}h ${minutes}m` : `${whole}h`;
}

function checkScheduleWarnings() {
  const warnings = [];
  const add = (type, message) => warnings.push({ type, message });
  const data = gatherScheduled();

  const coverageGroups = [
    { type: 'manager', coverage: managerCoverage },
    { type: 'associate', coverage: associateCoverage },
    { type: 'cashier', coverage: cashierCoverage }
  ];

  // Per day: whether any shift / any manager shift is assigned, and the
  // shifts nobody is assigned to
  const dayHasShift = {};
  const dayHasManager = {};
  const unassigned = [];

  coverageGroups.forEach(group => {
    Object.entries(group.coverage).forEach(([shiftId, row]) => {
      DAY_KEYS.forEach((day, index) => {
        const shift = getEffectiveShift(group.type, shiftId, day, row[day] || '');
        if (!shift) return;

        const name = getAssignment(group.type, shiftId, day);

        if (!name) {
          unassigned.push(`${DAYS[index]} ${row.label || shiftId} (${shift})`);
          return;
        }

        dayHasShift[day] = true;
        if (group.type === 'manager') dayHasManager[day] = true;

        if (state.availability[name] === false) {
          add('unavailable', `${name} is assigned on ${DAYS[index]} (${shift}) but is marked unavailable.`);
        }

        timeOffWarningsFor(name, day, index, shift)
          .forEach(warning => add(warning.type, warning.message));
      });
    });
  });

  DAY_KEYS.forEach((day, index) => {
    if (dayHasShift[day] && !dayHasManager[day]) {
      add('no-manager', `No manager is scheduled on ${DAYS[index]}.`);
    }
  });

  if (unassigned.length) {
    add(
      'unassigned',
      `${unassigned.length} shift${unassigned.length === 1 ? ' has' : 's have'} no one assigned: ` +
      unassigned.slice(0, 6).join('; ') +
      (unassigned.length > 6 ? `; and ${unassigned.length - 6} more` : '') + '.'
    );
  }

  Object.keys(data).forEach(name => {
    const ranges = DAY_KEYS.map(day =>
      data[name][day].shifts
        .map(shift => ({ text: shift.text, ...shiftRange(shift.text) }))
        .filter(range => range.start !== undefined)
        .sort((a, b) => a.start - b.start)
    );

    ranges.forEach((dayRanges, index) => {
      // Overlapping shifts on the same day
      for (let i = 1; i < dayRanges.length; i++) {
        if (dayRanges[i].start < dayRanges[i - 1].end) {
          add('double-booked', `${name} is double-booked on ${DAYS[index]}: ${dayRanges[i - 1].text} and ${dayRanges[i].text}.`);
        }
      }

      // Rest between the last shift of this day and the first of the next
      const next = ranges[index + 1];
      if (dayRanges.length && next && next.length) {
        const lastEnd = Math.max(...dayRanges.map(range => range.end));
        const gap = next[0].start + 24 - lastEnd;

        if (gap < MIN_REST_HOURS) {
          add(
            'short-rest',
            `${name} has only ${formatGap(Math.max(gap, 0))} between ${DAYS[index]} ` +
            `(ends ${dayRanges.find(range => range.end === lastEnd).text.split(' to ')[1]}) and ` +
            `${DAYS[index + 1]} (starts ${next[0].text.split(' to ')[0]}).`
          );
        }
      }
    });

    if (DAY_KEYS.every(day => data[name][day].shifts.length)) {
      add('no-day-off', `${name} is scheduled all 7 days with no day off.`);
    }

    const totalHours = DAY_KEYS.reduce((sum, day) => sum + data[name][day].hours, 0);
    const overtime = calculateOvertimeApproval(
      String(state.buildEmployeeIdentifiers?.[name] || '').trim(),
      totalHours
    );

    if (!overtime.withinApproval) {
      add(
        'overtime',
        `${name} is ${overtime.unapprovedOvertimeHours.toFixed(2)} hours over approved overtime ` +
        `(${totalHours.toFixed(2)} scheduled, ${overtime.approvedWeeklyHours.toFixed(2)} approved).`
      );
    }
  });

  return warnings;
}

/*
 * Rejected weeks: the page's full working state is sent with every
 * submission, so a rejected week can be loaded back exactly as submitted,
 * fixed and resubmitted. While fixing it, the rejection reason is shown
 * below the schedule and goes along with the resubmission.
 */
let loadedRejection = null;

function captureBuilderState() {
  return {
    managerCoverage: cloneTemplateData(managerCoverage),
    associateCoverage: cloneTemplateData(associateCoverage),
    cashierCoverage: cloneTemplateData(cashierCoverage),
    assignments: cloneTemplateData(state.assignments),
    temporaryShifts: cloneTemplateData(temporaryShifts),
    temporaryShiftNotes: cloneTemplateData(temporaryShiftNotes),
    deletedShiftAssignments: cloneTemplateData(deletedShiftAssignments),
    addedRows: cloneTemplateData(addedRows),
    removedRows: cloneTemplateData(removedRows),
    currentTemplateName: state.currentTemplateName || ''
  };
}

function restoreBuilderState(saved) {
  buildingNewTemplate = false;

  replaceObjectContents(managerCoverage, saved.managerCoverage || {});
  replaceObjectContents(associateCoverage, saved.associateCoverage || {});
  replaceObjectContents(cashierCoverage, saved.cashierCoverage || {});
  replaceObjectContents(state.assignments, saved.assignments || {});
  replaceObjectContents(temporaryShifts, saved.temporaryShifts || {});
  replaceObjectContents(temporaryShiftNotes, saved.temporaryShiftNotes || {});
  replaceObjectContents(deletedShiftAssignments, saved.deletedShiftAssignments || {});
  replaceObjectContents(addedRows, saved.addedRows || {});
  replaceObjectContents(removedRows, saved.removedRows || {});
  state.currentTemplateName = saved.currentTemplateName || '';

  const selector = document.getElementById('templateSelector');
  if (selector) selector.value = '';

  renderAllTables();
}

function renderRejectionNote() {
  const note = document.getElementById('rejectionNote');
  if (!note) return;

  if (!loadedRejection) {
    note.hidden = true;
    note.innerHTML = '';
    return;
  }

  const when = loadedRejection.rejectedAt
    ? new Date(loadedRejection.rejectedAt).toLocaleString('en-US', { dateStyle: 'medium', timeStyle: 'short' })
    : '';

  note.hidden = false;
  note.innerHTML = `
    <strong>Rejected</strong> by ${escapeHtml(loadedRejection.rejectedBy || 'an admin')}
    ${when ? `on ${escapeHtml(when)}` : ''}:
    ${escapeHtml(loadedRejection.reason)}
    <br><small>This is the schedule that was rejected for ${escapeHtml(postingWeekLabel(loadedRejection.weekStart))}.
    Fix it and submit again; the admin will see this reason with your resubmission.</small>
  `;
}

async function loadRejectedSchedule(weekStart) {
  const confirmed = window.confirm(
    `Load the rejected schedule for ${postingWeekLabel(weekStart)}?\n\n` +
    'This replaces what is on the page now, including any unsaved changes.'
  );

  if (!confirmed) return;

  const response = await fetch(
    `/api/posted-schedules/rejected?store=${encodeURIComponent(state.store)}` +
    `&week=${encodeURIComponent(weekStart)}`,
    { credentials: 'same-origin', headers: { Accept: 'application/json' } }
  );

  const result = await response.json().catch(() => ({}));

  if (!response.ok) {
    throw new Error(result.error || 'The rejected schedule could not be loaded.');
  }

  restoreBuilderState(result.builderState || {});

  loadedRejection = { weekStart, ...result.rejection };

  const select = document.getElementById('postWeekSelect');
  if (select) select.value = weekStart;

  renderRejectionNote();

  if (timeOffData.week !== weekStart) {
    await loadTimeOffForWeek(weekStart);
  }
}

