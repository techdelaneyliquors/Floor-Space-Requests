}

function shortenEmployeeName(name) {
  const parts = String(name || '')
    .trim()
    .split(/\s+/);

  if (parts.length <= 1) {
    return parts[0] || '';
  }

  return (
    parts[0] +
    ' ' +
    parts[parts.length - 1][0] +
    '.'
  );
}

