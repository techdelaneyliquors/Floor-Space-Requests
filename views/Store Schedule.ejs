}

  function parseTime(text){
    const m = text.trim().match(/^(\d{1,2}):(\d{2})\s*(AM|PM)$/i); if(!m) return null;
    let h=Number(m[1])%12; if(m[3].toUpperCase()==='PM') h+=12; return h+Number(m[2])/60;
  }
  function hasAttendanceIssue(
  scheduledShift,
  actualShift
) {
  if (
    !scheduledShift ||
    !actualShift ||
    !scheduledShift.includes(' to ') ||
    !actualShift.includes(' to ')
  ) {
    return null;
  }

  const [scheduledStart, scheduledEnd] =
    scheduledShift.split(' to ');

  const [actualStart, actualEnd] =
    actualShift.split(' to ');

  const scheduledStartTime =
    parseTime(scheduledStart);

  const scheduledEndTime =
    parseTime(scheduledEnd);

  const actualStartTime =
    parseTime(actualStart);

  const actualEndTime =
    parseTime(actualEnd);

  if (
    scheduledStartTime == null ||
    scheduledEndTime == null ||
    actualStartTime == null ||
    actualEndTime == null
  ) {
    return null;
  }

  const lateMinutes =
    (actualStartTime -
      scheduledStartTime) * 60;

  const earlyMinutes =
    (scheduledEndTime -
      actualEndTime) * 60;

  return {
    late: lateMinutes > 15,
    early: earlyMinutes > 15
  };
}
  function shiftHours(shift){
    if(!shift || !shift.includes(' to ')) return 0;
    const [a,b]=shift.split(' to ').map(parseTime); if(a==null||b==null) return 0;
    return +(b<a?b+24-a:b-a).toFixed(2);
  }

  function gatherScheduled() {
  const employees = [
    ...new Set([
      ...state.managers,
      ...state.associates,
      ...state.cashiers
    ])
  ];

  const values = {};

  employees.forEach(name => {
    values[name] = Object.fromEntries(
      DAY_KEYS.map(day => [
        day,
        {
          hours: 0,
          rawHours: 0,
          lunchDeducted: false,
          modified: false,
          shifts: []
        }
      ])
    );
  });

  const coverageGroups = [
  {
    type: 'manager',
    coverage: managerCoverage
  },
  {
    type: 'associate',
    coverage: associateCoverage
  },
  {
    type: 'cashier',
    coverage: cashierCoverage
  }
];

  coverageGroups.forEach(group => {
    Object.entries(group.coverage)
      .forEach(([shiftId, row]) => {
        DAY_KEYS.forEach(day => {
          const name = getAssignment(
            group.type,
            shiftId,
            day
          );

          const shift = getEffectiveShift(
            group.type,
            shiftId,
            day,
            row[day] || ''
          );

          const modified = isTemporaryShift(
            group.type,
            shiftId,
            day
          );

          if (
            name &&
            shift &&
            values[name]
          ) {
            values[name][day].rawHours +=
              shiftHours(shift);

            values[name][day].shifts.push({
              text: shift,
              modified
            });

            if (modified) {
              values[name][day].modified = true;
            }
          }
        });
      });
  });

  employees.forEach(name => {
    DAY_KEYS.forEach(day => {
      const dayData = values[name][day];

      const rawHours = Number(
        dayData.rawHours || 0
      );

      if (rawHours >= 7.5) {
        dayData.hours = Math.max(
          0,
          rawHours - 0.5
        );

        dayData.lunchDeducted = true;
      } else {
        dayData.hours = rawHours;
        dayData.lunchDeducted = false;
      }

      dayData.rawHours = Number(
        rawHours.toFixed(2)
      );

      dayData.hours = Number(
        dayData.hours.toFixed(2)
      );
    });
  });

  return values;
}


