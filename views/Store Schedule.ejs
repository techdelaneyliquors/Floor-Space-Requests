async function loadSelectedTemplate() {
  const selector = document.getElementById(
    'templateSelector'
  );

  const templateId = selector?.value || '';

  if (!templateId) {
    alert('Select a template first.');
    return;
  }

  const response = await fetch(
    `/api/schedule-templates/${
      encodeURIComponent(templateId)
    }?store=${
      encodeURIComponent(state.store)
    }`,
    {
      method: 'GET',
      credentials: 'same-origin'
    }
  );

  const responseText = await response.text();

let result = {};

try {
  result = responseText
    ? JSON.parse(responseText)
    : {};
} catch (parseError) {
  console.error(
    'Non-JSON template save response:',
    {
      status: response.status,
      statusText: response.statusText,
      url: response.url,
      responseText
    }
  );

  throw new Error(
    `Template save returned HTTP ${response.status}. ` +
    `The server returned HTML instead of JSON. ` +
    `Check the browser console and Node terminal.`
  );
}

if (!response.ok) {
  throw new Error(
    result.error ||
    `The template could not be saved. HTTP ${response.status}`
  );
}

  const template = result.template;
  state.currentTemplateName =
  template.templateName || '';

  if (!template) {
    throw new Error(
      'The server did not return a template.'
    );
  }

  // No longer working on a rejected schedule
  loadedRejection = null;
  renderRejectionNote();

  const templateData =
    template.templateData || {};

  const loadedManagerCoverage =
    cloneTemplateData(
      templateData.managerCoverage || {}
    );

  const loadedAssociateCoverage =
    cloneTemplateData(
      templateData.associateCoverage || {}
    );

    const loadedCashierCoverage =
  cloneTemplateData(
    templateData.cashierCoverage || {}
  );

  /*
   * Backward compatibility:
   * Merge shifts stored in either the current
   * lowercase property or the old uppercase property.
   */
  const legacyTemporaryShifts =
    templateData.temporaryShifts ||
    templateData.TemporaryShifts ||
    {};

  Object.entries(
    legacyTemporaryShifts
  ).forEach(([key, shiftText]) => {
    const [
      type,
      shiftId,
      day
    ] = key.split(':');

    /*
     * Ignore malformed temporary-shift keys.
     */
    if (!DAY_KEYS.includes(day)) {
      return;
    }

    if (
      type === 'manager' &&
      loadedManagerCoverage[shiftId]
    ) {
      loadedManagerCoverage[
        shiftId
      ][day] = shiftText;
    }

    if (
      type === 'associate' &&
      loadedAssociateCoverage[shiftId]
    ) {
      loadedAssociateCoverage[
        shiftId
      ][day] = shiftText;
    }

    if (
  type === 'cashier' &&
  loadedCashierCoverage[shiftId]
) {
  loadedCashierCoverage[
    shiftId
  ][day] = shiftText;
}
  });

  /*
   * Apply the assignments and permanent coverage
   * from the selected template.
   */
  replaceObjectContents(
    state.assignments,
    templateData.assignments || {}
  );

  replaceObjectContents(
    managerCoverage,
    loadedManagerCoverage
  );

  replaceObjectContents(
    associateCoverage,
    loadedAssociateCoverage
  );

  replaceObjectContents(
  cashierCoverage,
  loadedCashierCoverage
);

  /*
   * A loaded template contains permanent shifts,
   * so nothing should remain marked temporary.
   */
  replaceObjectContents(
  temporaryShifts,
  {}
);

replaceObjectContents(
  temporaryShiftNotes,
  {}
);

replaceObjectContents(
  deletedShiftAssignments,
  {}
);

clearRowChanges();
buildingNewTemplate = false;

renderAllTables();

  alert(
    `"${template.templateName || 'Template'}" was loaded.`
  );
}

function beginNewTemplate() {
  const confirmed = window.confirm(
    'Start a new blank template? ' +
    'All current shift times, assignments, ' +
    'and unsaved schedule changes will be cleared.'
  );

  if (!confirmed) {
    return;
  }

  // No longer working on a rejected schedule
  loadedRejection = null;
  renderRejectionNote();

  /*
   * Preserve the coverage row labels but clear
   * every shift time from Monday through Sunday.
   */
  state.currentTemplateName =
  'New Unsaved Template';
  const blankManagerCoverage =
    createBlankCoverage(
      managerCoverage
    );

  const blankAssociateCoverage =
    createBlankCoverage(
      associateCoverage
    );

    const blankCashierCoverage =
  createBlankCoverage(
    cashierCoverage
  );

  replaceObjectContents(
    managerCoverage,
    blankManagerCoverage
  );

  replaceObjectContents(
    associateCoverage,
    blankAssociateCoverage
  );

  replaceObjectContents(
  cashierCoverage,
  blankCashierCoverage
);

  /*
   * Clear all employee assignments.
   */
  replaceObjectContents(
    state.assignments,
    {}
  );

  /*
   * Clear all temporary shifts and adjustment notes.
   */
  replaceObjectContents(
  temporaryShifts,
  {}
);

replaceObjectContents(
  temporaryShiftNotes,
  {}
);

replaceObjectContents(
  deletedShiftAssignments,
  {}
);

const selector =
  document.getElementById(
    'templateSelector'
  );

  if (selector) {
    selector.value = '';
  }
  clearRowChanges();
  buildingNewTemplate = true;
  renderAllTables();
}

async function deleteSelectedTemplate() {
  const selector =
    document.getElementById(
      'templateSelector'
    );

  const templateId =
    selector?.value || '';

  if (!templateId) {
    alert('Select a template first.');
    return;
  }

  const selectedOption =
    selector.options[
      selector.selectedIndex
    ];

  const templateName =
    selectedOption?.textContent?.trim() ||
    'this template';

  const confirmed = window.confirm(
    `Delete "${templateName}"?`
  );

  if (!confirmed) {
    return;
  }

  const response = await fetch(
    `/api/schedule-templates/${
      encodeURIComponent(templateId)
    }?store=${
      encodeURIComponent(state.store)
    }`,
    {
      method: 'DELETE',
      credentials: 'same-origin'
    }
  );

  const result = await response.json();

  if (!response.ok) {
    throw new Error(
      result.error ||
      'The template could not be deleted.'
    );
  }

  await loadTemplateList();

  alert('Template deleted.');
}

