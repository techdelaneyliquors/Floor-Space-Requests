document.addEventListener(
  'change',
  async event => {
    const input =
      event.target.closest(
        '.approved-overtime-input'
      );

    if (!input) {
      return;
    }

    const employeeName =
      String(
        input.dataset.employeeName || ''
      ).trim();

    const employeeNumber =
      String(
        state.buildEmployeeIdentifiers?.[
          employeeName
        ] || ''
      ).trim();

    if (!employeeNumber) {
      alert(
        'Enter and save an employee number ' +
        'before setting approved overtime.'
      );

      input.value = '0';

      return;
    }

    const approvedHours =
      Number(input.value || 0);

    if (
      !Number.isFinite(approvedHours) ||
      approvedHours < 0 ||
      approvedHours > 40
    ) {
      alert(
        'Approved overtime must be between ' +
        '0 and 40 hours.'
      );

      input.value =
        getApprovedOvertimeHours(
          employeeNumber
        );

      return;
    }

    state.approvedOvertimeHours[
      employeeNumber
    ] = Number(
      approvedHours.toFixed(2)
    );

    input.value =
      state.approvedOvertimeHours[
        employeeNumber
      ];

    try {
      await saveEmployeeSettings();

      renderAllTables();
    } catch (err) {
      console.error(
        'Approved overtime save error:',
        err
      );

      alert(
        'The approved overtime changed on the page, ' +
        'but it could not be saved.'
      );
    }
  }
);

