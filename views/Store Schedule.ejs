<script>
  const DAYS = ['Monday','Tuesday','Wednesday','Thursday','Friday','Saturday','Sunday'];
  const DAY_KEYS = DAYS.map(d => d.toLowerCase());
  const temporaryShifts = {};
  const temporaryShiftNotes = {};
  const deletedShiftAssignments = {};
  const attendanceExceptionComments = {};

let currentAttendanceExceptions = {};

let existingAttendancePoints = {};
let attendancePointSummary = [];
let existingPointRecommendations = {};
let existingOvertimeReviews = {};

let attendancePointsLoaded = false;
let overtimeReviewsLoaded = false;
let pointRecommendationsLoaded = false;

let buildingNewTemplate = false;

// Managers recommend attendance points; only admins assign them (the
// server enforces this too)
const IS_ADMIN = <%- safeJson(Boolean(user && user.role === 'admin')) %>;


  const state = {
  store: <%- safeJson(storeName) %>,
 templates: [],
 currentTemplateName: '',
  managers:
    <%- safeJson(incoming.managers || []) %>,

  associates:
    <%- safeJson(incoming.associates || []) %>,

    cashiers:
    <%- safeJson(incoming.cashiers || []) %>,

    approvedOvertimeHours:
  <%- safeJson(
    incoming.approvedOvertimeHours || {}
  ) %>,

    buildEmployeeIdentifiers:
  <%- safeJson(
    incoming.buildEmployeeIdentifiers || {}
  ) %>,

  availability:
    <%- safeJson(incoming.availability || {}) %>,

  assignments:
    <%- safeJson(incoming.assignments || {}) %>,

  attendance:
  <%- safeJson(incoming.attendance || {}) %>,

employeeIdentifiers:
  <%- safeJson(
    incoming.employeeIdentifiers || {}
  ) %>,

previousScheduledShifts:
  <%- safeJson(
    incoming.previousScheduledShifts || {}
  ) %>,



  previousActualShifts:
    <%- safeJson(
      incoming.previousActualShifts || {}
    ) %>,

  previousActualHours:
    <%- safeJson(
      incoming.previousActualHours || {}
    ) %>,

    previousWeekStart:
  <%- safeJson(
    incoming.previousWeekStart || null
  ) %>,

previousWeekEnd:
  <%- safeJson(
    incoming.previousWeekEnd || null
  ) %>,

  previousScheduledHours:
    <%- safeJson(
      incoming.previousScheduledHours || {}
    ) %>,

  // { defaultHours, overrides: [{ weekStart, hours }] }; admins edit it
  hoursBudget:
    <%- safeJson(
      incoming.hoursBudget || { defaultHours: null, overrides: [] }
    ) %>,

  // Absences on the previous-week review marked as paid/unpaid sick days:
  // [{ employeeNumber, date, type, hours }]
  sickDays:
    <%- safeJson(incoming.sickDays || []) %>,

  // Employee numbers marked salaried on the Paychex IDs page: no paid OT
  salariedEmployeeNumbers:
    <%- safeJson(incoming.salariedEmployeeNumbers || []) %>,

  // Last "previous week review is ready" email: { sentAt, weekStart, sentBy }
  previousWeekReviewPing:
    <%- safeJson(incoming.previousWeekReviewPing || null) %>,
  };

  const isSalaried = employeeNumber =>
    Boolean(employeeNumber) && state.salariedEmployeeNumbers.includes(String(employeeNumber));

  // Hourly employees are paid overtime for every hour over 40; salaried, none
  const paidOvertimeFor = (employeeNumber, workedHours) =>
    isSalaried(employeeNumber) ? 0 : Math.max(0, Number(workedHours || 0) - 40);

  // Preset coverage rows for this store (config/scheduleStores.js). Blank means
  // no preset window; a loaded template replaces these.
  const managerCoverage = <%- safeJson(scheduleSetup.managerCoverage) %>;

const associateCoverage = <%- safeJson(scheduleSetup.associateCoverage) %>;

const cashierCoverage = <%- safeJson(scheduleSetup.cashierCoverage) %>;

  function employeeKey(type, name){
  return `${type}:${name}`;
}

  function initializeAvailability() {

  const allEmployees = [
    ...state.managers,
    ...state.associates,
    ...state.cashiers
  ];

  for (const employee of allEmployees) {

    if (
      typeof state.availability[employee] !== 'boolean'
    ) {

      state.availability[employee] = true;

    }

  }

  }

  initializeAvailability();

  function available(type) {
  let list = [];

  if (type === 'manager') {
    /*
     * Manager shifts can only be filled
     * by managers.
     */
    list = [
      ...state.managers
    ];
  } else if (type === 'associate') {
    /*
     * Associate shifts can be filled by
     * associates or managers.
     */
    list = [
      ...state.associates,
      ...state.managers,
      ...state.cashiers
    ];
  } else if (type === 'cashier') {
    /*
     * Cashier shifts can be filled by
     * cashiers, associates, or managers.
     */
    list = [
      ...state.cashiers,
      ...state.associates,
      ...state.managers
    ];
  }

  return [
    ...new Set(list)
  ].filter(
    name =>
      state.availability[name] === true
  );
}

  function getEmployeeRole(name) {
  if (state.managers.includes(name)) {
    return 'Manager';
  }

  if (state.associates.includes(name)) {
    return 'Associate';
  }

  if (state.cashiers.includes(name)) {
    return 'Cashier';
  }

  return '';
}

// cell (optional): { day, dayIndex, shift } marks people who are off or
// unavailable for that shift, e.g. "Ann Employee (Associate) — time off (all day)"
function employeeOptions(
  type,
  selected = '',
  cell = null
) {
  const options = available(type)
    .map(name => {
      const isSelected =
        name === selected
          ? ' selected'
          : '';

      const role =
        getEmployeeRole(name);

      const conflicts = cell
        ? timeOffConflicts(name, cell.day, cell.dayIndex, cell.shift)
        : [];

      const displayText =
        (role
          ? `${name} (${role})`
          : name) +
        (conflicts.length
          ? ` — ⚠ ${conflicts.map(conflict => conflict.short).join('; ')}`
          : '');

      return `
        <option
          value="${escapeHtml(name)}"
          ${isSelected}
        >
          ${escapeHtml(displayText)}
        </option>
      `;
    })
    .join('');

  return `
    <option value="">
      Unassigned
    </option>

    ${options}
  `;
}

  function scheduleCellKey(type, shiftId, day) {
  return `${type}:${shiftId}:${day}`;
}

function legacyAssignmentKey(shiftId, day) {
  return `${shiftId}:${day}`;
}

function getAssignment(type, shiftId, day) {
  const newKey = scheduleCellKey(type, shiftId, day);

  if (Object.prototype.hasOwnProperty.call(
    state.assignments,
    newKey
  )) {
    return state.assignments[newKey] || '';
  }

  return state.assignments[
    legacyAssignmentKey(shiftId, day)
  ] || '';
}

function getEffectiveShift(
  type,
  shiftId,
  day,
  presetShift
) {
  const key = scheduleCellKey(
    type,
    shiftId,
    day
  );

  if (
    Object.prototype.hasOwnProperty.call(
      temporaryShifts,
      key
    )
  ) {
    return temporaryShifts[key];
  }

  return presetShift || '';
}

function isTemporaryShift(
  type,
  shiftId,
  day
) {
  const key = scheduleCellKey(
    type,
    shiftId,
    day
  );

  return Object.prototype.hasOwnProperty.call(
    temporaryShifts,
    key
  );
}

function timeTextToInputValue(timeText) {
  const parsed = parseTime(timeText);

  if (parsed == null) {
    return '';
  }

  const hours = Math.floor(parsed) % 24;
  const minutes = Math.round(
    (parsed - Math.floor(parsed)) * 60
  );

  return (
    String(hours).padStart(2, '0') +
    ':' +
    String(minutes).padStart(2, '0')
  );
}

function shiftToInputValues(shiftText) {
  if (
    !shiftText ||
    !shiftText.includes(' to ')
  ) {
    return {
      start: '',
      end: ''
    };
  }

  const parts = shiftText.split(' to ');

  return {
    start: timeTextToInputValue(parts[0]),
    end: timeTextToInputValue(parts[1])
  };
}

function inputTimeToDisplay(inputValue) {
  if (!inputValue) {
    return '';
  }

  const parts = inputValue.split(':');

  let hours = Number(parts[0]);
  const minutes = Number(parts[1]);

  const suffix = hours >= 12
    ? 'PM'
    : 'AM';

  hours = hours % 12;

  if (hours === 0) {
    hours = 12;
  }

  return (
    hours +
    ':' +
    String(minutes).padStart(2, '0') +
    ' ' +
    suffix
  );
}

function saveTemporaryShift(
  type,
  shiftId,
  day
) {
  const key = scheduleCellKey(
    type,
    shiftId,
    day
  );

  const startInput = document.querySelector(
    `[data-shift-start="${key}"]`
  );

  const endInput = document.querySelector(
    `[data-shift-end="${key}"]`
  );

  if (!startInput || !endInput) {
    return;
  }

  if (!startInput.value || !endInput.value) {
    alert(
      'Enter both a start time and an end time.'
    );
    return;
  }

  const startText = inputTimeToDisplay(
    startInput.value
  );

  const endText = inputTimeToDisplay(
    endInput.value
  );

  const newShift =
    `${startText} to ${endText}`;

  let reason = '';

  if (!buildingNewTemplate) {
    const existingNote =
      temporaryShiftNotes[key] || '';

    const enteredReason = window.prompt(
      'Reason for this schedule change:',
      existingNote
    );

    if (enteredReason === null) {
      renderAllTables();
      return;
    }

    reason = enteredReason.trim();
  }

  /*
   * Only save the shift after the user has
   * completed or accepted the reason prompt.
   */
  temporaryShifts[key] = newShift;
  temporaryShiftNotes[key] = reason;

  renderAllTables();
}

function getApprovedOvertimeHours(
  employeeNumber
) {
  const cleanEmployeeNumber =
    String(
      employeeNumber || ''
    ).trim();

  if (!cleanEmployeeNumber) {
    return 0;
  }

  const approvedHours =
    Number(
      state.approvedOvertimeHours?.[
        cleanEmployeeNumber
      ] || 0
    );

  if (
    !Number.isFinite(approvedHours) ||
    approvedHours < 0
  ) {
    return 0;
  }

  return approvedHours;
}

function getApprovedWeeklyHours(
  employeeNumber
) {
  return (
    40 +
    getApprovedOvertimeHours(
      employeeNumber
    )
  );
}

function calculateOvertimeApproval(
  employeeNumber,
  weeklyHours
) {
  const hours =
    Math.max(
      0,
      Number(weeklyHours || 0)
    );

  const approvedOvertimeHours =
    getApprovedOvertimeHours(
      employeeNumber
    );

  const approvedWeeklyHours =
    40 + approvedOvertimeHours;

  const overtimeHours =
    Math.max(
      0,
      hours - 40
    );

  const unapprovedOvertimeHours =
    Math.max(
      0,
      overtimeHours -
        approvedOvertimeHours
    );

  return {
    weeklyHours:
      hours,

    approvedOvertimeHours,

    approvedWeeklyHours,

    overtimeHours,

    unapprovedOvertimeHours,

    withinApproval:
      unapprovedOvertimeHours === 0
  };
}

function clearTemporaryShift(
  type,
  shiftId,
  day,
  hasPreset
) {
  const key =
    scheduleCellKey(
      type,
      shiftId,
      day
    );

  /*
   * Restore the employee who was assigned before
   * the shift was removed.
   */
  if (
    hasPreset &&
    Object.prototype.hasOwnProperty.call(
      deletedShiftAssignments,
      key
    )
  ) {
    state.assignments[key] =
      deletedShiftAssignments[key] || '';
  }

  delete temporaryShifts[key];
  delete temporaryShiftNotes[key];
  delete deletedShiftAssignments[key];

  /*
   * If this was an added shift rather than a preset
   * shift, removing it should clear its assignment.
   */
  if (!hasPreset) {
    state.assignments[key] = '';
  }

  renderAllTables();
}

function deleteScheduledShift(
  type,
  shiftId,
  day,
  presetShift
) {
  const key =
    scheduleCellKey(
      type,
      shiftId,
      day
    );

  const currentShift =
    getEffectiveShift(
      type,
      shiftId,
      day,
      presetShift
    );

  if (!currentShift) {
    return;
  }

  const confirmed =
    window.confirm(
      `Delete the ${currentShift} shift ` +
      `for ${DAYS[DAY_KEYS.indexOf(day)]}?`
    );

  if (!confirmed) {
    return;
  }

  const existingReason =
    temporaryShiftNotes[key] || '';

  const enteredReason =
    window.prompt(
      'Why is this shift being removed? ' +
      'This explanation will appear on the ' +
      'printable schedule.',
      existingReason
    );

  if (enteredReason === null) {
    return;
  }

  const reason =
    enteredReason.trim();

  if (!reason) {
    alert(
      'Enter an explanation before removing the shift.'
    );

    return;
  }

  /*
   * Save the current assignment so Reset can restore it.
   */
  deletedShiftAssignments[key] =
    getAssignment(
      type,
      shiftId,
      day
    );

  /*
   * An empty temporary shift means that the preset
   * shift has been temporarily removed.
   */
  temporaryShifts[key] = '';

  temporaryShiftNotes[key] =
    reason;

  /*
   * Clear the employee assignment because the shift
   * no longer exists in the current schedule.
   */
  state.assignments[key] = '';

  /*
   * Also clear a possible legacy assignment key.
   */
  const oldAssignmentKey =
    legacyAssignmentKey(
      shiftId,
      day
    );

  if (
    Object.prototype.hasOwnProperty.call(
      state.assignments,
      oldAssignmentKey
    )
  ) {
    state.assignments[
      oldAssignmentKey
    ] = '';
  }

  renderAllTables();
}

/*
 * Adding and removing whole coverage rows (e.g. a 5th manager, or new
 * cashier coverage). Outside "New Template" mode these are this-week
 * changes that need a reason, like shift changes; they become permanent
 * when the schedule is saved as a template.
 */
const ROW_TYPE_LABELS = {
  manager: 'Manager',
  associate: 'Associate',
  cashier: 'Cashier'
};

// 'type:shiftId' -> reason, for rows added this week
const addedRows = {};

// 'type:shiftId' -> { type, shiftId, row, index, reason, cells }
const removedRows = {};

function coverageFor(type) {
  if (type === 'manager') return managerCoverage;
  if (type === 'associate') return associateCoverage;
  if (type === 'cashier') return cashierCoverage;
  return null;
}

function rowKey(type, shiftId) {
  return `${type}:${shiftId}`;
}

function nextRowId(type) {
  const taken = [
    ...Object.keys(coverageFor(type)),
    ...Object.values(removedRows)
      .filter(item => item.type === type)
      .map(item => item.shiftId)
  ];

  let highest = 0;

  taken.forEach(id => {
    const match = new RegExp(`^${type}(\\d+)$`).exec(id);
    if (match) highest = Math.max(highest, Number(match[1]));
  });

  return `${type}${highest + 1}`;
}

// Moves every per-cell value for a row out of the page state and
// returns it, so a removed row can be restored exactly
function takeRowCells(type, shiftId) {
  const cells = {
    assignments: {},
    temporaryShifts: {},
    temporaryShiftNotes: {},
    deletedShiftAssignments: {}
  };

  const stores = {
    assignments: state.assignments,
    temporaryShifts,
    temporaryShiftNotes,
    deletedShiftAssignments
  };

  DAY_KEYS.forEach(day => {
    const keys = [
      scheduleCellKey(type, shiftId, day),
      legacyAssignmentKey(shiftId, day)
    ];

    keys.forEach(key => {
      Object.entries(stores).forEach(([name, store]) => {
        if (Object.prototype.hasOwnProperty.call(store, key)) {
          cells[name][key] = store[key];
          delete store[key];
        }
      });
    });
  });

  return cells;
}

function addCoverageRow(type) {
  const coverage = coverageFor(type);
  if (!coverage) return;

  const shiftId = nextRowId(type);
  const defaultLabel =
    `${ROW_TYPE_LABELS[type]} ${shiftId.slice(type.length)}`;

  const enteredLabel = window.prompt(
    `Name for the new ${ROW_TYPE_LABELS[type].toLowerCase()} row:`,
    defaultLabel
  );

  if (enteredLabel === null) return;

  const label = enteredLabel.trim().slice(0, 60) || defaultLabel;

  let reason = '';

  if (!buildingNewTemplate) {
    const enteredReason = window.prompt(
      `Why is the "${label}" row being added? ` +
      'This explanation will appear on the printable schedule.',
      ''
    );

    if (enteredReason === null) return;

    reason = enteredReason.trim();

    if (!reason) {
      alert('Enter an explanation before adding the row.');
      return;
    }
  }

  coverage[shiftId] = {
    label,
    monday: '',
    tuesday: '',
    wednesday: '',
    thursday: '',
    friday: '',
    saturday: '',
    sunday: ''
  };

  if (reason) {
    addedRows[rowKey(type, shiftId)] = reason;
  }

  renderAllTables();
}

function removeCoverageRow(type, shiftId) {
  const coverage = coverageFor(type);
  const row = coverage && coverage[shiftId];
  if (!row) return;

  const key = rowKey(type, shiftId);
  const label = row.label || shiftId;

  const confirmed = window.confirm(
    `Remove the "${label}" row? Its shifts and assignments ` +
    'will be cleared from this schedule.'
  );

  if (!confirmed) return;

  const addedThisWeek =
    Object.prototype.hasOwnProperty.call(addedRows, key);

  // Undoing a row added this week, or editing a new template,
  // needs no explanation
  if (addedThisWeek || buildingNewTemplate) {
    takeRowCells(type, shiftId);
    delete coverage[shiftId];
    delete addedRows[key];
    renderAllTables();
    return;
  }

  const enteredReason = window.prompt(
    `Why is the "${label}" row being removed? ` +
    'This explanation will appear on the printable schedule.',
    ''
  );

  if (enteredReason === null) return;

  const reason = enteredReason.trim();

  if (!reason) {
    alert('Enter an explanation before removing the row.');
    return;
  }

  removedRows[key] = {
    type,
    shiftId,
    row: cloneTemplateData(row),
    index: Object.keys(coverage).indexOf(shiftId),
    reason,
    cells: takeRowCells(type, shiftId)
  };

  delete coverage[shiftId];

  renderAllTables();
}

function restoreCoverageRow(key) {
  const removed = removedRows[key];
  if (!removed) return;

  const coverage = coverageFor(removed.type);

  // Put the row back in its original position
  const entries = Object.entries(coverage);
  entries.splice(
    Math.min(removed.index, entries.length),
    0,
    [removed.shiftId, removed.row]
  );
  replaceObjectContents(coverage, Object.fromEntries(entries));

  Object.assign(state.assignments, removed.cells.assignments);
  Object.assign(temporaryShifts, removed.cells.temporaryShifts);
  Object.assign(temporaryShiftNotes, removed.cells.temporaryShiftNotes);
  Object.assign(deletedShiftAssignments, removed.cells.deletedShiftAssignments);

  delete removedRows[key];

  renderAllTables();
}

// Row changes are this-week adjustments; loading, saving or starting a
// template makes the current rows the baseline
function clearRowChanges() {
  replaceObjectContents(addedRows, {});
  replaceObjectContents(removedRows, {});
}

document.addEventListener('click', event => {
  const removeButton = event.target.closest('[data-remove-row-type]');

  if (removeButton) {
    removeCoverageRow(
      removeButton.dataset.removeRowType,
      removeButton.dataset.removeRowId
    );
    return;
  }

  const restoreButton = event.target.closest('[data-restore-row]');

  if (restoreButton) {
    restoreCoverageRow(restoreButton.dataset.restoreRow);
  }
});

  function renderCoverage(
  tableId,
  coverage,
  type
) {
  const tbody = document.querySelector(
    `#${tableId} tbody`
  );

  // Stores without cashiers have no cashier table on the page
  if (!tbody) {
    return;
  }

  tbody.innerHTML = Object.entries(coverage)
    .map(([shiftId, row]) => {
      const cells = DAY_KEYS.map(day => {
        const presetShift = row[day] || '';

        const shift = getEffectiveShift(
          type,
          shiftId,
          day,
          presetShift
        );

        const temporary = isTemporaryShift(
          type,
          shiftId,
          day
        );

        const assignmentKey = scheduleCellKey(
          type,
          shiftId,
          day
        );

        if (!shift) {
  const key =
    scheduleCellKey(
      type,
      shiftId,
      day
    );

  const shiftWasRemoved =
    Boolean(presetShift) &&
    Object.prototype.hasOwnProperty.call(
      temporaryShifts,
      key
    ) &&
    temporaryShifts[key] === '';

  if (shiftWasRemoved) {
    const removalReason =
      temporaryShiftNotes[key] ||
      'No explanation provided';

    return `
      <td class="removed-shift-cell">
        <span class="removed-shift-label">
