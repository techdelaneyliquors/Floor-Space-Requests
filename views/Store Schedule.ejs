/*
 * Approved time off and weekly availability for the week selected under
 * "Post this schedule", by roster name. Shown at the top of the Build tab
 * and used by the warnings.
 */
let timeOffData = { week: '', timeOff: [], availability: {} };

// '16:30' -> 16.5
function hhmmToHours(value) {
  const match = /^(\d{2}):(\d{2})$/.exec(String(value || ''));
  return match ? Number(match[1]) + Number(match[2]) / 60 : null;
}

function describeTimeOffEntry(entry) {
  return entry.allDay
    ? 'all day'
    : `${inputTimeToDisplay(entry.startTime)} – ${inputTimeToDisplay(entry.endTime)}`;
}

async function loadTimeOffForWeek(weekStart) {
  if (!weekStart) return;

  // PTO hours belong to the same week
  const ptoLoading = loadPtoForWeek(weekStart);

  try {
    const response = await fetch(
      `/api/time-off-schedule?store=${encodeURIComponent(state.store)}&week=${encodeURIComponent(weekStart)}`,
      { credentials: 'same-origin', headers: { Accept: 'application/json' } }
    );
    const result = await response.json();
    if (!response.ok) throw new Error(result.error || 'Time off could not be loaded.');

    timeOffData = {
      week: weekStart,
      timeOff: result.timeOff || [],
      availability: result.availability || {}
    };
  } catch (err) {
    console.error('Time off could not be loaded:', err);
    timeOffData = { week: weekStart, timeOff: [], availability: {}, failed: true };
  }

  await ptoLoading;

  renderTimeOffPanel();
  renderPtoPanel();

  // Redraw the shift tables so conflicts (including ones from a template
  // that was just loaded) are marked; this also refreshes the warnings
  renderAllTables();

  // The budget picker follows the week being built until an admin picks one
  if (!budgetWeekChosen) renderHoursBudgetControls();
}

// The week being checked can be changed from the Build tab too; it stays
// in step with the "Post this schedule" week
document.addEventListener('change', event => {
  if (event.target.id !== 'buildWeekSelect') return;

  const postSelect = document.getElementById('postWeekSelect');
  if (postSelect) postSelect.value = event.target.value;

  loadTimeOffForWeek(event.target.value);
});

function renderTimeOffPanel() {
  const panel = document.getElementById('timeOffPanel');
  if (!panel) return;

  if (!timeOffData.week) {
    panel.innerHTML = '<span class="muted">Loading time off…</span>';
    return;
  }

  const byDay = DAY_KEYS
    .map((day, index) => ({
      label: DAYS[index],
      entries: timeOffData.timeOff.filter(entry => entry.day === day)
    }))
    .filter(group => group.entries.length);

  const restricted = Object.entries(timeOffData.availability)
    .map(([name, pattern]) => {
      const limits = DAY_KEYS
        .map((day, index) => {
          const entry = pattern && pattern[day];
          if (!entry || entry.mode === 'all') return '';
          return entry.mode === 'none'
            ? `not ${DAYS[index].slice(0, 3)}`
            : `${DAYS[index].slice(0, 3)} ${inputTimeToDisplay(entry.start)}–${inputTimeToDisplay(entry.end)}`;
        })
        .filter(Boolean);
      return limits.length ? { name, limits } : null;
    })
    .filter(Boolean)
    .sort((a, b) => a.name.localeCompare(b.name));

  // Same week choices as "Post this schedule"
  const postSelect = document.getElementById('postWeekSelect');
  const weekOptions = postSelect
    ? [...postSelect.options].map(option => `
        <option value="${escapeHtml(option.value)}" ${option.value === timeOffData.week ? 'selected' : ''}>
          ${escapeHtml(option.textContent.trim())}
        </option>`).join('')
    : '';

  panel.innerHTML = `
    <h4>
      Scheduling for
      ${weekOptions
        ? `<select id="buildWeekSelect" class="build-week-select">${weekOptions}</select>`
        : escapeHtml(postingWeekLabel(timeOffData.week))}
      <span class="muted">Time off, availability and warnings are checked against this week.</span>
    </h4>
    ${timeOffData.failed ? '<div>Time off could not be loaded.</div>' : ''}
    <strong>Approved time off:</strong>
    ${byDay.length
      ? `<ul>${byDay.map(group => `
          <li><strong>${escapeHtml(group.label)}:</strong>
            ${group.entries.map(entry =>
              `${escapeHtml(entry.name)} (${escapeHtml(describeTimeOffEntry(entry))})`
            ).join(', ')}
          </li>`).join('')}</ul>`
      : ' none this week.<br>'}
    <strong>Regular availability limits:</strong>
    ${restricted.length
      ? `<ul>${restricted.map(item =>
          `<li><strong>${escapeHtml(item.name)}:</strong> ${escapeHtml(item.limits.join('; '))}</li>`
        ).join('')}</ul>`
      : ' none.'}
  `;
}

document.getElementById('postWeekSelect')?.addEventListener('change', event => {
  loadTimeOffForWeek(event.target.value);
});

// Conflicts between one shift and a person's approved time off or weekly
// availability, for the week being checked. Each has a short label (for
// the dropdown and the shift cell) and a full message (for warnings).
function timeOffConflicts(name, day, dayIndex, shiftText) {
  const found = [];
  if (!name || !shiftText) return found;

  const range = shiftRange(shiftText);

  timeOffData.timeOff
    .filter(entry => entry.name === name && entry.day === day)
    .forEach(entry => {
      const overlaps = entry.allDay || !range ||
        (range.start < hhmmToHours(entry.endTime) && hhmmToHours(entry.startTime) < range.end);

      if (overlaps) {
        found.push({
          type: 'time-off',
          short: `time off (${describeTimeOffEntry(entry)})`,
          message: `${name} is assigned on ${DAYS[dayIndex]} (${shiftText}) but has approved time off (${describeTimeOffEntry(entry)}).`
        });
      }
    });

  const availability = timeOffData.availability[name] && timeOffData.availability[name][day];

  if (availability && availability.mode === 'none') {
    found.push({
      type: 'availability',
      short: `not available ${DAYS[dayIndex]}s`,
      message: `${name} is assigned on ${DAYS[dayIndex]} (${shiftText}) but is not available on ${DAYS[dayIndex]}s.`
    });
  } else if (availability && availability.mode === 'hours' && range) {
    const from = hhmmToHours(availability.start);
    const until = hhmmToHours(availability.end);

    if (range.start < from || range.end > until) {
      const hoursText = `${inputTimeToDisplay(availability.start)}–${inputTimeToDisplay(availability.end)}`;
      found.push({
        type: 'availability',
        short: `available ${hoursText} only`,
        message: `${name} is assigned ${shiftText} on ${DAYS[dayIndex]} but is only available ` +
          `${inputTimeToDisplay(availability.start)} – ${inputTimeToDisplay(availability.end)} on ${DAYS[dayIndex]}s.`
      });
    }
  }

  return found;
}

// Warnings for one assigned shift against time off and availability
function timeOffWarningsFor(name, day, dayIndex, shiftText) {
  return timeOffConflicts(name, day, dayIndex, shiftText)
    .map(conflict => ({ type: conflict.type, message: conflict.message }));
}

// The same warnings are shown on the Build tab and in the Post panel
function renderScheduleWarnings() {
  const boxes = ['buildWarnings', 'scheduleWarnings']
    .map(id => document.getElementById(id))
    .filter(Boolean);

  if (!boxes.length) return;

  const warnings = checkScheduleWarnings();

  const html = warnings.length
    ? `
      <strong>${warnings.length} warning${warnings.length === 1 ? '' : 's'} to review before submitting</strong>
      <ul>
        ${warnings.map(warning => `<li>${escapeHtml(warning.message)}</li>`).join('')}
      </ul>
    `
    : '<strong>No scheduling warnings.</strong>';

  boxes.forEach(box => {
    box.className = warnings.length
      ? 'schedule-warnings has-warnings'
      : 'schedule-warnings no-warnings';
    box.innerHTML = html;
  });
}

async function postScheduleForApproval() {
  const select = document.getElementById('postWeekSelect');
  const weekStart = select?.value;

  if (!weekStart) {
    alert('Choose a week first.');
    return;
  }

  const snapshot = buildPostSnapshot();

  if (!snapshot.groups.length) {
    alert('There are no assigned shifts to post.');
    return;
  }

  // Check against time off for the week actually being posted
  if (timeOffData.week !== weekStart) {
    await loadTimeOffForWeek(weekStart);
  }

  const warnings = checkScheduleWarnings();

  if (warnings.length) {
    const listed = warnings
      .slice(0, 8)
      .map(warning => `• ${warning.message}`)
      .join('\n');

    const enteredReason = window.prompt(
      `This schedule has ${warnings.length} warning${warnings.length === 1 ? '' : 's'}:\n\n` +
      listed +
      (warnings.length > 8 ? `\n• …and ${warnings.length - 8} more (listed on the page)` : '') +
      '\n\nTo submit anyway, explain why. The admin will see the warnings and your reason.',
      ''
    );

    if (enteredReason === null) return;

    if (!enteredReason.trim()) {
      alert('Enter a reason to submit a schedule that has warnings.');
      return;
    }

    snapshot.warnings = warnings;
    snapshot.warningsReason = enteredReason.trim();
  }

  // Resubmitting a rejected week: the admin sees the earlier rejection
  const answeringRejection =
    loadedRejection && loadedRejection.weekStart === weekStart;

  if (answeringRejection) {
    snapshot.previousRejection = {
      reason: loadedRejection.reason,
      rejectedBy: loadedRejection.rejectedBy || '',
      rejectedAt: loadedRejection.rejectedAt || null
    };
  }

  const confirmed = window.confirm(
    `Submit this schedule for ${postingWeekLabel(weekStart)}?\n\n` +
    'An admin must approve it before employees can see it. ' +
    'If this week already has a schedule, employees keep seeing ' +
    'the current one until this version is approved.'
  );

  if (!confirmed) return;

  const response = await fetch('/api/posted-schedules', {
    method: 'POST',
    credentials: 'same-origin',
    headers: {
      'Content-Type': 'application/json',
      Accept: 'application/json'
    },
    body: JSON.stringify({
      store: state.store,
      weekStart,
      snapshot,
      // Lets a rejected week be loaded back exactly as submitted
      builderState: JSON.stringify(captureBuilderState())
    })
  });

  const result = await response.json().catch(() => ({}));

  if (!response.ok) {
    throw new Error(result.error || 'The schedule could not be posted.');
  }

  if (answeringRejection) {
    loadedRejection = null;
    renderRejectionNote();
  }

  await loadPostedWeeks();

  alert(
    result.status === 'approved'
      ? 'Posted. Because you are an admin, it was approved right away and employees can see it now.'
      : 'Submitted for approval. Employees will see it once an admin approves it.'
  );
}

document
  .getElementById('postScheduleBtn')
  ?.addEventListener('click', () => {
    postScheduleForApproval().catch(err => {
      console.error('Post schedule failed:', err);
      alert(err.message);
    });
  });

function cloneTemplateData(value) {
  return JSON.parse(
    JSON.stringify(value || {})
  );
}

function captureCurrentTemplate() {
  const savedManagerCoverage =
    cloneTemplateData(managerCoverage);

  const savedAssociateCoverage =
    cloneTemplateData(associateCoverage);

    const savedCashierCoverage =
  cloneTemplateData(
    cashierCoverage
  );

  /*
   * Merge every temporary/adjusted shift into
   * the permanent coverage saved in the template.
   */
  Object.entries(temporaryShifts)
    .forEach(([key, shiftText]) => {
      const [
        type,
        shiftId,
        day
      ] = key.split(':');

      if (
        type === 'manager' &&
        savedManagerCoverage[shiftId]
      ) {
        savedManagerCoverage[
          shiftId
        ][day] = shiftText;
      }

      if (
        type === 'associate' &&
        savedAssociateCoverage[shiftId]
      ) {
        savedAssociateCoverage[
          shiftId
        ][day] = shiftText;
      }

      if (
  type === 'cashier' &&
  savedCashierCoverage[shiftId]
) {
  savedCashierCoverage[
    shiftId
  ][day] = shiftText;
}
    });

  return {
  assignments:
    cloneTemplateData(
      state.assignments
    ),

  managerCoverage:
    savedManagerCoverage,

  associateCoverage:
    savedAssociateCoverage,

  cashierCoverage:
    savedCashierCoverage,

  temporaryShifts: {},
  temporaryShiftNotes: {}
};

}
function createBlankCoverage(
  existingCoverage
) {
  const blankCoverage = {};

  Object.entries(existingCoverage)
    .forEach(([shiftId, row]) => {
      blankCoverage[shiftId] = {
        label:
          row.label ||
          shiftId,

        monday: '',
        tuesday: '',
        wednesday: '',
        thursday: '',
        friday: '',
        saturday: '',
        sunday: ''
      };
    });

  return blankCoverage;
}


function replaceObjectContents(
  target,
  source
) {
  Object.keys(target).forEach(key => {
    delete target[key];
  });

  Object.assign(
    target,
    cloneTemplateData(source)
  );
}

function renderTemplateSelector(
  selectedTemplateId = ''
) {
  const selector =
    document.getElementById(
      'templateSelector'
    );

  if (!selector) {
    return;
  }

  selector.innerHTML = `
    <option value="">
      Select a template
    </option>

    ${state.templates.map(template => `
      <option
        value="${escapeHtml(template._id)}"
        ${
          template._id === selectedTemplateId
            ? 'selected'
            : ''
        }
      >
        ${escapeHtml(template.templateName)}
        ${
          template.isDefault
            ? ' (Default)'
            : ''
        }
      </option>
    `).join('')}
  `;
}

async function loadTemplateList(
  selectedTemplateId = ''
) {
  const response = await fetch(
    `/api/schedule-templates?store=${
      encodeURIComponent(state.store)
    }`,
    {
      method: 'GET',
      credentials: 'same-origin'
    }
  );

  const result = await response.json();

  if (!response.ok) {
    throw new Error(
      result.error ||
      'Templates could not be loaded.'
    );
  }

  state.templates =
    Array.isArray(result.templates)
      ? result.templates
      : [];

  renderTemplateSelector(
    selectedTemplateId
  );
}

async function saveCurrentAsTemplate() {
  const enteredName = window.prompt(
    'Template name:'
  );

  const templateName =
    enteredName?.trim();

  if (!templateName) {
    return;
  }

  const makeDefault = window.confirm(
    'Make this the default template ' +
    `for ${state.store}?`
  );

  const templateData =
    captureCurrentTemplate();

  const response = await fetch(
    '/api/schedule-templates',
    {
      method: 'POST',

      headers: {
        'Content-Type': 'application/json',
        'Accept': 'application/json'
      },

      credentials: 'same-origin',

      body: JSON.stringify({
        store: state.store,
        templateName,
        isDefault: makeDefault,
        templateData
      })
    }
  );

  const responseText =
    await response.text();

  let result = {};

  try {
    result = responseText
      ? JSON.parse(responseText)
      : {};
  } catch (parseError) {
    console.error(
      'Non-JSON template save response:',
      {
        status: response.status,
        statusText: response.statusText,
        url: response.url,
        responseText
      }
    );

    throw new Error(
      `Template save returned HTTP ${response.status}. ` +
      `The server returned HTML instead of JSON. ` +
      `Server response: ${responseText.slice(0, 500)}`
    );
  }

  if (!response.ok) {
    throw new Error(
      result.error ||
      `The template could not be saved. ` +
      `HTTP ${response.status}`
    );
  }

  if (!result.template) {
    throw new Error(
      'The server reported success but did not ' +
      'return the saved template.'
    );
  }

  state.currentTemplateName =
    result.template.templateName ||
    templateName;

  clearRowChanges();
  buildingNewTemplate = false;

  const savedTemplateData =
    result.template.templateData ||
    templateData;

  replaceObjectContents(
    managerCoverage,
    savedTemplateData.managerCoverage ||
    templateData.managerCoverage ||
    {}
  );

  replaceObjectContents(
    associateCoverage,
    savedTemplateData.associateCoverage ||
    templateData.associateCoverage ||
    {}
  );

  replaceObjectContents(
    cashierCoverage,
    savedTemplateData.cashierCoverage ||
    templateData.cashierCoverage ||
    {}
  );

  replaceObjectContents(
    state.assignments,
    savedTemplateData.assignments ||
    templateData.assignments ||
    {}
  );

  /*
   * Shifts saved in the template are now permanent,
   * so they should no longer be marked temporary.
   */
  replaceObjectContents(
  temporaryShifts,
  {}
);

replaceObjectContents(
  temporaryShiftNotes,
  {}
);

replaceObjectContents(
  deletedShiftAssignments,
  {}
);

await loadTemplateList(
  result.template._id || ''
);

  renderAllTables();

  alert(
    `"${state.currentTemplateName}" was saved ` +
    `for ${state.store}.`
  );
}


async function loadAttendancePointSummary() {
  const parameters =
    new URLSearchParams({
      store: state.store
    });

  const response = await fetch(
    `/api/attendance-points-summary?` +
    `${parameters.toString()}`,
    {
      method: 'GET',

      credentials: 'same-origin',

      headers: {
        Accept: 'application/json'
      }
    }
  );

  const responseText =
    await response.text();

  let result = {};

  try {
    result = responseText
      ? JSON.parse(responseText)
      : {};
  } catch (parseError) {
    throw new Error(
      `Attendance point summary returned HTTP ` +
      `${response.status}. The server returned ` +
      `a non-JSON response.`
    );
  }

  if (!response.ok) {
    throw new Error(
      result.error ||
      'Attendance point history could not be loaded.'
    );
  }

  attendancePointSummary =
    Array.isArray(result.employees)
      ? result.employees
      : [];

  renderAttendancePointHistory();
}
``


function formatPointHistoryDate(value) {
  if (!value) {
    return 'Date not recorded';
  }

  const parsedDate =
    new Date(value);

  if (
    Number.isNaN(
      parsedDate.getTime()
    )
  ) {
    return 'Date not recorded';
  }

  return parsedDate.toLocaleDateString(
    'en-US',
    {
      timeZone: 'UTC',
      month: 'numeric',
      day: 'numeric',
      year: 'numeric'
    }
  );
}

function formatInfractionType(value) {
  const infractionLabels = {
    tardy:
      'Tardy',

    left_early:
      'Left Early',

    late_and_left_early:
      'Late and Left Early',

    absence:
      'Absence',

    no_call_no_show:
      'No Call / No Show'
  };

  const cleanValue =
    String(value || '').trim();

  return (
    infractionLabels[cleanValue] ||
    cleanValue ||
    'Not recorded'
  );
}

function renderAttendancePointHistory() {
  const container =
    document.getElementById(
      'attendancePointHistory'
    );

  if (!container) {
    return;
  }

  const employeesWithPoints =
    attendancePointSummary.filter(employee =>
      Number(
        employee.totalPoints || 0
      ) > 0
    );

  if (!employeesWithPoints.length) {
    container.innerHTML = `
      <div class="no-exceptions">
        No current Build Schedule employees have
        attendance points within the last 365 days.
      </div>
    `;

    return;
  }

  container.innerHTML =
    employeesWithPoints
      .map((employee, employeeIndex) => {
        const pointBearingInfractions =
          Array.isArray(
            employee.infractions
          )
            ? employee.infractions.filter(
                record =>
                  Number(
                    record.points || 0
                  ) > 0
              )
            : [];

        if (!pointBearingInfractions.length) {
          return '';
        }

        const safeEmployeeNumber =
          String(
            employee.employeeNumber || ''
          ).replace(
            /[^a-zA-Z0-9_-]/g,
            ''
          );

        const detailsId =
          `point-history-${employeeIndex}-` +
          `${safeEmployeeNumber}`;

        const totalPoints =
          Number(
            employee.totalPoints || 0
          );

        return `
          <div class="point-history-employee">
            <button
              type="button"
              class="point-history-toggle"
              data-point-history-target="${escapeHtml(
                detailsId
              )}"
              aria-expanded="false"
              aria-controls="${escapeHtml(
                detailsId
              )}"
            >
              <span class="point-history-person">
                <span
                  class="point-history-arrow"
                  aria-hidden="true"
                >
                  &#9654;
                </span>

                <span>
                  ${escapeHtml(
                    employee.employeeName
                  )}

                  <span class="point-history-number">
                    Employee #${escapeHtml(
                      employee.employeeNumber
                    )}
                  </span>
                </span>
              </span>

              <span class="point-history-total">
                ${totalPoints}
                point${totalPoints === 1 ? '' : 's'}
              </span>
            </button>

            <div
              id="${escapeHtml(detailsId)}"
              class="point-history-details"
              hidden
            >
              <div
                class="
                  table-wrap
                  point-history-table-wrap
                "
              >
                <table class="point-history-table">
                  <thead>
                    <tr>
                      <th>Date</th>
                      <th>Infraction</th>
                      <th>Points</th>
                      <th>Assigned By</th>
                      <th>Explanation</th>
                    </tr>
                  </thead>

                  <tbody>
                    ${pointBearingInfractions
                      .map(record => {
                        const dateText =
                          formatPointHistoryDate(
                            record.infractionDate
                          );

                        const infractionText =
                          formatInfractionType(
                            record.infractionType
                          );

                        const assignedBy =
                          String(
                            record.assignedByName ||
                            ''
                          ).trim() ||
                          'Not recorded';

                        const managerComment =
                          String(
                            record.managerComment ||
                            ''
                          ).trim() ||
                          'No explanation recorded';

                        const pointValue =
                          Number(
                            record.points || 0
                          );

                        return `
                          <tr>
                            <td>
                              ${escapeHtml(
                                dateText
                              )}
                            </td>

                            <td>
                              ${escapeHtml(
                                infractionText
                              )}
                            </td>

                            <td class="point-history-points">
                              ${pointValue}
                            </td>

                            <td>
                              ${escapeHtml(
                                assignedBy
                              )}
                            </td>

                            <td class="point-history-comment">
                              ${escapeHtml(
                                managerComment
                              )}
                            </td>
                          </tr>
                        `;
                      })
                      .join('')}
                  </tbody>
                </table>
              </div>
            </div>
          </div>
        `;
      })
      .join('');
}

