/*
 * Posting a week's schedule for employees (admin approval required).
 */
let currentMondayForPosting = '';

function addDaysToYmd(ymd, days) {
  const [y, m, d] = ymd.split('-').map(Number);
  const date = new Date(Date.UTC(y, m - 1, d + days));
  return date.toISOString().slice(0, 10);
}

function formatYmdForPosting(ymd, options) {
  const [y, m, d] = ymd.split('-').map(Number);
  return new Date(Date.UTC(y, m - 1, d))
    .toLocaleDateString('en-US', { timeZone: 'UTC', ...options });
}

function postingWeekLabel(weekStart) {
  const range =
    `${formatYmdForPosting(weekStart, { month: 'short', day: 'numeric' })} – ` +
    formatYmdForPosting(addDaysToYmd(weekStart, 6), { month: 'short', day: 'numeric', year: 'numeric' });

  if (weekStart === currentMondayForPosting) return `Current week (${range})`;
  if (weekStart === addDaysToYmd(currentMondayForPosting, 7)) return `Next week (${range})`;
  return `Week of ${range}`;
}

function renderPostWeekOptions() {
  const select = document.getElementById('postWeekSelect');
  if (!select || !currentMondayForPosting) return;

  const previous = select.value;
  const options = [];

  // Last week through 8 weeks ahead; next week by default, since this
  // page builds next week's schedule
  for (let offset = -1; offset <= 8; offset++) {
    const weekStart = addDaysToYmd(currentMondayForPosting, offset * 7);
    options.push(`
      <option value="${weekStart}">
        ${escapeHtml(postingWeekLabel(weekStart))}
      </option>
    `);
  }

  select.innerHTML = options.join('');
  select.value = previous || addDaysToYmd(currentMondayForPosting, 7);

  // The budget week list is built from these weeks
  renderHoursBudgetControls();
}

/*
 * Weekly hours budget. Admins set a store default and per-week overrides;
 * the printable schedule shows "scheduled / budget" for the week being
 * built, and the previous week shows "worked / budget".
 */
const budgetTotals = {};

// Until an admin picks a week, the per-week picker follows the week being built
let budgetWeekChosen = false;

function mondayOfYmd(ymd) {
  const [y, m, d] = ymd.split('-').map(Number);
  const dow = new Date(Date.UTC(y, m - 1, d)).getUTCDay();
  return addDaysToYmd(ymd, -((dow + 6) % 7));
}

// The week being built (the "Scheduling for" / "Post this schedule" week)
function buildBudgetWeek() {
  if (timeOffData.week) return timeOffData.week;
  return document.getElementById('postWeekSelect')?.value || '';
}

// The uploaded previous week, as its Monday
function previousBudgetWeek() {
  if (!state.previousWeekStart) return '';
  const start = new Date(state.previousWeekStart);
  if (Number.isNaN(start.getTime())) return '';
  return mondayOfYmd(start.toISOString().slice(0, 10));
}

// { hours, source: 'week' | 'default' } or null when no budget applies
function budgetForWeek(weekStart) {
  const budget = state.hoursBudget || {};
  const override = weekStart
    ? (budget.overrides || []).find(entry => entry.weekStart === weekStart)
    : null;

  if (override) return { hours: override.hours, source: 'week' };
  if (typeof budget.defaultHours === 'number') {
    return { hours: budget.defaultHours, source: 'default' };
  }
  return null;
}

function budgetDifferenceText(total, hours) {
  const difference = total - hours;
  return difference > 0.005
    ? `${difference.toFixed(2)} over`
    : `${Math.abs(difference).toFixed(2)} under`;
}

// The total-hours cell of a total row: "412.50 / 400.00", red when over
function budgetTotalCell(total, weekStart, label) {
  budgetTotals[label] = { total, weekStart };
  queueMicrotask(renderHoursBudgetSummary);

  const budget = budgetForWeek(weekStart);
  if (!budget) {
    return `<td class="metric">${total.toFixed(2)}</td>`;
  }

  const over = total - budget.hours > 0.005;
  const title =
    `${label} hours / hours budget ` +
    `(${budget.source === 'week' ? 'set for this week' : 'store default'}): ` +
    budgetDifferenceText(total, budget.hours);

  return `
    <td class="metric budget-total ${over ? 'budget-over' : 'budget-within'}" title="${escapeHtml(title)}">
      ${total.toFixed(2)} / ${budget.hours.toFixed(2)}
    </td>
  `;
}

/*
 * Paid OT cell. Salaried employees show "Salaried" (no paid overtime);
 * hourly employees show every hour over 40, in red when it's more than
 * `limit` (their approved OT on the schedule, the planned OT for the
 * previous week).
 */
function paidOvertimeCell(employeeNumber, workedHours, limit, limitLabel) {
  if (isSalaried(employeeNumber)) {
    return '<td class="ot-salaried">Salaried</td>';
  }
  const paid = paidOvertimeFor(employeeNumber, workedHours);
  const over = paid - Number(limit || 0) > 0.005;
  return `
    <td class="metric ${over ? 'overtime-over-limit' : ''}"
        title="${over ? escapeHtml(`${(paid - limit).toFixed(2)} hours more than ${limitLabel}`) : ''}">
      ${paid.toFixed(2)}
    </td>
  `;
}

function budgetWeekLabel(weekStart) {
  return currentMondayForPosting
    ? postingWeekLabel(weekStart)
    : `Week of ${formatYmdForPosting(weekStart, { month: 'short', day: 'numeric', year: 'numeric' })}`;
}

function renderHoursBudgetSummary() {
  const summary = document.getElementById('hoursBudgetSummary');
  if (!summary) return;

  const line = (heading, label, entry) => {
    if (!entry || !entry.weekStart) {
      return `<div><strong>${heading}:</strong> <span class="muted">no week loaded.</span></div>`;
    }

    const budget = budgetForWeek(entry.weekStart);
    const week = escapeHtml(budgetWeekLabel(entry.weekStart));

    if (!budget) {
      return `<div><strong>${heading}</strong> (${week}): ${entry.total.toFixed(2)} ${label.toLowerCase()}, <span class="muted">no budget set.</span></div>`;
    }

    const over = entry.total - budget.hours > 0.005;
    return `
      <div>
        <strong>${heading}</strong> (${week}):
        ${entry.total.toFixed(2)} ${label.toLowerCase()} / ${budget.hours.toFixed(2)} budget
        <span class="muted">(${budget.source === 'week' ? 'set for this week' : 'store default'})</span>
        — <span class="${over ? 'over' : 'within'}">${budgetDifferenceText(entry.total, budget.hours)}</span>
      </div>
    `;
  };

  summary.innerHTML =
    line('Week being scheduled', 'Scheduled', budgetTotals.Scheduled) +
    line('Previous week', 'Worked', budgetTotals.Worked);

  if (!document.getElementById('hoursBudgetControls')?.innerHTML.trim()) {
    renderHoursBudgetControls();
  }
}

function renderHoursBudgetControls() {
  const container = document.getElementById('hoursBudgetControls');
  if (!container) return;

  const budget = state.hoursBudget || { defaultHours: null, overrides: [] };
  const overrides = budget.overrides || [];
  const defaultText = typeof budget.defaultHours === 'number'
    ? `${budget.defaultHours.toFixed(2)} hours`
    : 'not set';

  const overrideRows = overrides.map(entry => `
    <tr>
      <td>${escapeHtml(budgetWeekLabel(entry.weekStart))}</td>
      <td>${entry.hours.toFixed(2)} hours</td>
      ${IS_ADMIN
        ? `<td><button type="button" class="secondary" data-budget-action="remove-week" data-week="${escapeHtml(entry.weekStart)}">Use default</button></td>`
        : ''}
    </tr>
  `).join('');

  const overrideTable = overrides.length
    ? `<table class="budget-overrides">
        <thead><tr><th>Week with its own budget</th><th>Budget</th>${IS_ADMIN ? '<th></th>' : ''}</tr></thead>
        <tbody>${overrideRows}</tbody>
      </table>`
    : '';

  if (!IS_ADMIN) {
    container.innerHTML = `
      <div><strong>Store default:</strong> ${escapeHtml(defaultText)}</div>
      ${overrideTable}
    `;
    return;
  }

  // Weeks an admin can set: the uploaded previous week, the posting weeks,
  // and any week that already has a budget
  const weeks = new Set(overrides.map(entry => entry.weekStart));
  const previousWeek = previousBudgetWeek();
  if (previousWeek) weeks.add(previousWeek);
  document.querySelectorAll('#postWeekSelect option').forEach(option => weeks.add(option.value));

  const selectedWeek =
    (budgetWeekChosen && document.getElementById('budgetWeekSelect')?.value) ||
    buildBudgetWeek() ||
    previousWeek;
  if (selectedWeek) weeks.add(selectedWeek);

  const weekOptions = [...weeks].filter(Boolean).sort().map(week => `
    <option value="${escapeHtml(week)}" ${week === selectedWeek ? 'selected' : ''}>
      ${escapeHtml(budgetWeekLabel(week))}
    </option>
  `).join('');

  const selectedOverride = overrides.find(entry => entry.weekStart === selectedWeek);

  container.innerHTML = `
    <div class="budget-controls">
      <label for="budgetDefaultInput"><strong>Store default</strong></label>
      <input type="number" id="budgetDefaultInput" min="0" step="0.25"
        value="${typeof budget.defaultHours === 'number' ? budget.defaultHours : ''}"
        placeholder="Hours per week">
      <span class="muted">hours per week</span>
      <button type="button" class="secondary" data-budget-action="save-default">Save default</button>
    </div>

    <div class="budget-controls">
      <label for="budgetWeekSelect"><strong>Budget for one week</strong></label>
      <select id="budgetWeekSelect">${weekOptions}</select>
      <input type="number" id="budgetWeekInput" min="0" step="0.25"
        value="${selectedOverride ? selectedOverride.hours : ''}"
        placeholder="${typeof budget.defaultHours === 'number' ? `Default (${budget.defaultHours})` : 'Hours'}">
      <button type="button" class="secondary" data-budget-action="save-week">Save for this week</button>
    </div>

    <div id="budgetStatus" class="budget-status" role="status"></div>
    ${overrideTable}
  `;
}

async function saveHoursBudget(payload) {
  const status = document.getElementById('budgetStatus');
  const show = (text, isError) => {
    if (!status) return;
    status.textContent = text;
    status.classList.toggle('error', Boolean(isError));
  };

  try {
    const response = await fetch('/api/hours-budget', {
      method: 'PUT',
      credentials: 'same-origin',
      headers: { 'Content-Type': 'application/json', Accept: 'application/json' },
      body: JSON.stringify({ store: state.store, ...payload })
    });
    const result = await response.json().catch(() => ({}));
    if (!response.ok || !result.success) {
      throw new Error(result.error || 'The hours budget could not be saved.');
    }

    state.hoursBudget = result.budget;
    renderHoursBudgetControls();
    renderPrintSchedule();
    renderPrevious();
    document.getElementById('budgetStatus').textContent = 'Saved.';
  } catch (err) {
    show(err.message, true);
  }
}

document.addEventListener('change', event => {
  if (event.target.id !== 'budgetWeekSelect') return;

  budgetWeekChosen = true;
  const override = (state.hoursBudget.overrides || [])
    .find(entry => entry.weekStart === event.target.value);
  document.getElementById('budgetWeekInput').value = override ? override.hours : '';
});

document.addEventListener('click', event => {
  const button = event.target.closest('[data-budget-action]');
  if (!button || !IS_ADMIN) return;

  const action = button.dataset.budgetAction;

  if (action === 'save-default') {
    saveHoursBudget({ defaultHours: document.getElementById('budgetDefaultInput').value });
  } else if (action === 'save-week') {
    saveHoursBudget({
      weekStart: document.getElementById('budgetWeekSelect').value,
      hours: document.getElementById('budgetWeekInput').value
    });
  } else if (action === 'remove-week') {
    saveHoursBudget({ weekStart: button.dataset.week, hours: '' });
  }
});

/*
 * Paid time off. The PTO section lists everyone with approved time off in
 * the week being built (plus anyone who already has PTO saved), day by
 * day. Each day off has a "Paid" box: ticked, it counts PTO_DAY_HOURS
 * (editable); unticked, the day is unpaid. The weekly total appears in the
 * printable schedule's PTO column and counts toward total hours and the
 * hours budget, but not overtime.
 */
const PTO_DAY_HOURS = 8;

let ptoData = { week: '', hours: {}, days: {}, loaded: false };

const ptoHoursFor = name => Number(ptoData.hours[name] || 0);

async function loadPtoForWeek(weekStart) {
  try {
    const response = await fetch(
      `/api/pto?store=${encodeURIComponent(state.store)}&week=${encodeURIComponent(weekStart)}`,
      { credentials: 'same-origin', headers: { Accept: 'application/json' } }
    );
    const result = await response.json();
    if (!response.ok) throw new Error(result.error || 'PTO could not be loaded.');
    ptoData = {
      week: weekStart,
      hours: Object.fromEntries((result.entries || []).map(entry => [entry.employeeName, entry.hours])),
      days: Object.fromEntries((result.entries || []).map(entry => [entry.employeeName, entry.days || {}])),
      loaded: true
    };
  } catch (err) {
    console.error('PTO could not be loaded:', err);
    ptoData = { week: weekStart, hours: {}, days: {}, loaded: false, failed: true };
  }
}

function describeTimeOffCell(entries) {
  return entries.map(entry => entry.allDay
    ? 'Off all day'
    : `${inputTimeToDisplay(entry.startTime)}–${inputTimeToDisplay(entry.endTime)}`
  ).join('<br>');
}

function renderPtoPanel() {
  const panel = document.getElementById('ptoPanel');
  if (!panel) return;

  if (!timeOffData.week) {
    panel.innerHTML = '<span class="muted">Loading time off…</span>';
    return;
  }

  // Everyone with approved time off this week, plus saved PTO
  const people = new Map();
  (timeOffData.timeOff || []).forEach(entry => {
    if (!people.has(entry.name)) people.set(entry.name, []);
    people.get(entry.name).push(entry);
  });
  Object.keys(ptoData.hours).forEach(name => {
    if (!people.has(name)) people.set(name, []);
  });

  const weekLabel = escapeHtml(postingWeekLabel(timeOffData.week));

  if (!people.size) {
    panel.innerHTML = `<p class="muted">No approved time off for ${weekLabel}.</p>`;
    return;
  }

  const rows = [...people.entries()]
    .sort((a, b) => a[0].localeCompare(b[0]))
    .map(([name, entries]) => {
      const notes = [...new Set(entries.map(entry => entry.note).filter(Boolean))];
      const savedDays = ptoData.days[name] || {};
      const cells = DAY_KEYS.map((day, index) => {
        const dayEntries = entries.filter(entry => entry.day === day);
        const paidHours = Number(savedDays[day] || 0);
        // A day off, or a day that already has paid PTO saved
        if (!dayEntries.length && !paidHours) return '<td></td>';

        return `
          <td class="${dayEntries.length ? 'pto-off' : ''}" data-pto-day="${day}">
            ${dayEntries.length ? describeTimeOffCell(dayEntries) : ''}
            <label class="pto-paid">
              <input type="checkbox" class="pto-paid-box" ${paidHours ? 'checked' : ''}
                aria-label="Paid time off for ${escapeHtml(name)} on ${escapeHtml(DAYS[index])}">
              Paid
            </label>
            <input type="number" min="0" max="24" step="0.25" class="pto-day-hours"
              aria-label="Paid hours for ${escapeHtml(name)} on ${escapeHtml(DAYS[index])}"
              value="${paidHours || PTO_DAY_HOURS}" ${paidHours ? '' : 'hidden'}>
          </td>
        `;
      }).join('');
      const hours = ptoHoursFor(name);

      return `
        <tr data-pto-name="${escapeHtml(name)}">
          <td class="pto-name">${escapeHtml(name)}</td>
          ${cells}
          <td class="pto-note">${notes.map(escapeHtml).join('<br>')}</td>
          <td>
            <strong class="pto-week-total">${hours.toFixed(2)}</strong>
            <div class="pto-status" data-pto-status></div>
          </td>
        </tr>
      `;
    }).join('');

  panel.innerHTML = `
    <p class="muted" style="margin-top:0;">Week being scheduled: <strong>${weekLabel}</strong>${
      ptoData.failed ? ' · <span class="error-text">Saved PTO hours could not be loaded.</span>' : ''}</p>
    <div class="table-wrap">
      <table class="pto-table">
        <thead>
          <tr>
            <th>Employee</th>
            ${DAYS.map(day => `<th>${escapeHtml(day)}</th>`).join('')}
            <th>Notes</th>
            <th>Paid PTO (week)</th>
          </tr>
        </thead>
        <tbody>${rows}</tbody>
      </table>
    </div>
  `;
}

/*
 * Sick days on the previous-week review. An absence (scheduled, no time
 * worked) can be marked a paid sick day, whose hours count as worked (not
 * overtime), or an unpaid sick day. Sick days get no attendance point
 * recommendation.
 */
function sickDayFor(employeeNumber, date) {
  if (!employeeNumber || !date) return null;
  return (state.sickDays || []).find(entry =>
    entry.employeeNumber === employeeNumber && entry.date === date) || null;
}

function paidSickHours(employeeNumber, date) {
  const sickDay = sickDayFor(employeeNumber, date);
  return sickDay && sickDay.type === 'paid-sick' ? Number(sickDay.hours || 0) : 0;
}

// Points already assigned (by an admin) for this absence, if any
function assignedPointForAbsence(item) {
  return ['absence', 'no_call_no_show']
    .map(type => existingAttendancePoints[buildSourceExceptionId(item, type)])
    .find(Boolean) || null;
}

function buildAbsenceControls(item) {
  const sickDay = sickDayFor(item.employeeNumber, item.infractionDate);
  const type = sickDay ? sickDay.type : '';
  // A paid sick day is a full day: 8 hours by default (no lunch deduction)
  const hours = sickDay && sickDay.type === 'paid-sick'
    ? sickDay.hours
    : PTO_DAY_HOURS;

  const sickControls = `
    <div class="sick-day-controls" data-sick-panel="${escapeHtml(item.id)}">
      <label>
        Sick day
        <select class="sick-day-type" aria-label="Sick day for ${escapeHtml(item.buildName)}">
          <option value="" ${type === '' ? 'selected' : ''}>Not a sick day</option>
          <option value="paid-sick" ${type === 'paid-sick' ? 'selected' : ''}>Paid sick day</option>
          <option value="unpaid-sick" ${type === 'unpaid-sick' ? 'selected' : ''}>Unpaid sick day</option>
        </select>
      </label>
      <label class="sick-hours-label" ${type === 'paid-sick' ? '' : 'hidden'}>
        Paid hours
        <input type="number" class="sick-day-hours" min="0" max="24" step="0.25" value="${escapeHtml(hours)}">
      </label>
      <button type="button" class="secondary save-sick-day-button"
        data-exception-id="${escapeHtml(item.id)}"
        data-employee-number="${escapeHtml(item.employeeNumber)}"
        data-employee-name="${escapeHtml(item.buildName)}"
        data-date="${escapeHtml(item.infractionDate)}">
        Save
      </button>
      <span class="sick-day-status" data-sick-status></span>
    </div>
  `;

  if (!sickDay) {
    return sickControls + buildPointAssignmentControls(item);
  }

  const alreadyAssigned = assignedPointForAbsence(item);
  return sickControls + `
    <div class="sick-no-point">
      ${sickDay.type === 'paid-sick'
        ? `Paid sick day: ${Number(sickDay.hours).toFixed(2)} hours added to hours worked.`
        : 'Unpaid sick day: no hours added.'}
      No attendance point is recommended.
      ${alreadyAssigned
        ? ' <strong>Note: points were already assigned for this absence; an admin can void them in the attendance point history.</strong>'
        : ''}
    </div>
  `;
}

document.addEventListener('change', event => {
  const select = event.target.closest('.sick-day-type');
  if (!select) return;
  const panel = select.closest('.sick-day-controls');
  panel.querySelector('.sick-hours-label').hidden = select.value !== 'paid-sick';
});

document.addEventListener('click', async event => {
  const button = event.target.closest('.save-sick-day-button');
  if (!button) return;

  const panel = button.closest('.sick-day-controls');
  const status = panel.querySelector('[data-sick-status]');
  const type = panel.querySelector('.sick-day-type').value;
  const hours = panel.querySelector('.sick-day-hours').value;

  const show = (text, isError) => {
    status.textContent = text;
    status.classList.toggle('error', Boolean(isError));
  };

  if (!button.dataset.employeeNumber) {
    show('This employee has no employee number on the schedule.', true);
    return;
  }

  button.disabled = true;
  try {
    const response = await fetch('/api/sick-days', {
      method: 'PUT',
      credentials: 'same-origin',
      headers: { 'Content-Type': 'application/json', Accept: 'application/json' },
      body: JSON.stringify({
        store: state.store,
        weekStart: previousBudgetWeek(),
        employeeNumber: button.dataset.employeeNumber,
        employeeName: button.dataset.employeeName,
        date: button.dataset.date,
        type,
        hours
      })
    });
    const result = await response.json().catch(() => ({}));
    if (!response.ok || !result.success) throw new Error(result.error || 'The sick day could not be saved.');

    state.sickDays = (state.sickDays || []).filter(entry =>
      !(entry.employeeNumber === button.dataset.employeeNumber && entry.date === button.dataset.date));
    if (result.sickDay) state.sickDays.push(result.sickDay);

    // Worked hours, totals, the budget and the point controls all change
    renderPrevious();
  } catch (err) {
    show(err.message, true);
    button.disabled = false;
  }
});

/*
 * "Ping admin: review is ready" at the bottom of the Previous Week tab.
 * Emails the reviewer (once per 15 minutes per store) and shows when it
 * was last sent for the uploaded week.
 */
function renderPreviousWeekPing(message, kind) {
  const button = document.getElementById('previousWeekPingBtn');
  const status = document.getElementById('previousWeekPingStatus');
  if (!button || !status) return;

  const week = previousBudgetWeek();
  button.disabled = !week;

  if (message) {
    status.textContent = message;
    status.className = `review-ping-status ${kind || ''}`;
    return;
  }

  const ping = state.previousWeekReviewPing;
  status.className = 'review-ping-status';
  if (!week) {
    status.textContent = 'Upload the previous week first.';
  } else if (ping && ping.weekStart === week) {
    const when = new Date(ping.sentAt).toLocaleString('en-US', { dateStyle: 'medium', timeStyle: 'short' });
    status.textContent = `Admin pinged ${when}${ping.sentBy ? ` by ${ping.sentBy}` : ''}.`;
  } else {
    status.textContent = 'The admin hasn\'t been pinged for this week yet.';
  }
}

document.getElementById('previousWeekPingBtn')?.addEventListener('click', async event => {
  const button = event.currentTarget;
  const week = previousBudgetWeek();
  const range = week
    ? `${formatYmdForPosting(week, { month: 'short', day: 'numeric' })} – ${formatYmdForPosting(addDaysToYmd(week, 6), { month: 'short', day: 'numeric', year: 'numeric' })}`
    : '';
  if (!confirm(`Email the admin that the ${state.store} previous week review${range ? ` (${range})` : ''} is ready for review?`)) return;

  button.disabled = true;
  renderPreviousWeekPing('Sending…');
  try {
    const response = await fetch('/api/previous-week-review/ping', {
      method: 'POST',
      credentials: 'same-origin',
      headers: { 'Content-Type': 'application/json', Accept: 'application/json' },
      body: JSON.stringify({ store: state.store })
    });
    const result = await response.json().catch(() => ({}));
    if (result.lastPing) state.previousWeekReviewPing = result.lastPing;
    if (!response.ok || !result.success) throw new Error(result.error || 'The email could not be sent.');

    renderPreviousWeekPing(`Sent. The admin has been told the ${state.store} review is ready.`, 'ok');
  } catch (err) {
    renderPreviousWeekPing(err.message, 'error');
  } finally {
    button.disabled = !previousBudgetWeek();
  }
});

renderPreviousWeekPing();

// Saves a person's PTO whenever a "Paid" box or a day's hours change
document.addEventListener('change', async event => {
  const input = event.target.closest('.pto-paid-box, .pto-day-hours');
  if (!input) return;

  const row = input.closest('tr');
  const name = row.dataset.ptoName;
  const status = row.querySelector('[data-pto-status]');
  const week = ptoData.week || timeOffData.week;

  // Ticking "Paid" shows the hours box, starting at 8
  if (input.classList.contains('pto-paid-box')) {
    const hoursBox = input.closest('td').querySelector('.pto-day-hours');
    hoursBox.hidden = !input.checked;
    if (input.checked && !(Number(hoursBox.value) > 0)) hoursBox.value = PTO_DAY_HOURS;
  }

  const days = {};
  row.querySelectorAll('[data-pto-day]').forEach(cell => {
    const paid = cell.querySelector('.pto-paid-box').checked;
    days[cell.dataset.ptoDay] = paid ? cell.querySelector('.pto-day-hours').value : 0;
  });

  const show = (text, isError) => {
    status.textContent = text;
    status.classList.toggle('error', Boolean(isError));
  };

  try {
    const response = await fetch('/api/pto', {
      method: 'PUT',
      credentials: 'same-origin',
      headers: { 'Content-Type': 'application/json', Accept: 'application/json' },
      body: JSON.stringify({
        store: state.store,
        weekStart: week,
        employeeName: name,
        employeeNumber: String(state.buildEmployeeIdentifiers?.[name] || ''),
        days
      })
    });
    const result = await response.json().catch(() => ({}));
    if (!response.ok || !result.success) throw new Error(result.error || 'PTO could not be saved.');

    if (result.entry.hours > 0) {
      ptoData.hours[name] = result.entry.hours;
      ptoData.days[name] = result.entry.days || {};
    } else {
      delete ptoData.hours[name];
      delete ptoData.days[name];
    }
    row.querySelector('.pto-week-total').textContent = Number(result.entry.hours || 0).toFixed(2);
    show('Saved');

    // Print totals, the budget and the snapshot all include PTO
    recalculate();
  } catch (err) {
    show(err.message, true);
  }
});

