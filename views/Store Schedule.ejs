              <input
                type="text"
                class="employee-number-input"
                data-employee-name="${escapeHtml(name)}"
                value="${escapeHtml(employeeIdentifier)}"
                placeholder="Employee #"
                autocomplete="off"
              >
            </label>

            <label class="approved-overtime-control">
  AOT

  <input
    type="number"
    class="approved-overtime-input"
    data-employee-name="${escapeHtml(name)}"
    data-employee-number="${escapeHtml(
      employeeIdentifier
    )}"
    value="${approvedOvertimeHours}"
    min="0"
    max="40"
    step="0.25"
    placeholder="0"
  >
</label>

            <label>
              <input
                type="checkbox"
                class="availability-checkbox"
                data-employee-type="${escapeHtml(type)}"
                data-employee-name="${escapeHtml(name)}"
                ${
                  state.availability[name] === true
