document.addEventListener(
  'click',
  async event => {
    const button =
      event.target.closest(
        '[data-save-overtime-id]'
      );

    if (!button) {
      return;
    }

    const exceptionId =
      button.dataset.saveOvertimeId;

    const item =
      currentAttendanceExceptions[
        exceptionId
      ];

    if (!item) {
      alert(
        'The overtime exception could not be found.'
      );

      return;
    }

    if (!item.infractionDate) {
      alert(
        'The overtime date is missing. ' +
        'Upload the previous-week review again.'
      );

      return;
    }

    if (!item.employeeNumber) {
      alert(
        'The employee number is missing.'
      );

      return;
    }

    const panel =
      button.closest(
        '.overtime-review-controls'
      );

    if (!panel) {
      return;
    }

    const explanationBox =
      panel.querySelector(
        '.overtime-explanation'
      );

    const status =
      panel.querySelector(
        '.overtime-review-status'
      );

    const explanation =
      explanationBox.value.trim();

    if (!explanation) {
      alert(
        'Enter a manager explanation before saving.'
      );

      explanationBox.focus();
      return;
    }

    if (explanation.length > 2000) {
      alert(
        'The overtime explanation cannot exceed ' +
        '2,000 characters.'
      );

      explanationBox.focus();
      return;
    }

    const originalButtonText =
      button.textContent;

    button.disabled = true;
    button.textContent =
      'Saving...';

    if (status) {
      status.textContent =
        'Saving overtime explanation...';

      status.className =
        'overtime-review-status';
    }

    try {
      const sourceExceptionId =
        buildOvertimeSourceExceptionId(
          item
        );

      const response = await fetch(
        '/api/overtime-reviews',
        {
          method: 'POST',

          credentials: 'same-origin',

          headers: {
            'Content-Type':
              'application/json',

            Accept:
              'application/json'
          },

          body: JSON.stringify({
            store:
              state.store,

            employeeNumber:
              item.employeeNumber,

            employeeName:
              item.buildName,

            workDate:
              item.infractionDate,

            dayLabel:
              item.dayLabel,

            scheduledShift:
              item.plannedValues.join(
                ', '
              ),

            actualShift:
              item.actualValues.join(
                ', '
              ),

            scheduledHours:
              item.scheduledDayHours,

            actualHours:
              item.actualDayHours,

            overtimeHours:
              item.overtimeHours,

            explanation,

            sourceExceptionId
          })
        }
      );

      const responseText =
        await response.text();

      let result = {};

      try {
        result = responseText
          ? JSON.parse(responseText)
          : {};
      } catch (parseError) {
        throw new Error(
          `Overtime review returned HTTP ` +
          `${response.status}. The server returned ` +
          `a non-JSON response.`
        );
      }

      if (!response.ok) {
        throw new Error(
          result.error ||
          'The overtime explanation could not be saved.'
        );
      }

      if (!result.review) {
        throw new Error(
          'The server reported success but did not ' +
          'return the overtime review.'
        );
      }

      existingOvertimeReviews[
        result.review.sourceExceptionId
      ] = result.review;

      attendanceExceptionComments[
        item.id
      ] = result.review.explanation;

      renderPrevious();
    } catch (err) {
      console.error(
        'Overtime explanation save error:',
        err
      );

      button.disabled = false;
      button.textContent =
        originalButtonText;

      if (status) {
        status.textContent =
          err.message;

        status.className =
          'overtime-review-status ' +
          'point-save-error';
      }
    }
  }
);


