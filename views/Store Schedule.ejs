  async function removeEmployee(
  type,
  employeeName
  ) {
  const confirmed = window.confirm(
    `Remove ${employeeName} from the ` +
    `${type} list? Existing shift assignments ` +
    `for this employee will be cleared.`
  )

  if (!confirmed) {
    return
  }

  clearEmployeeAssignments(employeeName)

  if (type === 'manager') {
  state.managers =
    state.managers.filter(
      name => name !== employeeName
    );
} else if (type === 'associate') {
  state.associates =
    state.associates.filter(
      name => name !== employeeName
    );
} else if (type === 'cashier') {
  state.cashiers =
    state.cashiers.filter(
      name => name !== employeeName
    );
}

  delete state.availability[employeeName]
  delete state.buildEmployeeIdentifiers[employeeName]
  renderAllTables()

  try {
    await saveEmployeeSettings()
  } catch (err) {
    console.error(err)

    alert(
      'The employee was removed from the page, ' +
      'but the change could not be saved.'
    )
  }
  }


  async function saveEmployeeSettings() {
  const response = await fetch(
    '/api/schedule-settings',
    {
      method: 'POST',

      headers: {
        'Content-Type': 'application/json'
      },

      credentials: 'same-origin',

      body: JSON.stringify({
        store: state.store,
        managers: state.managers,
        associates: state.associates,
        cashiers: state.cashiers,
        buildEmployeeIdentifiers: state.buildEmployeeIdentifiers,
        approvedOvertimeHours:
        state.approvedOvertimeHours,
        availability: state.availability
      })
    }
  )

  const result = await response.json()

  if (!response.ok) {
    throw new Error(
      result.error ||
      'Schedule settings could not be saved'
    )
  }

  return result
  }


  function setAssignment(el) {

  const key = el.dataset.assignment;
  const name = el.value;

  // Warn right away if this person is off or unavailable for the shift
  if (name) {
    const type = el.dataset.type;
    const shiftId = el.dataset.shiftId;
    const day = el.dataset.day;
    const row = coverageFor(type)?.[shiftId] || {};
    const shift = getEffectiveShift(type, shiftId, day, row[day] || '');
    const conflicts = timeOffConflicts(name, day, DAY_KEYS.indexOf(day), shift);

    if (conflicts.length) {
      const assignAnyway = window.confirm(
        conflicts.map(conflict => conflict.message).join('\n') +
        '\n\nAssign anyway?'
      );

      if (!assignAnyway) {
        // Put back what was there before
        el.value = state.assignments[key] || '';
        return;
