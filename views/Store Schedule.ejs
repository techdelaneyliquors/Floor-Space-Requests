      </button>
    </td>
  `;
}

        const inputValues =
          shiftToInputValues(shift);

        const selectedEmployee = getAssignment(
          type,
          shiftId,
          day
        );

        const dayIndex = DAY_KEYS.indexOf(day);

        // Assigned person has time off or is outside their availability
        const cellConflicts = timeOffConflicts(
          selectedEmployee,
          day,
          dayIndex,
