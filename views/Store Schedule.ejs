      `
      : ''
  }
</div>

            <select
                class="${
                    !selectedEmployee
                    ? 'unassigned-shift'
                    : ''
            }"
            data-assignment="${assignmentKey}"
            data-type="${escapeHtml(type)}"
            data-shift-id="${escapeHtml(shiftId)}"
            data-day="${escapeHtml(day)}"
            onchange="setAssignment(this)"
            >
              ${employeeOptions(
                type,
                selectedEmployee,
                { day, dayIndex, shift }
              )}
