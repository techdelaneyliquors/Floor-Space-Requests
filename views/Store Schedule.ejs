function normalizeEmployeeName(value) {
  let normalized = String(value || '')
    .trim()
    .toLowerCase();

  if (normalized === 'thomas') {
    normalized = 'thom';
  }

  return normalized;
}


function getMatchingUploadedName(buildName) {
  const buildIdentifier = String(
    state.buildEmployeeIdentifiers?.[
      buildName
    ] || ''
  ).trim();

  if (!buildIdentifier) {
    return '';
  }

  return Object.keys(
    state.employeeIdentifiers || {}
  ).find(uploadedName => {
    const uploadedIdentifier = String(
      state.employeeIdentifiers?.[
        uploadedName
      ] || ''
    ).trim();

    return (
      normalizeEmployeeName(uploadedName) ===
        normalizeEmployeeName(buildName) &&
      uploadedIdentifier === buildIdentifier
    );
  }) || '';
}

function minutesBetween(
  firstTime,
  secondTime
) {
  let difference =
    Math.round(
      (secondTime - firstTime) * 60
    );

  /*
   * Handle a shift that crosses midnight.
   */
  if (difference < -720) {
    difference += 1440;
  }

  if (difference > 720) {
    difference -= 1440;
  }

  return difference;
}

function scheduledPaidHoursFromRanges(value) {
  const shifts =
    normalizeShiftValues(value);

  const rawHours = shifts.reduce(
    (total, shift) =>
      total + shiftHours(shift),
    0
  );

  /*
   * Match the schedule calculation rule:
   * deduct a 30-minute lunch when the employee
   * is scheduled for at least 7.5 hours that day.
   */
  if (rawHours >= 7.5) {
    return Math.max(
      0,
      rawHours - 0.5
    );
  }

  return rawHours;
}

function getExceptionDate(dayIndex) {
  if (!state.previousWeekStart) {
    return '';
  }

  const startDate =
    new Date(state.previousWeekStart);

  if (
    Number.isNaN(
      startDate.getTime()
    )
  ) {
    return '';
  }

  const infractionDate =
    new Date(startDate);

  infractionDate.setUTCDate(
    infractionDate.getUTCDate() +
    dayIndex
  );

  return infractionDate
    .toISOString()
    .slice(0, 10);
}

function createExceptionId(
  type,
  employeeNumber,
  infractionDate
) {
  return [
    state.store,
    type,
    employeeNumber,
    infractionDate
  ].join(':');
}

function getPreviousWeekExceptions() {
  const exceptions = {
