  function renderPeople(target, type, names) {
  // Stores without cashiers have no cashier list on the page
  if (!document.getElementById(target)) {
    return;
  }

  document.getElementById(target).innerHTML =
    names.map(name => {
      const employeeIdentifier =
        state.buildEmployeeIdentifiers?.[name] || '';

        const approvedOvertimeHours =
        getApprovedOvertimeHours(
        employeeIdentifier
       );

      return `
        <div class="person-row">

          <span>
            <span class="badge ${escapeHtml(type)}">
              ${escapeHtml(type)}
            </span>

            ${escapeHtml(name)}
          </span>

