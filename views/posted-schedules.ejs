<!DOCTYPE html>
<html>
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>Posted Schedules</title>
  <link rel="icon" type="image/png" href="/Images/Enjoy%20Logo%20Heron.png">
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600&display=swap" rel="stylesheet">

  <%- include('partials/schedule-review-styles') %>

  <style>
    .pickers {
      display: flex;
      flex-wrap: wrap;
      gap: 10px 16px;
      align-items: center;
      margin: 0;
    }

    .pickers label {
      font-size: 14px;
      font-weight: 600;
    }

    .pickers select {
      padding: 7px 10px;
      border: 1px solid #ccc;
      border-radius: 8px;
      font-size: 14px;
      font-family: inherit;
      margin-left: 6px;
    }

    .top-actions {
      display: flex;
      gap: 8px;
    }

    .pending-note {
      display: inline-block;
      margin-top: 6px;
      font-size: 13px;
      color: #92400e;
      background: #fef3c7;
      border-radius: 6px;
      padding: 3px 8px;
    }

    .pending-note a {
      color: inherit;
      font-weight: 600;
    }

    .paychex-card h2 { margin: 0 0 6px; font-size: 18px; }
    .paychex-card ol { margin: 6px 0 10px; padding-left: 20px; font-size: 14px; }
    .paychex-card li { margin: 3px 0; }
    .paychex-actions { display: flex; flex-wrap: wrap; gap: 8px; align-items: center; }
    .sync-key-box {
      margin-top: 10px; padding: 10px; border-radius: 8px; background: #fef3c7;
      font-size: 13px; word-break: break-all;
    }
    .sync-key-box code { font-size: 14px; }
    .paychex-status { margin-top: 8px; font-size: 13px; }
    .paychex-status.sent { color: #166534; }
    .paychex-status.unsent { color: #64748b; }
    .paychex-status ul { margin: 4px 0 0; padding-left: 18px; color: #991b1b; }
    .paychex-reset { display: flex; flex-wrap: wrap; gap: 8px; align-items: center; margin-top: 8px; }
    .paychex-reset select { padding: 6px 8px; border: 1px solid #ccc; border-radius: 8px; font-family: inherit; }
    .paychex-reset .btn { padding: 6px 12px; font-size: 13px; }

    @media print {
      body { background: white; padding: 0; }
      .top-bar, .pickers, .no-print { display: none !important; }
      .card { box-shadow: none; padding: 0; }
      .review-table { font-size: 7.5pt; }
      @page { size: landscape; margin: 0.3in; }
    }
  </style>
</head>

<body>
<div class="container">

  <div class="top-bar">
    <h1>Posted Schedules</h1>
    <div class="top-actions">
      <a href="/schedule-approvals" class="btn btn-back">Schedule Approvals</a>
      <a href="/paychex-ids" class="btn btn-back">Paychex IDs</a>
      <a href="/" class="btn btn-back">⬅ Home</a>
    </div>
  </div>

  <div class="card no-print">
    <form class="pickers" method="GET">
      <label>
        Store
        <select name="store" onchange="this.form.week.value = ''; this.form.submit()">
          <% stores.forEach(name => { %>
            <option value="<%= name %>" <%= name === store ? 'selected' : '' %>><%= name %></option>
          <% }) %>
        </select>
      </label>

      <% if (weeks.length) { %>
        <label>
          Week
          <select name="week" onchange="this.form.submit()">
            <% weeks.forEach(week => { %>
              <option value="<%= week.weekStart %>" <%= selected && week.weekStart === selected.weekStart ? 'selected' : '' %>>
                <%= week.label === 'Current week' || week.label === 'Next week'
                  ? `${week.label} (${week.range})`
                  : `Week of ${week.range}` %><%= week.hasPending ? ' — new version waiting' : '' %>
              </option>
            <% }) %>
          </select>
        </label>
      <% } else { %>
        <input type="hidden" name="week" value="">
      <% } %>

      <noscript><button type="submit" class="btn btn-back">Show</button></noscript>
    </form>
  </div>

  <% if (!selected) { %>
    <div class="card empty">No schedules have been approved for <%= store %> yet.</div>
  <% } else { %>
    <div class="card">
      <div class="card-head">
        <div>
          <h2><%= store %>: <%= selected.range %></h2>
          <div class="meta">
            <%= selected.label %>
            · approved by <%= selected.approvedBy || 'an admin' %>
            on <%= new Date(selected.approvedAt).toLocaleString('en-US', { timeZone: 'America/New_York', dateStyle: 'medium', timeStyle: 'short' }) %>
            · submitted by <%= selected.submittedBy || 'unknown' %>
            <% if (selected.item.snapshot.templateName) { %>
              · from template "<%= selected.item.snapshot.templateName %>"
            <% } %>
          </div>
          <% if (selected.hasPending) { %>
            <span class="pending-note no-print">
              A newer version of this week is waiting for approval.
              <a href="/schedule-approvals">Review it</a>
            </span>
          <% } %>
          <% const sync = selected.paychexSync; %>
          <div class="paychex-status no-print <%= sync ? 'sent' : 'unsent' %>" id="paychexWeekStatus">
            <% if (sync) { %>
              Sent to Paychex by <%= sync.sentBy || 'an admin' %>
              on <%= new Date(sync.sentAt).toLocaleString('en-US', { timeZone: 'America/New_York', dateStyle: 'medium', timeStyle: 'short' }) %>:
              <%= sync.added %> added, <%= sync.alreadySent %> already sent<%= sync.missingIds ? `, ${sync.missingIds} missing Paychex IDs` : '' %><%= sync.failed ? `, ${sync.failed} failed` : '' %>.
              <% if (sync.failures.length) { %>
                <ul>
                  <% sync.failures.slice(0, 10).forEach(failure => { %>
                    <li><%= failure.employeeName %> (<%= failure.date %>): <%= failure.reason %></li>
                  <% }) %>
                </ul>
              <% } %>
            <% } else { %>
              Not sent to Paychex yet.
            <% } %>
          </div>
          <% if (selected.sentToPaychex.length) { %>
            <% const sentTotal = selected.sentToPaychex.reduce((sum, entry) => sum + entry.count, 0) %>
            <div class="paychex-reset no-print">
              <span class="meta">
                <%= sentTotal %> shift<%= sentTotal === 1 ? '' : 's' %> from this week are marked as sent, so the Paychex script skips them.
              </span>
              <select id="paychexResetWho" aria-label="Whose shifts to reset">
                <option value="">Everyone (<%= sentTotal %>)</option>
                <% selected.sentToPaychex.forEach(entry => { %>
                  <option value="<%= entry.employeeNumber %>"><%= entry.employeeName %> (<%= entry.count %>)</option>
                <% }) %>
              </select>
              <button type="button" class="btn btn-reject" id="paychexResetBtn"
                      data-store="<%= store %>" data-week="<%= selected.weekStart %>" data-range="<%= selected.range %>">
                Reset Paychex send status
              </button>
            </div>
          <% } %>
        </div>

        <button type="button" class="btn btn-back no-print" onclick="window.print()">Print</button>
      </div>

      <%- include('partials/schedule-review', { item: selected.item, dayKeys }) %>
    </div>
  <% } %>

  <div class="card paychex-card no-print">
    <h2>Send approved schedules to Paychex</h2>
    <ol>
      <li>Install <a href="https://www.tampermonkey.net/" target="_blank" rel="noopener">Tampermonkey</a> in your browser (one time).</li>
      <li><a href="/paychex-sync.user.js" id="installScriptLink">Install the Delaney → Paychex script</a>. Tampermonkey opens and asks you to confirm.</li>
      <li>Create a sync key below and paste it into the script's Settings (one time per browser).</li>
      <li>In Paychex Flex, open <strong>Schedules</strong>. Click the <strong>Delaney → Paychex</strong> button, pick a week, <strong>Preview</strong>, then add the shifts.</li>
    </ol>
    <p class="meta" style="margin:0 0 10px;">
      Each person's Paychex User ID and LL1 come from the <a href="/paychex-ids">Paychex IDs</a> page.
      Shifts already sent from the app are skipped, so a week can be sent again safely. Nothing in Paychex is changed or deleted.
    </p>

    <div class="paychex-actions">
      <button type="button" class="btn btn-approve" id="createSyncKeyBtn">
        <%= paychexSyncKeyCreatedAt ? 'Replace my sync key' : 'Create my sync key' %>
      </button>
      <% if (paychexSyncKeyCreatedAt) { %>
        <button type="button" class="btn btn-reject" id="revokeSyncKeyBtn">Turn off my sync key</button>
        <span class="meta" id="syncKeyState">
          Your key was created <%= new Date(paychexSyncKeyCreatedAt).toLocaleDateString('en-US', { timeZone: 'America/New_York', dateStyle: 'medium' }) %>.
        </span>
      <% } else { %>
        <span class="meta" id="syncKeyState">You don't have a sync key yet.</span>
      <% } %>
    </div>
    <div class="sync-key-box" id="syncKeyBox" hidden></div>
  </div>

</div>

<script>
async function syncKeyRequest(method) {
  const response = await fetch('/api/paychex-sync/key', {
    method,
    credentials: 'same-origin',
    headers: { Accept: 'application/json' }
  });
  const result = await response.json().catch(() => ({}));
  if (!response.ok || !result.success) throw new Error(result.error || 'The request failed.');
  return result;
}

document.getElementById('createSyncKeyBtn').addEventListener('click', async () => {
  const replacing = document.getElementById('revokeSyncKeyBtn');
  if (replacing && !confirm('Replace your sync key? The script will stop working until you paste the new key into its Settings.')) return;

  const box = document.getElementById('syncKeyBox');
  try {
    const { key } = await syncKeyRequest('POST');
    box.replaceChildren();
    const intro = document.createElement('div');
    intro.innerHTML = '<strong>Your sync key</strong> (shown only now; copy it into the script\'s Settings):';
    const code = document.createElement('code');
    code.id = 'newSyncKey';
    code.textContent = key;
    const copy = document.createElement('button');
    copy.type = 'button';
    copy.className = 'btn btn-back';
    copy.style.marginLeft = '8px';
    copy.textContent = 'Copy';
    copy.addEventListener('click', () => {
      navigator.clipboard.writeText(key).then(() => { copy.textContent = 'Copied'; }).catch(() => {});
    });
    const warning = document.createElement('div');
    warning.textContent = 'Treat it like a password: anyone with it can read approved schedules.';
    box.append(intro, code, copy, warning);
    box.hidden = false;
    document.getElementById('syncKeyState').textContent = 'New key created just now.';
  } catch (err) {
    alert(err.message);
  }
});

document.getElementById('paychexResetBtn')?.addEventListener('click', async event => {
  const button = event.currentTarget;
  const who = document.getElementById('paychexResetWho');
  const option = who.options[who.selectedIndex];
  const target = who.value ? option.textContent.replace(/\s*\(\d+\)\s*$/, '').trim() : 'everyone';

  const question =
    `Reset the Paychex send status for ${target}, week of ${button.dataset.range}?\n\n` +
    'The next preview in Paychex will offer these shifts again. Nothing in Paychex is removed: ' +
    'if the shifts are still in the scheduler, sending them again will create duplicates.';
  if (!confirm(question)) return;

  try {
    const response = await fetch('/api/paychex-sync/sent', {
      method: 'DELETE',
      credentials: 'same-origin',
      headers: { 'Content-Type': 'application/json', Accept: 'application/json' },
      body: JSON.stringify({
        store: button.dataset.store,
        weekStart: button.dataset.week,
        employeeNumber: who.value
      })
    });
    const result = await response.json().catch(() => ({}));
    if (!response.ok || !result.success) throw new Error(result.error || 'The reset failed.');
    location.reload();
  } catch (err) {
    alert(err.message);
  }
});

document.getElementById('revokeSyncKeyBtn')?.addEventListener('click', async () => {
  if (!confirm('Turn off your sync key? The Paychex script will stop working until you create a new one.')) return;
  try {
    await syncKeyRequest('DELETE');
    location.reload();
  } catch (err) {
    alert(err.message);
  }
});
</script>
</body>
</html>
