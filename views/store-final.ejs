<!DOCTYPE html>
<html>
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>Final <%= storeName %> Store Map</title>
  <link rel="icon" type="image/png" href="/Images/Enjoy%20Logo%20Heron.png">
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600&display=swap" rel="stylesheet">
  <%- include('partials/floor-styles') %>
  <style>
    .reservations { width: 100%; border-collapse: collapse; font-size: 14px; }
    .reservations th, .reservations td { text-align: left; padding: 8px 10px; border-bottom: 1px solid var(--line); vertical-align: top; }
    .reservations th { background: #f3f4f6; font-weight: 600; }
    .reservations td.products { word-break: break-word; }
    .reservations tr { cursor: pointer; }
    .reservations tr:hover td { background: #f8fafc; }
    .print-only { display: none; }

    /* Phones: each reservation as a small card */
    @media (max-width: 640px) {
      .reservations thead { display: none; }
      .reservations, .reservations tbody, .reservations tr, .reservations td { display: block; width: 100%; }
      .reservations tr { border: 1px solid var(--line); border-radius: 10px; padding: 8px 10px; margin-bottom: 8px; }
      .reservations td { border: none; padding: 2px 0; }
      .reservations td::before { content: attr(data-label) ": "; font-weight: 600; color: var(--muted); }
    }

    @media print {
      .print-only { display: block; }
      .reservations tr { cursor: default; }
    }
  </style>
</head>

<body>
<div class="container">

  <div class="top-bar">
    <div>
      <h1>Final <%= storeName %> Store Map</h1>
      <div class="who" id="monthHeading"></div>
    </div>
    <div class="top-actions no-print">
      <button type="button" class="btn btn-plain" id="printBtn">🖨 Print reservations</button>
      <a href="<%= mapPath %>" class="btn btn-purple">⬅ Interactive map</a>
      <a href="/" class="btn btn-back">Home</a>
      <form action="/logout" method="POST">
        <button type="submit" class="btn btn-logout">Log out</button>
      </form>
    </div>
  </div>

  <div class="banner" id="loadError" hidden></div>

  <div class="card no-print">
    <div class="toolbar">
      <div class="month-nav">
        <button type="button" class="btn btn-plain" id="prevMonth" aria-label="Previous month">‹</button>
        <input type="month" id="monthPicker" value="<%= month %>" aria-label="Month">
        <button type="button" class="btn btn-plain" id="nextMonth" aria-label="Next month">›</button>
      </div>
      <div class="legend">
        <span><i class="dot available"></i> Available <strong id="countAvailable"></strong></span>
        <span><i class="dot requested"></i> Requested <strong id="countRequested"></strong></span>
        <span><i class="dot reserved"></i> Reserved <strong id="countReserved"></strong></span>
      </div>
    </div>
  </div>

  <div class="floor-layout">
    <div class="card map-card">
      <div class="map-frame" id="mapFrame">
        <%- include('maps/' + mapSvg) %>
      </div>
    </div>

    <aside class="card panel" id="panel" aria-live="polite">
      <div class="panel-head">
        <h2 id="panelTitle">Reservation details</h2>
        <button type="button" class="panel-close" id="panelClose" aria-label="Close">×</button>
      </div>
      <div id="panelBody">
        <p class="panel-empty">Tap a space to see who has it.</p>
      </div>
    </aside>
  </div>

  <div class="card" style="margin-top:16px;">
    <h2 id="listTitle">Confirmed reservations</h2>
    <div id="confirmedList"></div>
  </div>
</div>

<%- include('partials/floor-map-script') %>

<script>
const MAP_ID = <%- safeJson(mapId) %>;
const STORE_NAME = <%- safeJson(storeName) %>;
const MAP_PATH = <%- safeJson(mapPath) %>;
const COLORS = { available: '#22c55e', requested: '#facc15', reserved: '#ef4444' };
const statusText = { available: 'Available', requested: 'Requested', reserved: 'Reserved' };
const { spaceLabel, spaceNumber } = FloorMap;

const state = {
  month: <%- safeJson(month) %>,
  rows: <%- safeJson(requests) %>,
  selected: null
};

function h(tag, attrs, ...children) {
  const el = document.createElement(tag);
  for (const [key, value] of Object.entries(attrs || {})) {
    if (value === undefined || value === null || value === false) continue;
    if (key === 'class') el.className = value;
    else if (key.startsWith('on')) el.addEventListener(key.slice(2), value);
    else el.setAttribute(key, value === true ? '' : value);
  }
  for (const child of children.flat()) {
    if (child === null || child === undefined || child === false) continue;
    el.append(child instanceof Node ? child : document.createTextNode(String(child)));
  }
  return el;
}

const reservedFor = id => state.rows.find(row => row.item_id === id && row.status === 'reserved');
const pendingFor = id => state.rows.filter(row => row.item_id === id && row.status === 'requested');
const statusOf = id => reservedFor(id) ? 'reserved' : pendingFor(id).length ? 'requested' : 'available';

const map = FloorMap.init(document.getElementById('mapFrame'), {
  onSelect: id => openSpace(id),
  tooltip: id => {
    const reserved = reservedFor(id);
    const pending = pendingFor(id).length;
    return `${spaceLabel(id)} · ${reserved ? `Reserved · ${reserved.brand}` : pending ? `${pending} pending request${pending === 1 ? '' : 's'}` : 'Available'}`;
  }
});

function render() {
  const counts = { available: 0, requested: 0, reserved: 0 };
  map.spaces.forEach(el => {
    const status = statusOf(el.id);
    counts[status]++;
    map.colorSpace(el.id, COLORS[status]);
  });
  document.getElementById('countAvailable').textContent = counts.available;
  document.getElementById('countRequested').textContent = counts.requested;
  document.getElementById('countReserved').textContent = counts.reserved;
  document.getElementById('monthHeading').textContent = floorMonth.label(state.month);
  renderList();
  if (state.selected) renderPanel();
}

function renderList() {
  const reserved = state.rows
    .filter(row => row.status === 'reserved')
    .sort((a, b) => spaceNumber(a.item_id) - spaceNumber(b.item_id));
  document.getElementById('listTitle').textContent = `Confirmed reservations: ${floorMonth.label(state.month)} (${reserved.length})`;
  const box = document.getElementById('confirmedList');
  if (!reserved.length) {
    box.replaceChildren(h('p', { class: 'meta', style: 'margin:0;' }, 'No confirmed reservations yet.'));
    return;
  }
  box.replaceChildren(h('table', { class: 'reservations' },
    h('thead', {}, h('tr', {}, h('th', {}, 'Space'), h('th', {}, 'Requested by'), h('th', {}, 'Brand'), h('th', {}, 'Products'))),
    h('tbody', {}, reserved.map(row => h('tr', { onclick: () => { map.showSpace(row.item_id); openSpace(row.item_id); } },
      h('td', { 'data-label': 'Space' }, spaceLabel(row.item_id)),
      h('td', { 'data-label': 'Requested by' }, row.user || ''),
      h('td', { 'data-label': 'Brand' }, row.brand || ''),
      h('td', { 'data-label': 'Products', class: 'products' }, row.products || '')
    )))
  ));
}

// ---------- panel ----------
const panel = document.getElementById('panel');

function openSpace(id) {
  state.selected = id;
  map.select(id);
  renderPanel();
  panel.classList.add('open');
}

function closePanel() {
  state.selected = null;
  map.select(null);
  panel.classList.remove('open');
  document.getElementById('panelTitle').textContent = 'Reservation details';
  document.getElementById('panelBody').replaceChildren(h('p', { class: 'panel-empty' }, 'Tap a space to see who has it.'));
}
document.getElementById('panelClose').addEventListener('click', closePanel);
document.addEventListener('keydown', event => { if (event.key === 'Escape' && state.selected) closePanel(); });

function details(row) {
  return h('div', { class: 'request' },
    h('div', { class: 'who' }, row.user || ''),
    h('div', { class: 'what' }, h('strong', {}, row.brand || ''), row.products ? ` · ${row.products}` : ''));
}

function renderPanel() {
  const id = state.selected;
  const status = statusOf(id);
  document.getElementById('panelTitle').textContent = spaceLabel(id);
  const reserved = reservedFor(id);
  const pending = pendingFor(id);
  document.getElementById('panelBody').replaceChildren(
    h('div', {}, h('span', { class: `chip ${status}` }, statusText[status]), ` ${floorMonth.label(state.month)}`),
    reserved ? h('div', { class: 'panel-section' }, h('h3', {}, 'Reserved by'), details(reserved)) : null,
    pending.length ? h('div', { class: 'panel-section' },
      h('h3', {}, `Pending requests (${pending.length})`),
      pending.map(details),
      h('a', { href: MAP_PATH, class: 'btn btn-plain btn-small' }, 'Review on the interactive map')) : null,
    !reserved && !pending.length ? h('div', { class: 'panel-section' }, h('div', { class: 'note' }, 'Nobody has this space this month.')) : null
  );
}

// ---------- month ----------
async function setMonth(month) {
  if (!/^\d{4}-\d{2}$/.test(month)) return;
  document.getElementById('monthPicker').value = month;
  const banner = document.getElementById('loadError');
  try {
    state.rows = await floorApi(`/api/final-data?month=${encodeURIComponent(month)}&map=${encodeURIComponent(MAP_ID)}`);
    state.month = month;
    banner.hidden = true;
    history.replaceState(null, '', `?month=${encodeURIComponent(month)}`);
  } catch (err) {
    banner.textContent = `Couldn't load ${floorMonth.label(month)}: ${err.message}`;
    banner.hidden = false;
  }
  render();
}
document.getElementById('monthPicker').addEventListener('change', event => setMonth(event.target.value));
document.getElementById('prevMonth').addEventListener('click', () => setMonth(floorMonth.shift(state.month, -1)));
document.getElementById('nextMonth').addEventListener('click', () => setMonth(floorMonth.shift(state.month, 1)));

// ---------- print: the reservations as a plain table ----------
document.getElementById('printBtn').addEventListener('click', () => {
  const reserved = state.rows.filter(row => row.status === 'reserved')
    .sort((a, b) => spaceNumber(a.item_id) - spaceNumber(b.item_id));
  if (!reserved.length) {
    floorToast('No confirmed reservations to print.', true);
    return;
  }
  const win = window.open('', '_blank', 'width=1000,height=800');
  if (!win) {
    floorToast('Allow pop-ups for this site to print.', true);
    return;
  }
  const doc = win.document;
  doc.title = 'Confirmed Reservations';
  const style = doc.createElement('style');
  style.textContent = '@page{margin:0.4in}body{font-family:Arial,sans-serif;margin:0}h1{font-size:18px;margin:0 0 6px}' +
    '.meta{font-size:12px;margin-bottom:10px}table{width:100%;border-collapse:collapse;table-layout:fixed;font-size:12px}' +
    'th,td{border:1px solid #000;padding:4px 6px;text-align:left;vertical-align:top;word-wrap:break-word}' +
    'th:nth-child(1){width:12%}th:nth-child(2){width:20%}th:nth-child(3){width:20%}';
  doc.head.appendChild(style);
  const make = (tag, text) => { const el = doc.createElement(tag); if (text !== undefined) el.textContent = text; return el; };
  const table = make('table');
  const headRow = make('tr');
  ['Space', 'Requested by', 'Brand', 'Products'].forEach(text => headRow.appendChild(make('th', text)));
  table.appendChild(make('thead')).appendChild(headRow);
  const tbody = table.appendChild(make('tbody'));
  reserved.forEach(row => {
    const tr = tbody.appendChild(make('tr'));
    [spaceLabel(row.item_id), row.user || '', row.brand || '', row.products || ''].forEach(text => tr.appendChild(make('td', text)));
  });
  doc.body.append(make('h1', `${STORE_NAME}: Confirmed Reservations`), make('div', floorMonth.label(state.month)), table);
  doc.body.children[1].className = 'meta';
  win.focus();
  setTimeout(() => win.print(), 300);
});

render();
</script>
</body>
</html>
