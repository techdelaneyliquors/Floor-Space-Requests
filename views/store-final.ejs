  box-shadow: 0 6px 16px rgba(0, 0, 0, 0.25);
}


.btn-print {
  background-color: #444;
  color: white;
  border: 2px solid black;
}

.btn-print:hover {
  background-color: #2f2f2f;
  tra
}
</style>
<a href="<%= mapPath %>" class="btn btn-home">
    ⬅ Back to Interactive Map
</a>


<form action="/logout" method="POST" style="display:inline;">
  <button type="submit" class="btn btn-logout">
    <span class="icon">➜</span> LOGOUT
  </button>
</form>


<hr>

<div id="reservationDetails" style="margin: 20px auto; max-width: 500px; border:1px solid #ccc; padding:15px; border-radius:10px; background:#f9f9f9;">
  <h3>Reservation Details</h3>
  <p id="detailsPlaceholder">Click a reserved space to view its reservation info.</p>

  <div id="detailsContent" style="display:none;">
    <p><strong>Spot:</strong> <span id="detailSpot"></span></p>
    <p><strong>User:</strong> <span id="detailUser"></span></p>
    <p><strong>Brand:</strong> <span id="detailBrand"></span></p>
    <p><strong>Products:</strong> <span id="detailProducts"></span></p>
  </div>
</div>

<div id="svgContainer" style="background-color: lightgrey;">
  <%- include('maps/' + mapSvg) %>
</div>


<h2>Confirmed Reservations</h2>
<div id="confirmedList"></div>

<h3 id="currentMonthLabel"><%= month %></h3>


<script>

// This store's map (server-provided)
const MAP_ID = <%- safeJson(mapId) %>;
let selectedBox = null;

let currentRequests = <%- safeJson(requests) %>;

// Vendor-entered text must be escaped before it goes into innerHTML
// or document.write, or it could inject markup and scripts.
function escapeHtml(value) {
  return String(value ?? "")
    .replace(/&/g, "&amp;")
    .replace(/</g, "&lt;")
    .replace(/>/g, "&gt;")
    .replace(/"/g, "&quot;")
    .replace(/'/g, "&#39;");
}

const monthInput = document.getElementById("monthPicker");
const monthLabel = document.getElementById("currentMonthLabel");

const STATUS_COLOR = {
  available: "#00cc66",
  requested: "#ffcc00",
  reserved: "#ff3333"
};

// initial render
renderAll();

// month changes update data WITHOUT page reload
monthInput.addEventListener("change", async () => {
  const newMonth = monthInput.value;
  if (!newMonth) return;

  try {
    const response = await fetch(`/api/final-data?month=${encodeURIComponent(newMonth)}&map=${encodeURIComponent(MAP_ID)}`);
    const data = await response.json();

    currentRequests = data;
    monthLabel.textContent = newMonth;

    clearDetails();
    renderAll();
  } catch (err) {
    console.error("Month load failed:", err);
  }
});

function renderAll() {
  renderMap();
  renderList();
}


function renderMap() {
  const boxes = document.querySelectorAll('path[id^="FloorSpace"]');

  // reset all boxes
  boxes.forEach(el => {
    el.style.fill = "#00cc66";
    el.style.cursor = "default";
    el.onclick = null;
    el.classList.remove("selected-box"); // ✅ remove highlight
  });

  // apply DB state
  currentRequests.forEach(row => {
    const el = document.getElementById(row.item_id);
    if (!el) return;

    el.style.fill = STATUS_COLOR[row.status] || "#00cc66";

    // ✅ ONLY reserved clickable
    if (row.status === "reserved") {

      el.style.cursor = "pointer";

      el.onclick = () => {

        // ✅ remove previous highlight
        if (selectedBox) {
          selectedBox.classList.remove("selected-box");
        }

        // ✅ set new highlight
        el.classList.add("selected-box");
        selectedBox = el;

        // ✅ show data
        showDetails(row);
      };
    }
  });
}


function renderList() {
  const container = document.getElementById("confirmedList");
  const reserved = currentRequests.filter(r => r.status === "reserved");

  if (reserved.length === 0) {
    container.innerHTML = "<p>No confirmed reservations yet.</p>";
    return;
  }

  
  container.innerHTML = reserved.map(req => `
    <div style="
      border: 2px solid black;         /* ✅ black outline */
      background-color: white;         /* ✅ white box */
      padding: 10px;
      margin: 10px auto;               /* ✅ center cards */
      border-radius: 8px;
    ">
      <strong>Spot:</strong> ${escapeHtml(req.item_id)}<br>
      <strong>User:</strong> ${escapeHtml(req.user)}<br>
      <strong>Brand:</strong> ${escapeHtml(req.brand)}<br>
      <strong>Products:</strong> ${escapeHtml(req.products)}
    </div>
  `).join("");

}

function showDetails(row) {
  document.getElementById("detailsPlaceholder").style.display = "none";
  document.getElementById("detailsContent").style.display = "block";

  document.getElementById("detailSpot").textContent = row.item_id || "";
  document.getElementById("detailUser").textContent = row.user || "";
  document.getElementById("detailBrand").textContent = row.brand || "";
  document.getElementById("detailProducts").textContent = row.products || "";
}

function clearDetails() {
  document.getElementById("detailsPlaceholder").style.display = "block";
  document.getElementById("detailsContent").style.display = "none";

  document.getElementById("detailSpot").textContent = "";
  document.getElementById("detailUser").textContent = "";
  document.getElementById("detailBrand").textContent = "";
  document.getElementById("detailProducts").textContent = "";
}



function printReservations() {
  const reserved = currentRequests.filter(r => r.status === "reserved");

  if (reserved.length === 0) {
    alert("No confirmed reservations to print.");
    return;
  }

  const month = monthLabel ? monthLabel.textContent : (monthInput ? monthInput.value : "");
  const rows = reserved.map(req => `
    <tr>
      <td>${escapeHtml(req.item_id)}</td>
      <td>${escapeHtml(req.user)}</td>
      <td>${escapeHtml(req.brand)}</td>
      <td>${escapeHtml(req.products)}</td>
    </tr>
  `).join("");

  const printWindow = window.open("", "_blank", "width=1000,height=800");

  printWindow.document.write(`
    <!DOCTYPE html>
    <html>
    <head>
      <title>Confirmed Reservations</title>
      <style>
        @page {
          size: auto;
          margin: 0.4in;
        }

        body {
          font-family: Arial, sans-serif;
          color: black;
          background: white;
          margin: 0;
          padding: 0;
        }

        h1 {
          font-size: 18px;
          margin: 0 0 6px 0;
        }

        .meta {
          font-size: 12px;
          margin-bottom: 10px;
        }

        table {
          width: 100%;
          border-collapse: collapse;
          table-layout: fixed;
          font-size: 12px;
        }

        th, td {
          border: 1px solid black;
          padding: 4px 6px;
          text-align: left;
          vertical-align: top;
          word-wrap: break-word;
        }

        th {
          background: white;
          font-weight: bold;
        }

        .col-spot { width: 16%; }
        .col-user { width: 20%; }
        .col-brand { width: 20%; }
        .col-products { width: 44%; }

        @media print {
          body {
            -webkit-print-color-adjust: exact;
            print-color-adjust: exact;
          }
        }
      </style>
    </head>
    <body>
      <h1>Confirmed Reservations</h1>
      <div class="meta">Map: ${escapeHtml(MAP_ID)} ${month ? `| Month: ${escapeHtml(month)}` : ""}</div>

      <table>
        <thead>
          <tr>
            <th class="col-spot">Spot</th>
            <th class="col-user">User</th>
            <th class="col-brand">Brand</th>
            <th class="col-products">Products</th>
          </tr>
        </thead>
        <tbody>
          ${rows}
        </tbody>
      </table>
    </body>
    </html>
  `);

  printWindow.document.close();
  printWindow.focus();

  setTimeout(() => {
    printWindow.print();
  }, 300);
}
</script>




</body>