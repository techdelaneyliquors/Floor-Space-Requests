function renderExceptionSection(
  title,
  headingClass,
  items
) {
  if (!items.length) {
    return '';
  }

  return `
    <div class="exception-section">
      <div
        class="exception-section-heading ${
          escapeHtml(headingClass)
        }"
      >
        ${escapeHtml(title)}
        (${items.length})
      </div>

      ${items.map(item => `
        <div class="exception-row">

          <div class="exception-description">
            <strong>
              ${escapeHtml(item.summary)}
            </strong>

            ${buildExceptionTimesHtml(item)}
          </div>

          ${
            item.type === 'overtime'
              ? buildOvertimeReviewControls(item)
              : buildPointAssignmentControls(item)
          }

        </div>
      `).join('')}

    </div>
  `;
}

function renderAttendanceExceptionReview(
  exceptions
) {
  const container =
    document.getElementById(
      'attendanceExceptionReview'
    );

  if (!container) {
    return;
  }

  const totalExceptions =
    exceptions.late.length +
    exceptions.early.length +
    exceptions.both.length +
    exceptions.absence.length +
    exceptions.overtime.length;

  if (totalExceptions === 0) {
    container.innerHTML = `
      <div class="exception-section">
        <div class="exception-section-heading">
          Attendance and Labor Exceptions
        </div>

        <div class="no-exceptions">
          No attendance or overtime exceptions
          were detected for the previous week.
        </div>
      </div>
    `;

    return;
  }

  container.innerHTML = `
    ${renderExceptionSection(
      'Late Arrivals',
      '',
      exceptions.late
    )}

    ${renderExceptionSection(
      'Early Departures',
      '',
      exceptions.early
    )}

    ${renderExceptionSection(
      'Late Arrival and Early Departure',
      'both-heading',
      exceptions.both
    )}

    ${renderExceptionSection(
      'Absences / No Time Worked',
      'absence-heading',
      exceptions.absence
    )}

    ${renderExceptionSection(
      'Daily Overtime of 30 Minutes or More',
      'overtime-heading',
      exceptions.overtime
    )}
  `;
}
