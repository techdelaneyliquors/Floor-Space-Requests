<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Branford Weekly Schedule</title>
  <style>
    :root {
      --navy:#17365d; --blue:#2f5597; --light:#eaf1fb; --line:#cbd5e1;
      --text:#172033; --muted:#64748b; --green:#15803d; --amber:#b45309;
      --red:#b91c1c; --white:#fff; --shadow:0 12px 32px rgba(15,23,42,.08);
    }
    * { box-sizing:border-box; }
    body { margin:0; font-family:Inter,Segoe UI,Arial,sans-serif; background:#f5f7fb; color:var(--text); }
    .page-shell { max-width:1500px; margin:0 auto; padding:24px; }
    .topbar { display:flex; justify-content:space-between; gap:16px; align-items:center; margin-bottom:18px; }
    .topbar h1 { margin:0; font-size:28px; color:var(--navy); }
    .topbar p { margin:5px 0 0; color:var(--muted); }
    .actions { display:flex; gap:10px; flex-wrap:wrap; }
    button { border:0; border-radius:8px; padding:10px 14px; font-weight:700; cursor:pointer; }
    .primary { background:var(--navy); color:#fff; }
    .secondary { background:#fff; color:var(--navy); border:1px solid var(--line); }
    .module-tabs { display:flex; gap:8px; overflow:auto; padding-bottom:10px; position:sticky; top:0; z-index:20; background:#f5f7fb; }
    .module-tabs button { white-space:nowrap; background:#dbe7f7; color:var(--navy); }
    .module-tabs button.active { background:var(--navy); color:#fff; }
    .module { display:none; }
    .module.active { display:block; }
    .module-card { background:#fff; border:1px solid #e2e8f0; border-radius:14px; box-shadow:var(--shadow); margin:14px 0 24px; overflow:hidden; }
    .module-heading { padding:18px 22px; background:linear-gradient(135deg,var(--navy),var(--blue)); color:#fff; }
    .module-heading h2 { margin:0; font-size:21px; }
    .module-heading p { margin:5px 0 0; opacity:.85; }
    .section { padding:22px; border-top:1px solid #e7edf5; }
    .section:first-of-type { border-top:0; }
    .section-title { display:flex; justify-content:space-between; align-items:end; gap:14px; margin-bottom:12px; }
    .section-title h3 { margin:0; color:var(--navy); font-size:17px; }
    .section-title small { color:var(--muted); }
    .table-wrap { overflow:auto; border:1px solid var(--line); border-radius:10px; }
    table { width:100%; border-collapse:collapse; min-width:980px; background:#fff; }
    th, td { border-bottom:1px solid var(--line); border-right:1px solid #e8edf4; padding:9px; text-align:center; vertical-align:middle; }
    th { background:#e9f0fa; color:var(--navy); font-size:12px; text-transform:uppercase; letter-spacing:.03em; }
    td:first-child, th:first-child { text-align:left; font-weight:700; position:sticky; left:0; background:inherit; z-index:2; }
    tr:last-child td { border-bottom:0; }
    select, input { width:100%; min-width:105px; border:1px solid #cbd5e1; border-radius:6px; padding:7px 8px; background:#fff; color:var(--text); }
    input[type="checkbox"] { min-width:auto; width:18px; height:18px; }
    .shift-label { display:block; font-size:12px; font-weight:700; color:#334155; margin-bottom:5px; }
    .stack { display:grid; gap:7px; }
    .availability-grid { display:grid; grid-template-columns:repeat(2,minmax(0,1fr)); gap:14px; }
    .people-box { border:1px solid var(--line); border-radius:10px; padding:14px; background:#fafcff; }
    .people-box h4 { margin:0 0 10px; color:var(--navy); }
    .person-row { display:flex; justify-content:space-between; align-items:center; gap:12px; padding:7px 0; border-bottom:1px dashed #dbe3ee; }
    .person-row:last-child { border:0; }
    .badge { display:inline-block; padding:4px 8px; border-radius:999px; font-size:11px; font-weight:800; }
    .manager { background:#dbeafe; color:#1d4ed8; }
    .associate { background:#dcfce7; color:#15803d; }
    .metric { font-weight:800; }
    .negative { color:var(--red); }
    .positive { color:var(--green); }
    .attendance-grid { display:grid; grid-template-columns:repeat(3,1fr); gap:8px; }
    .attendance-grid input { min-width:55px; }
    .print-sheet { padding:16px; background:#fff; }
    .print-sheet h2 { text-align:center; margin:0 0 4px; }
    .print-sheet .period { text-align:center; color:var(--muted); margin-bottom:16px; }
    .no-print-note { background:#fff7ed; border:1px solid #fed7aa; color:#9a3412; padding:10px 12px; border-radius:8px; margin-bottom:12px; }
    .actual-cell { white-space:pre-line; line-height:1.45; }
    @media(max-width:850px){ .availability-grid{grid-template-columns:1fr;} .topbar{align-items:flex-start;flex-direction:column;} }
    @media print {

       * {-webkit-print-color-adjust: exact !important;
            print-color-adjust: exact !important;
        }

        /* Previous Week print table */
#previousWeekComparisonTable {
