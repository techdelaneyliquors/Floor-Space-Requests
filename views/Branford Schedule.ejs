  async function initializeSchedulePage() {
  /*
   * Render the page immediately so the normal schedule
   * is not delayed while point records are downloaded.
   */
  renderAllTables();

  try {
    await Promise.all([
      loadTemplateList(),
      loadAttendancePointSummary(),
      loadExistingAttendancePoints(),
      loadExistingPointRecommendations(),
      loadExistingOvertimeReviews()
    ]);

    const defaultTemplate =
      state.templates.find(
        template =>
          template.isDefault === true
      );

    if (defaultTemplate) {
      const selector =
        document.getElementById(
          'templateSelector'
        );

      if (selector) {
        selector.value =
          defaultTemplate._id;
      }

      await loadSelectedTemplate();
    }
  } catch (err) {
    console.error(
      'Schedule initialization error:',
      err
    );
  }
}

initializeSchedulePage();
