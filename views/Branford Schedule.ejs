function generateScheduleComments() {
  const comments = [];

  const coverageGroups = [
    {
      type: 'manager',
      coverage: managerCoverage
    },
    {
      type: 'associate',
      coverage: associateCoverage
    },
    {
      type: 'cashier',
      coverage: cashierCoverage
    }
  ];

  coverageGroups.forEach(group => {
    Object.entries(
      group.coverage
    ).forEach(([shiftId, row]) => {
      DAY_KEYS.forEach(day => {
        const key =
          scheduleCellKey(
            group.type,
            shiftId,
            day
          );

        if (
          !Object.prototype.hasOwnProperty.call(
            temporaryShifts,
            key
          )
        ) {
          return;
        }

        const originalShift =
          row[day] || '';

        const newShift =
          temporaryShifts[key];

        const note =
          temporaryShiftNotes[key] ||
          'No explanation provided';

        const shiftLabel =
          row.label || shiftId;

        const dayLabel =
          DAYS[
            DAY_KEYS.indexOf(day)
          ] || day;

        /*
         * Existing preset shift changed to blank:
         * the manager removed the shift.
         */
        if (
          originalShift &&
          !newShift
        ) {
          comments.push({
            type:
              'Removed Shift',

            day:
              dayLabel,

            shift:
              shiftLabel,

            details:
              `${originalShift} removed`,

            reason:
              note
          });

          return;
        }

        /*
         * There was no preset shift, but a new shift
         * was added.
         */
        if (
          !originalShift &&
          newShift
        ) {
          comments.push({
            type:
              'Added Shift',

            day:
              dayLabel,

            shift:
              shiftLabel,

            details:
              newShift,

            reason:
              note
          });

          return;
        }

        /*
         * An existing shift time was changed.
         */
        if (
          originalShift &&
          newShift &&
          originalShift !== newShift
        ) {
          comments.push({
            type:
              'Adjusted Shift',

            day:
              dayLabel,

            shift:
              shiftLabel,

            details:
              `${originalShift} to ${newShift}`,

            reason:
              note
          });
        }
      });
    });
  });

  return comments;
}
