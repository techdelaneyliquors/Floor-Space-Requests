function formatPointHistoryDate(value) {
  if (!value) {
    return 'Date not recorded';
  }

  const parsedDate =
    new Date(value);

  if (
    Number.isNaN(
      parsedDate.getTime()
    )
  ) {
    return 'Date not recorded';
  }

  return parsedDate.toLocaleDateString(
    'en-US',
    {
      timeZone: 'UTC',
      month: 'numeric',
      day: 'numeric',
      year: 'numeric'
    }
  );
}

function formatInfractionType(value) {
  const infractionLabels = {
    tardy:
      'Tardy',

    left_early:
      'Left Early',

    late_and_left_early:
      'Late and Left Early',

    absence:
      'Absence',

    no_call_no_show:
      'No Call / No Show'
  };

  const cleanValue =
    String(value || '').trim();

  return (
    infractionLabels[cleanValue] ||
    cleanValue ||
    'Not recorded'
  );
}

function renderAttendancePointHistory() {
  const container =
    document.getElementById(
      'attendancePointHistory'
    );

  if (!container) {
    return;
  }

  const employeesWithPoints =
    attendancePointSummary.filter(employee =>
      Number(
        employee.totalPoints || 0
      ) > 0
    );

  if (!employeesWithPoints.length) {
    container.innerHTML = `
      <div class="no-exceptions">
        No current Build Schedule employees have
        attendance points within the last 365 days.
      </div>
    `;

    return;
  }

  container.innerHTML =
    employeesWithPoints
      .map((employee, employeeIndex) => {
        const pointBearingInfractions =
          Array.isArray(
            employee.infractions
          )
            ? employee.infractions.filter(
                record =>
                  Number(
                    record.points || 0
                  ) > 0
              )
            : [];

        if (!pointBearingInfractions.length) {
          return '';
        }

        const safeEmployeeNumber =
          String(
            employee.employeeNumber || ''
          ).replace(
            /[^a-zA-Z0-9_-]/g,
            ''
          );

        const detailsId =
          `point-history-${employeeIndex}-` +
          `${safeEmployeeNumber}`;

        const totalPoints =
          Number(
            employee.totalPoints || 0
          );

        return `
          <div class="point-history-employee">
            <button
              type="button"
              class="point-history-toggle"
              data-point-history-target="${escapeHtml(
                detailsId
              )}"
              aria-expanded="false"
              aria-controls="${escapeHtml(
                detailsId
              )}"
            >
              <span class="point-history-person">
                <span
                  class="point-history-arrow"
                  aria-hidden="true"
                >
                  &#9654;
                </span>

                <span>
                  ${escapeHtml(
                    employee.employeeName
                  )}

                  <span class="point-history-number">
                    Employee #${escapeHtml(
                      employee.employeeNumber
                    )}
                  </span>
                </span>
              </span>

              <span class="point-history-total">
                ${totalPoints}
                point${totalPoints === 1 ? '' : 's'}
              </span>
            </button>

            <div
              id="${escapeHtml(detailsId)}"
              class="point-history-details"
              hidden
            >
              <div
                class="
                  table-wrap
                  point-history-table-wrap
                "
              >
                <table class="point-history-table">
                  <thead>
                    <tr>
                      <th>Date</th>
                      <th>Infraction</th>
                      <th>Points</th>
                      <th>Assigned By</th>
                      <th>Explanation</th>
                    </tr>
                  </thead>

                  <tbody>
                    ${pointBearingInfractions
                      .map(record => {
                        const dateText =
                          formatPointHistoryDate(
                            record.infractionDate
                          );

                        const infractionText =
                          formatInfractionType(
                            record.infractionType
                          );

                        const assignedBy =
                          String(
                            record.assignedByName ||
                            ''
                          ).trim() ||
                          'Not recorded';

                        const managerComment =
                          String(
                            record.managerComment ||
                            ''
                          ).trim() ||
                          'No explanation recorded';

                        const pointValue =
                          Number(
                            record.points || 0
                          );

                        return `
                          <tr>
                            <td>
                              ${escapeHtml(
                                dateText
                              )}
                            </td>

                            <td>
                              ${escapeHtml(
                                infractionText
                              )}
                            </td>

                            <td class="point-history-points">
                              ${pointValue}
                            </td>

                            <td>
                              ${escapeHtml(
                                assignedBy
                              )}
                            </td>

                            <td class="point-history-comment">
                              ${escapeHtml(
                                managerComment
                              )}
                            </td>
                          </tr>
                        `;
                      })
                      .join('')}
                  </tbody>
                </table>
              </div>
            </div>
          </div>
        `;
      })
      .join('');
}

