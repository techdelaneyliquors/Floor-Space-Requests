  function employeeKey(type, name){
  return `${type}:${name}`;
}

  function initializeAvailability() {

  const allEmployees = [
    ...state.managers,
    ...state.associates,
    ...state.cashiers
  ];

  for (const employee of allEmployees) {

    if (
      typeof state.availability[employee] !== 'boolean'
    ) {

      state.availability[employee] = true;

    }

  }

  }

  initializeAvailability();

  function available(type) {
  let list = [];

  if (type === 'manager') {
    /*
     * Manager shifts can only be filled
     * by managers.
     */
    list = [
      ...state.managers
    ];
  } else if (type === 'associate') {
    /*
     * Associate shifts can be filled by
     * associates or managers.
     */
    list = [
      ...state.associates,
      ...state.managers,
      ...state.cashiers
    ];
  } else if (type === 'cashier') {
    /*
     * Cashier shifts can be filled by
     * cashiers, associates, or managers.
     */
    list = [
      ...state.cashiers,
      ...state.associates,
      ...state.managers
    ];
  }

  return [
    ...new Set(list)
  ].filter(
    name =>
      state.availability[name] === true
  );
}

  function getEmployeeRole(name) {
  if (state.managers.includes(name)) {
    return 'Manager';
  }

  if (state.associates.includes(name)) {
    return 'Associate';
  }

  if (state.cashiers.includes(name)) {
    return 'Cashier';
  }

  return '';
}

function employeeOptions(
  type,
  selected = ''
) {
  const options = available(type)
    .map(name => {
      const isSelected =
        name === selected
          ? ' selected'
          : '';

      const role =
        getEmployeeRole(name);

      const displayText =
        role
          ? `${name} (${role})`
          : name;

      return `
        <option
          value="${escapeHtml(name)}"
          ${isSelected}
        >
          ${escapeHtml(displayText)}
        </option>
      `;
    })
    .join('');

  return `
    <option value="">
      Unassigned
    </option>

    ${options}
  `;
}

  function scheduleCellKey(type, shiftId, day) {
  return `${type}:${shiftId}:${day}`;
}

function legacyAssignmentKey(shiftId, day) {
  return `${shiftId}:${day}`;
}

function getAssignment(type, shiftId, day) {
  const newKey = scheduleCellKey(type, shiftId, day);

  if (Object.prototype.hasOwnProperty.call(
    state.assignments,
    newKey
  )) {
    return state.assignments[newKey] || '';
  }

  return state.assignments[
    legacyAssignmentKey(shiftId, day)
  ] || '';
}

function getEffectiveShift(
  type,
  shiftId,
  day,
  presetShift
) {
  const key = scheduleCellKey(
    type,
    shiftId,
    day
  );

  if (
    Object.prototype.hasOwnProperty.call(
      temporaryShifts,
      key
    )
  ) {
    return temporaryShifts[key];
  }

  return presetShift || '';
}

function isTemporaryShift(
  type,
  shiftId,
  day
) {
  const key = scheduleCellKey(
    type,
    shiftId,
    day
  );

  return Object.prototype.hasOwnProperty.call(
    temporaryShifts,
    key
  );
}

function timeTextToInputValue(timeText) {
  const parsed = parseTime(timeText);

  if (parsed == null) {
    return '';
  }

  const hours = Math.floor(parsed) % 24;
  const minutes = Math.round(
    (parsed - Math.floor(parsed)) * 60
  );

  return (
    String(hours).padStart(2, '0') +
    ':' +
    String(minutes).padStart(2, '0')
  );
}

function shiftToInputValues(shiftText) {
  if (
    !shiftText ||
    !shiftText.includes(' to ')
  ) {
    return {
      start: '',
      end: ''
    };
  }

  const parts = shiftText.split(' to ');

  return {
    start: timeTextToInputValue(parts[0]),
    end: timeTextToInputValue(parts[1])
  };
}

function inputTimeToDisplay(inputValue) {
  if (!inputValue) {
    return '';
  }

  const parts = inputValue.split(':');

  let hours = Number(parts[0]);
  const minutes = Number(parts[1]);

  const suffix = hours >= 12
    ? 'PM'
    : 'AM';

  hours = hours % 12;

  if (hours === 0) {
    hours = 12;
  }

  return (
    hours +
    ':' +
    String(minutes).padStart(2, '0') +
    ' ' +
    suffix
  );
}

function saveTemporaryShift(
  type,
  shiftId,
  day
) {
  const key = scheduleCellKey(
    type,
    shiftId,
    day
  );

  const startInput = document.querySelector(
    `[data-shift-start="${key}"]`
  );

  const endInput = document.querySelector(
    `[data-shift-end="${key}"]`
  );

  if (!startInput || !endInput) {
    return;
  }

  if (!startInput.value || !endInput.value) {
    alert(
      'Enter both a start time and an end time.'
    );
    return;
  }

  const startText = inputTimeToDisplay(
    startInput.value
  );

  const endText = inputTimeToDisplay(
    endInput.value
  );

  const newShift =
    `${startText} to ${endText}`;

  let reason = '';

  if (!buildingNewTemplate) {
    const existingNote =
      temporaryShiftNotes[key] || '';

    const enteredReason = window.prompt(
      'Reason for this schedule change:',
      existingNote
    );

    if (enteredReason === null) {
      renderAllTables();
      return;
    }

    reason = enteredReason.trim();
  }

  /*
   * Only save the shift after the user has
   * completed or accepted the reason prompt.
   */
  temporaryShifts[key] = newShift;
  temporaryShiftNotes[key] = reason;

  renderAllTables();
}

function clearTemporaryShift(
  type,
  shiftId,
  day,
  hasPreset
) {
  const key =
    scheduleCellKey(
      type,
      shiftId,
      day
    );

  /*
   * Restore the employee who was assigned before
   * the shift was removed.
   */
  if (
    hasPreset &&
    Object.prototype.hasOwnProperty.call(
      deletedShiftAssignments,
      key
    )
  ) {
    state.assignments[key] =
      deletedShiftAssignments[key] || '';
  }

  delete temporaryShifts[key];
  delete temporaryShiftNotes[key];
  delete deletedShiftAssignments[key];

  /*
   * If this was an added shift rather than a preset
   * shift, removing it should clear its assignment.
   */
  if (!hasPreset) {
    state.assignments[key] = '';
  }

  renderAllTables();
}

function deleteScheduledShift(
  type,
  shiftId,
  day,
  presetShift
) {
  const key =
    scheduleCellKey(
      type,
      shiftId,
      day
    );

  const currentShift =
    getEffectiveShift(
      type,
      shiftId,
      day,
      presetShift
    );

  if (!currentShift) {
    return;
  }

  const confirmed =
    window.confirm(
      `Delete the ${currentShift} shift ` +
      `for ${DAYS[DAY_KEYS.indexOf(day)]}?`
    );

  if (!confirmed) {
    return;
  }

  const existingReason =
    temporaryShiftNotes[key] || '';

  const enteredReason =
    window.prompt(
      'Why is this shift being removed? ' +
      'This explanation will appear on the ' +
      'printable schedule.',
      existingReason
    );

  if (enteredReason === null) {
    return;
  }

  const reason =
    enteredReason.trim();

  if (!reason) {
    alert(
      'Enter an explanation before removing the shift.'
    );

    return;
  }

  /*
   * Save the current assignment so Reset can restore it.
   */
  deletedShiftAssignments[key] =
    getAssignment(
      type,
      shiftId,
      day
    );

  /*
   * An empty temporary shift means that the preset
   * shift has been temporarily removed.
   */
  temporaryShifts[key] = '';

  temporaryShiftNotes[key] =
    reason;

  /*
   * Clear the employee assignment because the shift
   * no longer exists in the current schedule.
   */
  state.assignments[key] = '';

  /*
   * Also clear a possible legacy assignment key.
   */
  const oldAssignmentKey =
    legacyAssignmentKey(
      shiftId,
      day
    );

  if (
    Object.prototype.hasOwnProperty.call(
      state.assignments,
      oldAssignmentKey
    )
  ) {
    state.assignments[
      oldAssignmentKey
    ] = '';
  }

  renderAllTables();
}

