);
}

function shiftHoursFromRanges(value) {

  const shifts =
    normalizeShiftValues(value);

  let total = 0;

  shifts.forEach(shift => {
    total += shiftHours(shift);
  });

  return total;

}

function defaultPointsForException(type) {
  const defaults = {
    late: 1,
    tardy: 1,

    early: 1,
    left_early: 1,

    both: 2,
    late_and_left_early: 2,

    absence: 0,
    no_call_no_show: 5
  };

  return defaults[type] ?? 0;
}

function getPointOptions(type) {
  if (
    type === 'late' ||
    type === 'tardy'
  ) {
    return [0, 1];
  }

  if (
    type === 'early' ||
    type === 'left_early'
  ) {
    return [0, 1];
  }

  if (
    type === 'both' ||
    type === 'late_and_left_early'
  ) {
    return [0, 1, 2];
  }

  if (type === 'absence') {
    return [0, 1, 2, 3, 4, 5];
  }

  if (type === 'no_call_no_show') {
    return [0, 5];
  }

  return [0];
}


function apiInfractionType(type) {
  const values = {
    late: 'tardy',
    early: 'left_early',
    both: 'late_and_left_early',
    absence: 'absence',
    no_call_no_show:
      'no_call_no_show'
  };

  return values[type] || type;
}

function buildOvertimeSourceExceptionId(
  item
) {
  return [
    state.store,
    'overtime',
    item.employeeNumber,
    item.infractionDate
  ].join(':');
}

function buildSourceExceptionId(
  item,
  selectedInfractionType = ''
) {
  const infractionType =
    selectedInfractionType ||
    apiInfractionType(item.type);

  return [
    state.store,
    infractionType,
    item.employeeNumber,
    item.infractionDate
  ].join(':');
}

async function loadExistingOvertimeReviews() {
  const parameters =
    new URLSearchParams({
      store: state.store,
      includeAll: 'true'
    });

  const response = await fetch(
    `/api/overtime-reviews?${parameters.toString()}`,
    {
      method: 'GET',

      credentials: 'same-origin',

      headers: {
        Accept: 'application/json'
      }
    }
  );

  const responseText =
    await response.text();

  let result = {};

  try {
    result = responseText
      ? JSON.parse(responseText)
      : {};
  } catch (parseError) {
    throw new Error(
      `Overtime reviews returned HTTP ` +
      `${response.status}. The server returned ` +
      `a non-JSON response.`
    );
  }

  if (!response.ok) {
    throw new Error(
      result.error ||
      'Overtime reviews could not be loaded.'
    );
  }

  const reviews =
    Array.isArray(result.reviews)
      ? result.reviews
      : [];

  existingOvertimeReviews =
    Object.fromEntries(
      reviews
        .filter(review =>
          review &&
          review.sourceExceptionId &&
          review.voided !== true
        )
        .map(review => [
          review.sourceExceptionId,
          review
        ])
    );

  overtimeReviewsLoaded = true;

  renderPrevious();
}

