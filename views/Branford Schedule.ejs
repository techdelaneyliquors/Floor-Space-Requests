function buildPointAssignmentControls(item) {
  const defaultInfractionType =
    apiInfractionType(item.type);

  const possibleSourceExceptionIds = [
    buildSourceExceptionId(
      item,
      defaultInfractionType
    )
  ];

  /*
   * Absences may be classified as either a normal
   * absence or a no-call/no-show.
   */
  if (item.type === 'absence') {
    possibleSourceExceptionIds.push(
      buildSourceExceptionId(
        item,
        'absence'
      )
    );

    possibleSourceExceptionIds.push(
      buildSourceExceptionId(
        item,
        'no_call_no_show'
      )
    );
  }

  const sourceExceptionIds = [
    ...new Set(
      possibleSourceExceptionIds.filter(Boolean)
    )
  ];

  const savedPointRecord =
    sourceExceptionIds
      .map(sourceExceptionId =>
        existingAttendancePoints[
          sourceExceptionId
        ]
      )
      .find(Boolean) ||
    null;

  const savedRecommendation =
    sourceExceptionIds
      .map(sourceExceptionId =>
        existingPointRecommendations[
          sourceExceptionId
        ]
      )
      .find(Boolean) ||
    null;

  const pointsAssigned =
    Boolean(savedPointRecord);

  const recommendationSaved =
    Boolean(savedRecommendation);

  const savedInfractionType =
    savedPointRecord?.infractionType ||
    savedRecommendation?.infractionType ||
    defaultInfractionType;

  const selectedPointValue =
    pointsAssigned
      ? Number(
          savedPointRecord.points || 0
        )
      : recommendationSaved
        ? Number(
            savedRecommendation.recommendedPoints || 0
          )
        : defaultPointsForException(
            savedInfractionType
          );

  const optionValues = [
    ...new Set([
      ...getPointOptions(
        savedInfractionType
      ),
      selectedPointValue
    ])
  ].sort((first, second) =>
    first - second
  );

  const options =
    optionValues
      .map(value => `
        <option
          value="${value}"
          ${
            value === selectedPointValue
              ? 'selected'
              : ''
          }
        >
          ${value} point${value === 1 ? '' : 's'}
        </option>
      `)
      .join('');

  const savedComment =
    savedPointRecord?.managerComment ||
    savedRecommendation?.managerComment ||
    attendanceExceptionComments[
      item.id
    ] ||
    '';

  const pointsWereAssigned =
    pointsAssigned &&
    Number(savedPointRecord.points) > 0;

  let recommendationButtonText =
    'Save Recommendation';

  let recommendationButtonClass = '';

  if (
    recommendationSaved &&
    !pointsAssigned
  ) {
    recommendationButtonText =
      'Update Recommendation';

    recommendationButtonClass =
      'recommendation-saved';
  }

  if (pointsAssigned) {
    recommendationButtonText =
      'Recommendation Complete';

    recommendationButtonClass =
      'recommendation-saved';
  }

  let assignmentButtonText =
    recommendationSaved
      ? 'Assign Recommended Points'
      : 'Save Recommendation First';

  let assignmentButtonClass = '';

  if (pointsAssigned) {
    if (pointsWereAssigned) {
      assignmentButtonText =
        'Points Assigned';

      assignmentButtonClass =
        'points-assigned';
    } else {
      assignmentButtonText =
        'Points Not Assigned';

      assignmentButtonClass =
        'points-not-assigned';
    }
  }

  const controlDisabledAttribute =
    pointsAssigned
      ? 'disabled'
      : '';

  const recommendationButtonDisabled =
    pointsAssigned
      ? 'disabled'
      : '';

  const assignmentButtonDisabled =
    pointsAssigned ||
    !recommendationSaved
      ? 'disabled'
      : '';

  let recommendationStatus = '';

  if (recommendationSaved) {
    const recommendationDateValue =
      savedRecommendation.updatedAt ||
      savedRecommendation.createdAt;

    const recommendationDate =
      recommendationDateValue
        ? new Date(
            recommendationDateValue
          ).toLocaleString()
        : 'an earlier date';

    const recommendedPoints =
      Number(
        savedRecommendation.recommendedPoints || 0
      );

    recommendationStatus =
      `${recommendedPoints} point${
        recommendedPoints === 1
          ? ''
          : 's'
      } recommended on ` +
      `${recommendationDate}.`;

    const recommendedBy =
      String(
        savedRecommendation.recommendedByName ||
        ''
      ).trim();

    if (recommendedBy) {
      recommendationStatus +=
        ` Recommended by ${recommendedBy}.`;
    }
  }

  let assignedStatus = '';

  if (pointsAssigned) {
    const assignedDate =
      savedPointRecord.createdAt
        ? new Date(
            savedPointRecord.createdAt
          ).toLocaleString()
        : 'an earlier date';

    if (pointsWereAssigned) {
      const assignedPoints =
        Number(
          savedPointRecord.points
        );

      assignedStatus =
        `${assignedPoints} point${
          assignedPoints === 1
            ? ''
            : 's'
        } assigned on ${assignedDate}.`;
    } else {
      assignedStatus =
        `No points were assigned. ` +
        `The final decision was recorded ` +
        `on ${assignedDate}.`;
    }

    const assignedBy =
      String(
        savedPointRecord.assignedByName ||
        ''
      ).trim();

    if (assignedBy) {
      assignedStatus +=
        ` Assigned by ${assignedBy}.`;
    }
  }

  const assignmentStatusClass =
    pointsAssigned
      ? pointsWereAssigned
        ? 'point-save-success'
        : 'point-not-assigned-status'
      : '';

  const absenceClassification =
    item.type === 'absence'
      ? `
        <label>
          Absence classification

          <select
            class="exception-infraction-type"
            data-exception-id="${escapeHtml(item.id)}"
            ${controlDisabledAttribute}
          >
            <option
              value="absence"
              ${
                savedInfractionType ===
                'absence'
                  ? 'selected'
                  : ''
              }
            >
              Absence with notice
            </option>

            <option
              value="no_call_no_show"
              ${
                savedInfractionType ===
                'no_call_no_show'
                  ? 'selected'
                  : ''
              }
            >
              No call / no show
            </option>
          </select>
        </label>
      `
      : '';

  return `
    <div
      class="point-assignment-controls ${
        item.type === 'absence'
          ? 'absence-point-controls'
          : ''
      }"
      data-point-panel="${escapeHtml(item.id)}"
      data-point-completed="${
        pointsAssigned
          ? 'true'
          : 'false'
      }"
      data-recommendation-id="${escapeHtml(
        savedRecommendation?._id || ''
      )}"
    >
      ${absenceClassification}

      <label>
        Recommended Points

        <select
          class="exception-points"
          data-exception-id="${escapeHtml(item.id)}"
          ${controlDisabledAttribute}
        >
          ${options}
        </select>
      </label>

      <label class="point-comment-label">
        Manager recommendation explanation

        <textarea
          class="exception-comment"
          data-exception-id="${escapeHtml(item.id)}"
          placeholder="Explain the attendance infraction and recommended points..."
          ${controlDisabledAttribute}
        >${escapeHtml(savedComment)}</textarea>
      </label>

      <div class="point-action-buttons">
        <button
          type="button"
          class="
            recommend-points-button
            ${recommendationButtonClass}
          "
          data-recommend-points-id="${escapeHtml(item.id)}"
          ${recommendationButtonDisabled}
        >
          ${recommendationButtonText}
        </button>

        <button
          type="button"
          class="
            primary
            assign-points-button
            ${assignmentButtonClass}
          "
          data-assign-recommended-points-id="${
            escapeHtml(item.id)
          }"
          ${assignmentButtonDisabled}
        >
          ${assignmentButtonText}
        </button>
      </div>

      <div
        class="recommendation-status"
        data-recommendation-status="${escapeHtml(item.id)}"
      >
        ${escapeHtml(recommendationStatus)}
      </div>

      <div
        class="
          point-assignment-status
          ${assignmentStatusClass}
        "
        data-point-status="${escapeHtml(item.id)}"
      >
        ${escapeHtml(assignedStatus)}
      </div>
    </div>
  `;
}

function normalizeShiftValues(value) {
  if (Array.isArray(value)) {
    return value
      .map(item => String(item).trim())
      .filter(Boolean);
  }

  if (
    value !== undefined &&
    value !== null &&
    String(value).trim()
  ) {
    return [String(value).trim()];
  }

  return [];
}

