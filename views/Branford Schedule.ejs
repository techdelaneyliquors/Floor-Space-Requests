async function saveCurrentAsTemplate() {
  const enteredName = window.prompt(
    'Template name:'
  );

  const templateName =
    enteredName?.trim();

  if (!templateName) {
    return;
  }

  const makeDefault = window.confirm(
    'Make this the default template ' +
    `for ${state.store}?`
  );

  const templateData =
    captureCurrentTemplate();

  const response = await fetch(
    '/api/schedule-templates',
    {
      method: 'POST',

      headers: {
        'Content-Type': 'application/json',
        'Accept': 'application/json'
      },

      credentials: 'same-origin',

      body: JSON.stringify({
        store: state.store,
        templateName,
        isDefault: makeDefault,
        templateData
      })
    }
  );

  const responseText =
    await response.text();

  let result = {};

  try {
    result = responseText
      ? JSON.parse(responseText)
      : {};
  } catch (parseError) {
    console.error(
      'Non-JSON template save response:',
      {
        status: response.status,
        statusText: response.statusText,
        url: response.url,
        responseText
      }
    );

    throw new Error(
      `Template save returned HTTP ${response.status}. ` +
      `The server returned HTML instead of JSON. ` +
      `Server response: ${responseText.slice(0, 500)}`
    );
  }

  if (!response.ok) {
    throw new Error(
      result.error ||
      `The template could not be saved. ` +
      `HTTP ${response.status}`
    );
  }

  if (!result.template) {
    throw new Error(
      'The server reported success but did not ' +
      'return the saved template.'
    );
  }

  state.currentTemplateName =
    result.template.templateName ||
    templateName;

  buildingNewTemplate = false;

  const savedTemplateData =
    result.template.templateData ||
    templateData;

  replaceObjectContents(
    managerCoverage,
    savedTemplateData.managerCoverage ||
    templateData.managerCoverage ||
    {}
  );

  replaceObjectContents(
    associateCoverage,
    savedTemplateData.associateCoverage ||
    templateData.associateCoverage ||
    {}
  );

  replaceObjectContents(
    cashierCoverage,
    savedTemplateData.cashierCoverage ||
    templateData.cashierCoverage ||
    {}
  );

  replaceObjectContents(
    state.assignments,
    savedTemplateData.assignments ||
    templateData.assignments ||
    {}
  );

  /*
   * Shifts saved in the template are now permanent,
   * so they should no longer be marked temporary.
   */
  replaceObjectContents(
  temporaryShifts,
  {}
);

replaceObjectContents(
  temporaryShiftNotes,
  {}
);

replaceObjectContents(
  deletedShiftAssignments,
  {}
);

await loadTemplateList(
  result.template._id || ''
);

  renderAllTables();

  alert(
    `"${state.currentTemplateName}" was saved ` +
    `for ${state.store}.`
  );
}


