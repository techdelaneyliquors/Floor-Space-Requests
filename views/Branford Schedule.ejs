      );

    const typeSelector =
      panel.querySelector(
        '.exception-infraction-type'
      );

    const status =
      panel.querySelector(
        '.recommendation-status'
      );

    if (
      !pointSelector ||
      !commentBox
    ) {
      return;
    }

    const recommendedPoints =
      Number(pointSelector.value);

    const managerComment =
      commentBox.value.trim();

    const infractionType =
      typeSelector
        ? typeSelector.value
        : apiInfractionType(
            item.type
          );

    if (!managerComment) {
      alert(
        'Enter a manager explanation before ' +
        'saving the recommendation.'
      );

      commentBox.focus();
      return;
    }

    const confirmed =
      window.confirm(
        `Recommend ${recommendedPoints} point(s) ` +
        `for ${item.buildName}'s ` +
        `${item.dayLabel} infraction?`
      );

    if (!confirmed) {
      return;
    }

    const originalButtonText =
      button.textContent;

    button.disabled = true;
    button.textContent =
      'Saving Recommendation...';

    if (status) {
      status.textContent =
        'Saving recommendation...';

      status.className =
        'recommendation-status';
    }

    try {
      const sourceExceptionId =
        buildSourceExceptionId(
          item,
          infractionType
        );

      const response = await fetch(
        '/api/attendance-point-recommendations',
        {
          method: 'POST',

          credentials: 'same-origin',

          headers: {
            'Content-Type':
              'application/json',

            Accept:
              'application/json'
          },

          body: JSON.stringify({
            store:
              state.store,

            employeeNumber:
              item.employeeNumber,

            employeeName:
              item.buildName,

            infractionDate:
              item.infractionDate,

            infractionType,

            recommendedPoints,

            managerComment,

            sourceExceptionId
          })
        }
      );

      const responseText =
        await response.text();

      let result = {};

      try {
        result = responseText
          ? JSON.parse(responseText)
          : {};
      } catch (parseError) {
        throw new Error(
          `Recommendation returned HTTP ` +
          `${response.status}. The server returned ` +
          `a non-JSON response.`
        );
      }

      if (!response.ok) {
        throw new Error(
          result.error ||
          'The recommendation could not be saved.'
        );
      }

      if (!result.recommendation) {
        throw new Error(
          'The server did not return the saved ' +
          'recommendation.'
        );
      }

      existingPointRecommendations[
        result.recommendation.sourceExceptionId
      ] = result.recommendation;

      attendanceExceptionComments[
        item.id
      ] = result.recommendation.managerComment;

      renderPrevious();
