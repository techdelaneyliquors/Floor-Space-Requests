function normalizeEmployeeName(value) {
  let normalized = String(value || '')
    .trim()
    .toLowerCase();

  if (normalized === 'thomas') {
    normalized = 'thom';
  }

  return normalized;
}


function getMatchingUploadedName(buildName) {
  const buildIdentifier = String(
    state.buildEmployeeIdentifiers?.[
      buildName
    ] || ''
  ).trim();

  if (!buildIdentifier) {
    return '';
  }

  return Object.keys(
    state.employeeIdentifiers || {}
  ).find(uploadedName => {
    const uploadedIdentifier = String(
      state.employeeIdentifiers?.[
        uploadedName
      ] || ''
    ).trim();

    return (
      normalizeEmployeeName(uploadedName) ===
        normalizeEmployeeName(buildName) &&
      uploadedIdentifier === buildIdentifier
    );
  }) || '';
}

function minutesBetween(
  firstTime,
  secondTime
) {
  let difference =
    Math.round(
      (secondTime - firstTime) * 60
    );

  /*
   * Handle a shift that crosses midnight.
   */
  if (difference < -720) {
    difference += 1440;
  }

  if (difference > 720) {
    difference -= 1440;
  }

  return difference;
}

function scheduledPaidHoursFromRanges(value) {
  const shifts =
    normalizeShiftValues(value);

  const rawHours = shifts.reduce(
    (total, shift) =>
      total + shiftHours(shift),
    0
  );

  /*
   * Match the schedule calculation rule:
   * deduct a 30-minute lunch when the employee
   * is scheduled for at least 7.5 hours that day.
   */
  if (rawHours >= 7.5) {
    return Math.max(
      0,
      rawHours - 0.5
    );
  }

  return rawHours;
}

function getExceptionDate(dayIndex) {
  if (!state.previousWeekStart) {
    return '';
  }

  const startDate =
    new Date(state.previousWeekStart);

  if (
    Number.isNaN(
      startDate.getTime()
    )
  ) {
    return '';
  }

  const infractionDate =
    new Date(startDate);

  infractionDate.setUTCDate(
    infractionDate.getUTCDate() +
    dayIndex
  );

  return infractionDate
    .toISOString()
    .slice(0, 10);
}

function createExceptionId(
  type,
  employeeNumber,
  infractionDate
) {
  return [
    state.store,
    type,
    employeeNumber,
    infractionDate
  ].join(':');
}

function getPreviousWeekExceptions() {
  const exceptions = {
    late: [],
    early: [],
    both: [],
    absence: [],
    overtime: []
  };

  

  const buildScheduleNames = [
    ...new Set([
      ...state.managers,
      ...state.associates,
      ...state.cashiers
    ])
  ];

  buildScheduleNames.forEach(buildName => {
    const uploadedName =
      getMatchingUploadedName(buildName);

    if (!uploadedName) {
      return;
    }

    const employeeNumber = String(
      state.buildEmployeeIdentifiers?.[
        buildName
      ] || ''
    ).trim();

    const scheduledShifts =
      state.previousScheduledShifts?.[
        uploadedName
      ] || {};

    const actualShifts =
      state.previousActualShifts?.[
        uploadedName
      ] || {};

    const actualHours =
      state.previousActualHours?.[
        uploadedName
      ] || {};

    DAY_KEYS.forEach((day, dayIndex) => {
  const infractionDate =
    getExceptionDate(dayIndex);

  const plannedValues =
    normalizeShiftValues(
      scheduledShifts[day]
    );

  const actualValues =
    normalizeShiftValues(
      actualShifts[day]
    );

      const scheduledDayHours =
  scheduledPaidHoursFromRanges(
    plannedValues
  );

const actualDayHours =
  Number(
    actualHours[day] || 0
  );



      const baseRecord = {
        buildName,
        uploadedName,
        employeeNumber,
        day,
        dayLabel: DAYS[dayIndex],
        infractionDate,
        plannedValues,
        actualValues,
        scheduledDayHours,
        actualDayHours
      };

      /*
       * A scheduled shift with no actual shift
       * is considered an absence/no-time-worked
       * exception.
       */
      if (
        plannedValues.length > 0 &&
        actualValues.length === 0
      ) {
        exceptions.absence.push({
          ...baseRecord,

          id: createExceptionId(
            'absence',
            employeeNumber,
            infractionDate
          ),

          type: 'absence',

          summary:
            `${buildName} had no time worked ` +
            `for a scheduled ${dayIndex >= 0
              ? DAYS[dayIndex]
              : day} shift.`
        });

        /*
         * Do not calculate lateness, early departure,
         * or overtime when no actual shift exists.
         */
        return;
      }

      if (
        plannedValues.length > 0 &&
        actualValues.length > 0
      ) {
        const scheduledParts =
          plannedValues[0].split(' to ');

        const actualParts =
          actualValues[0].split(' to ');

        if (
          scheduledParts.length === 2 &&
          actualParts.length === 2
        ) {
          const scheduledStart =
            parseTime(
              scheduledParts[0]
            );

          const scheduledEnd =
            parseTime(
              scheduledParts[1]
            );

          const actualStart =
            parseTime(
              actualParts[0]
            );

          const actualEnd =
            parseTime(
              actualParts[1]
            );

          if (
            scheduledStart != null &&
            scheduledEnd != null &&
            actualStart != null &&
            actualEnd != null
          ) {
            const lateMinutes =
              minutesBetween(
                scheduledStart,
                actualStart
              );

            const earlyMinutes =
              minutesBetween(
                actualEnd,
                scheduledEnd
              );

            const arrivedLate =
              lateMinutes > 15;

            const leftEarly =
              earlyMinutes > 15;

            if (
              arrivedLate &&
              leftEarly
            ) {
              exceptions.both.push({
                ...baseRecord,

                id: createExceptionId(
                  'both',
                  employeeNumber,
                  infractionDate
                ),

                type: 'both',
                lateMinutes,
                earlyMinutes,

                summary:
                  `${buildName} arrived ` +
                  `${lateMinutes} minutes late and ` +
                  `left ${earlyMinutes} minutes early ` +
                  `on ${DAYS[dayIndex]}.`
              });
            } else if (arrivedLate) {
              exceptions.late.push({
                ...baseRecord,

                id: createExceptionId(
                  'late',
                  employeeNumber,
                  infractionDate
                ),

                type: 'late',
                lateMinutes,

                summary:
                  `${buildName} arrived ` +
                  `${lateMinutes} minutes late ` +
                  `on ${DAYS[dayIndex]}.`
              });
            } else if (leftEarly) {
              exceptions.early.push({
                ...baseRecord,

                id: createExceptionId(
                  'early',
                  employeeNumber,
                  infractionDate
                ),

                type: 'early',
                earlyMinutes,

                summary:
                  `${buildName} left ` +
                  `${earlyMinutes} minutes early ` +
                  `on ${DAYS[dayIndex]}.`
              });
            }
          }
        }
      }

      /*
       * Overtime threshold:
       * actual hours are at least 0.50 hours
       * greater than scheduled paid hours.
       */
      const overtimeHours =
        actualDayHours -
        scheduledDayHours;

      if (
        scheduledDayHours > 0 &&
        actualDayHours >=
          scheduledDayHours + 0.5
      ) {
        exceptions.overtime.push({
          ...baseRecord,

          id: createExceptionId(
            'overtime',
            employeeNumber,
            infractionDate
          ),

          type: 'overtime',
          overtimeHours,

          summary:
            `${buildName} worked ` +
            `${overtimeHours.toFixed(2)} hours ` +
            `over the scheduled hours on ` +
            `${DAYS[dayIndex]}.`
        });
      }
    });
  });

  return exceptions;
}

