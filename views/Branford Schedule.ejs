function cloneTemplateData(value) {
  return JSON.parse(
    JSON.stringify(value || {})
  );
}

function captureCurrentTemplate() {
  const savedManagerCoverage =
    cloneTemplateData(managerCoverage);

  const savedAssociateCoverage =
    cloneTemplateData(associateCoverage);

    const savedCashierCoverage =
  cloneTemplateData(
    cashierCoverage
  );

  /*
   * Merge every temporary/adjusted shift into
   * the permanent coverage saved in the template.
   */
  Object.entries(temporaryShifts)
    .forEach(([key, shiftText]) => {
      const [
        type,
        shiftId,
        day
      ] = key.split(':');

      if (
        type === 'manager' &&
        savedManagerCoverage[shiftId]
      ) {
        savedManagerCoverage[
          shiftId
        ][day] = shiftText;
      }

      if (
        type === 'associate' &&
        savedAssociateCoverage[shiftId]
      ) {
        savedAssociateCoverage[
          shiftId
        ][day] = shiftText;
      }

      if (
  type === 'cashier' &&
  savedCashierCoverage[shiftId]
) {
  savedCashierCoverage[
    shiftId
  ][day] = shiftText;
}
    });

  return {
  assignments:
    cloneTemplateData(
      state.assignments
    ),

  managerCoverage:
    savedManagerCoverage,

  associateCoverage:
    savedAssociateCoverage,

  cashierCoverage:
    savedCashierCoverage,

  temporaryShifts: {},
  temporaryShiftNotes: {}
};

}
function createBlankCoverage(
  existingCoverage
) {
  const blankCoverage = {};

  Object.entries(existingCoverage)
    .forEach(([shiftId, row]) => {
      blankCoverage[shiftId] = {
        label:
          row.label ||
          shiftId,

        monday: '',
        tuesday: '',
        wednesday: '',
        thursday: '',
        friday: '',
        saturday: '',
        sunday: ''
      };
    });

  return blankCoverage;
}


function replaceObjectContents(
  target,
  source
) {
  Object.keys(target).forEach(key => {
    delete target[key];
  });

  Object.assign(
    target,
    cloneTemplateData(source)
  );
}

