<!DOCTYPE html>
<html>
<head>

<meta charset="UTF-8" />
  <title>Clickable SVG Reservations</title>

<link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600&display=swap" rel="stylesheet">




<% if (user.role === 'admin') { %>
    <button onclick="goToFinal()">📊 Final View</button>
<% } %>





  <style>
    path[id^="FloorSpace"] {
      cursor: pointer;
      transition: fill 0.2s ease;
    }

    
    path[id^="FloorSpace"]:hover {
      opacity: 0.8;     /* ✅ subtle visual feedback instead of color override */
    }


    .selected {
      fill: #00cc66 !important;
    }
    

    
body {
  text-align: center;
  font-family: 'Inter', sans-serif;
}

/* ✅ keeps SVG centered and separate */
#svgContainer {
  display: block;
  margin: 20px auto;
}

/* ✅ ensures SVG behaves like a block */
#svgContainer svg {
  display: block;
  margin: 0 auto;
}

/* ✅ legend sits UNDER SVG, not beside it */
#legend {
  display: flex;
  justify-content: center;
  gap: 10px;
  margin-top: 10px;
}

.legend-item {
    display: flex;
    align-items: center;
    gap: 8px;
  }
.color-box {
    width: 16px;
    height: 16px;
    display: inline-block;
    border: 1px solid #333;
  }


  #monthPicker {
  padding: 8px 12px;
  font-size: 15px;
  border: 1px solid #ccc;
  border-radius: 8px;
  background: #fff;
  outline: none;
  transition: all 0.2s ease;
}

#monthPicker:hover {
  border-color: #999;
}

#monthPicker:focus {
  border-color: #007bff;
  box-shadow: 0 0 4px rgba(0, 123, 255, 0.4);
}


/* ----------------------------- */
/* Modern Modal                  */
/* ----------------------------- */

#requestModal {
  background: #ffffff;
  padding: 24px;
  border-radius: 12px;
  border: none;
  box-shadow: 0 8px 24px rgba(0,0,0,0.15);
  width: 360px;
  text-align: left;
  font-family: Arial, sans-serif;
}

/* Inputs */
#requestModal input {
  width: 90%;
  padding: 10px 12px;
  margin-top: 4px;
  border: 1px solid #ccc;
  border-radius: 8px;
  font-size: 14px;
  transition: border 0.2s ease, box-shadow 0.2s ease;
}

#requestModal input:focus {
  border-color: #007bff;
  box-shadow: 0 0 4px rgba(0, 123, 255, 0.4);
  outline: none;
}

/* Buttons */
#requestModal button {
  padding: 10px 16px;
  border-radius: 8px;
  border: none;
  cursor: pointer;
  font-size: 14px;
  margin-right: 8px;
  transition: background 0.2s ease;
}

#submitRequest {
  background: #007bff;
  color: white;
}

#submitRequest:hover {
  background: #0066d6;
}

#cancelRequest {
  background: #e5e5e5;
}

#cancelRequest:hover {
  background: #d5d5d5;
}
  </style>
</head>

<body>

  
<div id="topControls">
  
  
  <label>User: <%= user.name %></label>


  <br><br>

  <label for="monthPicker">Select Month:</label>
  <input type="month" id="monthPicker">
  <h3 id="currentMonthDisplay"></h3>
  </div>

  
<div style="display:flex; justify-content: space-between; align-items: center; padding: 10px 20px;">
  
  <!-- ✅ Back to home -->
  <a href="/">
    <button>⬅ Back to Home</button>
  </a>

  <!-- ✅ Logout -->
  
  <form action="/logout" method="POST">
    <button type="submit">Log Out</button>
  </form>


</div>

